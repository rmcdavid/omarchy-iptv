{
  "schemaVersion": 1,
  "id": "io.github.rmcdavid.iptv",
  "name": "IPTV",
  "version": "0.7.4",
  "author": "David McDavid",
  "license": "MIT",
  "description": "Live TV channel guide for Omarchy: type to find a channel, Enter plays it in mpv.",
  "kinds": [
    "bar-widget",
    "overlay",
    "service"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "overlay": "Guide.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "IPTV",
    "description": "TV glyph plus the channel now playing. Left click opens the guide, right click stops, scroll zaps, middle click refreshes.",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "playlistUrl": "",
      "epgUrl": "",
      "refreshMinutes": 360,
      "mpvArgs": "",
      "showChannelName": true,
      "maxRecents": 10,
      "barLabelMaxWidth": 180,
      "channelOrder": "playlist",
      "numberEntryMs": 2000,
      "barShowChannelNumber": true,
      "pipCorner": "top-right",
      "pipSizePercent": 30,
      "pipMargin": 16
    },
    "schema": [
      {
        "key": "playlistUrl",
        "type": "string",
        "label": "Playlist URL or absolute path (M3U/M3U8)"
      },
      {
        "key": "epgUrl",
        "type": "string",
        "label": "EPG URL (XMLTV, plain or .gz, optional)"
      },
      {
        "key": "refreshMinutes",
        "type": "integer",
        "label": "Refresh playlist and EPG every (minutes)",
        "min": 15,
        "max": 1440,
        "step": 15,
        "defaultValue": 360
      },
      {
        "key": "mpvArgs",
        "type": "string",
        "label": "Extra mpv options (space separated, --key=value)"
      },
      {
        "key": "showChannelName",
        "type": "boolean",
        "label": "Show channel name in the bar",
        "defaultValue": true
      },
      {
        "key": "maxRecents",
        "type": "integer",
        "label": "Recent channels to keep",
        "min": 1,
        "max": 50,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "barLabelMaxWidth",
        "type": "integer",
        "label": "Max width of the channel name in the bar (px)",
        "min": 60,
        "max": 600,
        "step": 10,
        "defaultValue": 180
      },
      {
        "key": "channelOrder",
        "type": "string",
        "label": "Channel list order: playlist or number"
      },
      {
        "key": "numberEntryMs",
        "type": "integer",
        "label": "Channel number entry timeout (ms)",
        "min": 400,
        "max": 5000,
        "step": 100,
        "defaultValue": 2000
      },
      {
        "key": "barShowChannelNumber",
        "type": "boolean",
        "label": "Show the channel number in the bar",
        "defaultValue": true
      },
      {
        "key": "pipCorner",
        "type": "string",
        "label": "Picture-in-picture corner: top-right, top-left, bottom-right, bottom-left"
      },
      {
        "key": "pipSizePercent",
        "type": "integer",
        "label": "Picture-in-picture width (percent of the monitor)",
        "min": 15,
        "max": 60,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "pipMargin",
        "type": "integer",
        "label": "Picture-in-picture margin from the screen edge (px)",
        "min": 0,
        "max": 200,
        "step": 4,
        "defaultValue": 16
      }
    ]
  },
  "homepage": "https://github.com/rmcdavid/omarchy-iptv"
}
