  "caseComment": "Each case names the EXACT channel names it must return, in the exact order.",
  "cases": [
    {
      "why": "one term, the roadmap's `baton rouge` shape",
      "queries": [
        "baton rouge"
      ],
      "expect": [
        "WBRZ Baton Rouge",
        "WAFB Baton Rouge",
        "Baton Rouge Sports Net"
      ]
    },
    {
      "why": "two saved searches whose results are DISJOINT: the union is simply both, in playlist order rather than in the order the searches were saved",
      "queries": [
        "baton rouge",
        "new orleans"
      ],
      "expect": [
        "WBRZ Baton Rouge",
        "WAFB Baton Rouge",
        "New Orleans WWL",
        "New Orleans WDSU",
        "Baton Rouge Sports Net",
        "Rouge FM New Orleans"
      ]
    },
    {
      "why": "OVERLAP: 'Rouge FM New Orleans' matches both `rouge` and `orleans`, so it must appear ONCE. Without this case the de-duplication is never exercised and a mutation removing it stays green.",
      "queries": [
        "rouge",
        "orleans"
      ],
      "expect": [
        "WBRZ Baton Rouge",
        "WAFB Baton Rouge",
        "New Orleans WWL",
        "New Orleans WDSU",
        "Baton Rouge Sports Net",
        "Rouge FM New Orleans"
      ]
    },
    {
      "why": "term order must not change the result, so the same pair reversed returns the same rows in the same PLAYLIST order",
      "queries": [
