#EXTM3U
# QA fixture: UTF-8 BOM + CRLF line endings, trailing spaces, a blank CRLF line, no final newline.
# Windows-authored playlists look like this; the BOM must not break #EXTM3U detection, the CR must not end up in URLs.
#EXTINF:-1 tvg-id="crlf1.test" group-title="CRLF",First CRLF Entry   
http://stream.example.test/crlf1.m3u8   

#EXTGRP:Persisted
#EXTINF:-1 tvg-id="crlf2.test",Second CRLF Entry
#EXTVLCOPT:http-user-agent=CRLF/1.0
http://stream.example.test/crlf2.m3u8
#EXTINF:-1 tvg-id="crlf3.test",Last Line Without Newline
http://stream.example.test/crlf3.m3u8