  {"noProxy": "*.example.test", "host": "example.test", "match": true},
  {"noProxy": ".example.test", "host": "example.test", "match": true},
  {"noProxy": ".example.test", "host": "a.example.test", "match": true},
  {"noProxy": "*example.test", "host": "a.example.test", "match": true},
  {"noProxy": "*example.test", "host": "aexample.test", "match": false},
  {"noProxy": "**.example.test", "host": "a.example.test", "match": false},
