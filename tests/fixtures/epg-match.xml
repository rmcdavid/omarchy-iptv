<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE tv SYSTEM "xmltv.dtd">
<!-- M4-01 / M4-02 fixture. Guide side of tests/fixtures/epg-match.m3u; the
     expected counts live in tests/fixtures/epg-match.json. Test "now" is
     2026-09-12 21:00:00 UTC, the same instant epg-basic.xml uses. ASCII only.

     Every declaration below is deliberate:
       Exact.us        the playlist id as written, and a display-name that
                       does NOT match the playlist name, so the id is the
                       only thing that could have matched it
       Suffix.us       playlist "Suffix.us@SD" -> guide bare id
       Bare.us@HD      playlist "Bare.us" -> guide suffixed id (the reverse)
       pluto-name      matches "Name Only Channel" by name alone
       pluto-twin      name "Twin Channel", which TWO playlist rows claim:
                       ambiguous on our side, must not match
       pluto-a/pluto-b both named "Double Declared": ambiguous on the guide's
                       side, must not match, counted as two declarations
       pluto-unkeyed   names a playlist row that carries no tvg-id, so there
                       is no key to publish it under and it cannot match
       Detail.us       the M4-02 fields, including a description carrying
                       markup and a credentialed-looking URL
       case.us         playlist "Case.US": the lower-case alias
       pluto-clash     reaches "Clash Channel" by name BEFORE Clash.us
                       reaches it by id, so the id must displace the name
       Multi.us@SD/HD  two guide channels fold to one playlist base: the
                       first claims it, the second is refused, never merged
       pluto-noise     matches "Noise Channel (1080p) [Geo-blocked]" ONLY
                       through epg_name_key: on normalize_text, the search
                       key, the two names are different strings and nothing
                       matches. The markers are on OUR side here, so this
                       pair reddens the PLAYLIST call site
       pluto-gnoise    the mirror image: the markers are on the GUIDE's side
                       ("Guide Marker Channel (720p)" against a clean
                       playlist name), so this pair reddens the GUIDE call
                       site. One pair alone leaves the other site revertible
                       with the suite green (tests/test_epg_match.py rule 11)
       pluto-numfirst  declares a channel NUMBER first, the matching name
                       second and a non-matching language variant third, so
                       neither "the first display-name" nor "the last" finds
                       it; only "the first one a playlist channel claims" does
       pluto-lang      declares a non-matching language first, the matching
                       name second: the same rule, the shape real guides ship
       Markup.us       a <desc> carrying a CHILD ELEMENT, which elem.text
                       truncates at the first tag
       Sink.us         a <desc> whose EPG_MAX_DESC cut lands inside a URL's
                       userinfo: the rule 5 case that leaked the username
-->
<tv generator-info-name="omarchy-iptv fixture" source-info-name="fixture">
  <channel id="Exact.us"><display-name>Exact Guide Name</display-name></channel>
  <channel id="Suffix.us"><display-name>Suffix Guide Name</display-name></channel>
  <channel id="Bare.us@HD"><display-name>Bare Guide Name</display-name></channel>
  <channel id="pluto-name"><display-name>Name Only Channel</display-name></channel>
  <channel id="pluto-twin"><display-name>Twin Channel</display-name></channel>
  <channel id="pluto-a"><display-name>Double Declared</display-name></channel>
  <channel id="pluto-b"><display-name>Double Declared</display-name></channel>
  <channel id="pluto-unkeyed"><display-name>Unkeyed Channel</display-name></channel>
  <channel id="Detail.us"><display-name>Detail Channel</display-name></channel>
  <channel id="case.us"><display-name>Case Guide Name</display-name></channel>
  <channel id="pluto-clash"><display-name>Clash Channel</display-name></channel>
  <channel id="Multi.us@SD"><display-name>Multi Guide SD</display-name></channel>
  <channel id="Multi.us@HD"><display-name>Multi Guide HD</display-name></channel>
  <channel id="pluto-noise"><display-name>Noise Channel</display-name></channel>
  <channel id="pluto-gnoise"><display-name>Guide Marker Channel (720p)</display-name></channel>
  <channel id="pluto-numfirst"><display-name>101</display-name><display-name>Number First Channel</display-name><display-name>Nummer Eins Kanal</display-name></channel>
  <channel id="pluto-lang"><display-name lang="es">Canal Lengua</display-name><display-name lang="en">Lang Channel</display-name></channel>
  <channel id="Markup.us"><display-name>Markup Guide Name</display-name></channel>
  <channel id="Sink.us"><display-name>Sink Guide Name</display-name></channel>

  <!-- Strategy (a): the exact id. The empty <desc> must not reach the panel. -->
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="Exact.us"><title>Exact Now</title><desc>   </desc></programme>

  <!-- Strategy (b): the feed suffix, both directions. -->
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="Suffix.us"><title>Suffix Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="Bare.us@HD"><title>Bare Now</title></programme>

  <!-- Strategy (c): the normalised name. -->
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="pluto-name"><title>Name Now</title></programme>

  <!-- Dropped: ambiguous on our side, ambiguous on the guide's side, and a
       playlist row with no tvg-id. All three count as "not in the playlist". -->
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="pluto-twin"><title>Twin Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="pluto-a"><title>Double Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="pluto-unkeyed"><title>Unkeyed Now</title></programme>

  <!-- M4-02. Two categories (only the first is kept), two episode-num
       systems (onscreen wins), an <icon> and a <url> that must never be
       read, and a description that is over the cap, carries escaped markup
       and carries a URL with a path and a query. -->
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="Detail.us">
    <title>Detail Now</title>
    <desc>&lt;img src="http://evil.example.test/p.png"&gt; Watch more at http://promo.example.test/path?token=abc123 then sleep. Filler one. Filler two. Filler three. Filler four. Filler five. Filler six. Filler seven. Filler eight. Filler nine. Filler ten. Filler eleven. Filler twelve. Filler thirteen. Filler fourteen. Filler fifteen. Filler sixteen. Filler seventeen. Filler eighteen. Filler nineteen. Filler twenty. Filler twenty-one. Filler twenty-two.</desc>
    <category>Documentary</category>
    <category>Second Category Ignored</category>
    <episode-num system="xmltv_ns">1.4.0/1</episode-num>
    <episode-num system="onscreen">S2 E5</episode-num>
    <icon src="http://icon.example.test/detail.png"/>
    <url>http://portal.example.test/detail?user=secret</url>
  </programme>
  <!-- The next programme declares only an xmltv_ns episode: 0.1.0/1 is
       season 0, episode 1, zero-based, so it reads S1 E2. -->
  <programme start="20260912213000 +0000" stop="20260912223000 +0000" channel="Detail.us"><title>Detail Next</title><episode-num system="xmltv_ns">0.1.0/1</episode-num></programme>

  <!-- The lower-case alias of strategy (a). -->
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="case.us"><title>Case Now</title></programme>

  <!-- The name claim arrives FIRST and must lose to the id claim below. It
       also starts LATER, so if it ever survived it would become the "now"
       and not merely an extra record: that is what makes the displacement
       observable in epg-now.json. -->
  <programme start="20260912204500 +0000" stop="20260912213000 +0000" channel="pluto-clash"><title>Clash Name Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="Clash.us"><title>Clash Id Now</title></programme>

  <!-- Same strategy, two guide channels, one playlist base: first wins. -->
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="Multi.us@SD"><title>Multi SD Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="Multi.us@HD"><title>Multi HD Now</title></programme>
  <!-- The name key, which is not the search key. The playlist row is
       "Noise Channel (1080p) [Geo-blocked]"; only epg_name_key folds the two
       to one string, so reverting either call site leaves this row blank. -->
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="pluto-noise"><title>Noise Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="pluto-gnoise"><title>Guide Marker Now</title></programme>

  <!-- Several <display-name>s, and the match is not the first or the last. -->
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="pluto-numfirst"><title>Number First Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="pluto-lang"><title>Lang Now</title></programme>

  <!-- A description with real markup inside it. `desc.text` stops at <b>,
       so the tail after the child element is the part that used to vanish. -->
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="Markup.us">
    <title>Markup Now</title>
    <desc>Hello <b>world</b> and more</desc>
  </programme>

  <!-- Rule 5. The EPG_MAX_DESC cut falls at code point 400, which is inside
       this URL's password, and a URL cut before its "@" reads as a host:
       redacting the cut text published "http://u5er". The whole truncated
       token goes instead, so the panel gets the 385-character pad and nothing
       of the credential. -->
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="Sink.us">
    <title>Sink Now</title>
    <desc> http://u5er:5ecretpw@host.example/live/x.m3u8?t=abc trailing words.</desc>
  </programme>
  <!-- F-EPG-11, the ADDRESS strategy (added 2026-10-04). Ids are synthetic;
       the URL layouts they sit in are copied from the installed list.
         ...0001            reaches "Address Channel" by its stream address
                            alone: the display-name matches no playlist row
         globalfashionchannel  a guide id that is not hex, so ADDR is shown
                            to name no id shape
         ...0002            sits in that row's LOGO and not in its stream:
                            must not match
         playlist           shorter than EPG_ADDR_MIN_TOKEN and a word real
                            addresses carry: must not match
         ...0003            the address of TWO playlist rows: ambiguous on
                            our side, must not match
         ...0004 / ...0005  both named by ONE row's address: first come,
                            second contested
         ...0006            declared once, reachable by address on the Web
                            row and by name on the Eastern row. ADDR is
                            asked first, so the row that streams it wins
         ...0008 / ...0007  the first reaches the row by address, the second
                            by the row's own tvg-id. ...0008 streams first
                            and starts LATER, so if the declared join ever
                            stopped displacing it, it would become the "now"
         feedbasetoken1     this id is one row's address token and another
                            row's feed base: ADDR is asked first
         mixedcasetoken12   the address spells it MixedCaseToken12, and ADDR
                            does not fold case: must not match -->
  <channel id="aaaaaaaaaaaaaaaaaaaa0001"><display-name>Address Guide Name</display-name></channel>
  <channel id="globalfashionchannel"><display-name>Slug Guide Name</display-name></channel>
  <channel id="aaaaaaaaaaaaaaaaaaaa0002"><display-name>Artwork Guide Name</display-name></channel>
  <channel id="playlist"><display-name>Short Guide Name</display-name></channel>
  <channel id="aaaaaaaaaaaaaaaaaaaa0003"><display-name>Dup Guide Name</display-name></channel>
  <channel id="aaaaaaaaaaaaaaaaaaaa0004"><display-name>First Of Two</display-name></channel>
  <channel id="aaaaaaaaaaaaaaaaaaaa0005"><display-name>Second Of Two</display-name></channel>
  <channel id="aaaaaaaaaaaaaaaaaaaa0006"><display-name>Rank Channel</display-name></channel>
  <channel id="aaaaaaaaaaaaaaaaaaaa0007"><display-name>Id Guide Name</display-name></channel>
  <channel id="aaaaaaaaaaaaaaaaaaaa0008"><display-name>Addr Loser Guide Name</display-name></channel>
  <channel id="feedbasetoken1"><display-name>Feed Or Addr Guide Name</display-name></channel>
  <channel id="aaaaaaaaaaaaaaaaaaaa0009"><display-name>Declared Or Address</display-name></channel>
  <channel id="mixedcasetoken12"><display-name>Case Guide Token Name</display-name></channel>

  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="aaaaaaaaaaaaaaaaaaaa0001"><title>Addr Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="globalfashionchannel"><title>Slug Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="aaaaaaaaaaaaaaaaaaaa0002"><title>Artwork Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="playlist"><title>Short Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="aaaaaaaaaaaaaaaaaaaa0003"><title>Dup Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="aaaaaaaaaaaaaaaaaaaa0004"><title>Two First Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="aaaaaaaaaaaaaaaaaaaa0005"><title>Two Second Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="aaaaaaaaaaaaaaaaaaaa0006"><title>Rank Now</title></programme>
  <programme start="20260912204500 +0000" stop="20260912213000 +0000" channel="aaaaaaaaaaaaaaaaaaaa0008"><title>Addr Loser Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="aaaaaaaaaaaaaaaaaaaa0007"><title>Addr Id Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="feedbasetoken1"><title>Addr Over Feed Now</title></programme>
  <programme start="20260912203000 +0000" stop="20260912213000 +0000" channel="mixedcasetoken12"><title>Case Token Now</title></programme>
  <programme start="20260912204500 +0000" stop="20260912213000 +0000" channel="aaaaaaaaaaaaaaaaaaaa0009"><title>Declared Wins Now</title></programme>
</tv>
