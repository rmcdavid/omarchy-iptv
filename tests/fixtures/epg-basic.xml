  <programme start="20260913110000 +0100" stop="20260913120000 +0100" channel="bbc1.uk"><title>Tomorrow Morning</title></programme>

  <!-- cnn.us: negative offset, a programme ending exactly now, then a gap. -->
  <programme start="20260912150000 -0500" stop="20260912160000 -0500" channel="cnn.us"><title>Ends Exactly Now</title></programme>
  <programme start="20260912163000 -0500" stop="20260912170000 -0500" channel="cnn.us"><title>After The Gap</title></programme>

