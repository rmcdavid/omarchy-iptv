<!-- Synthetic XMLTV fixture. Test "now" is 2026-09-12 21:00:00 UTC
     (= 22:00 +0100 = 16:00 -0500). Window: now-2h .. now+12h. ASCII only. -->
<tv generator-info-name="omarchy-iptv fixture" source-info-name="fixture">
