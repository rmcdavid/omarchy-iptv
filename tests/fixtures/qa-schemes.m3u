#EXTM3U
# QA fixture: stream URL scheme allow-list (ARCHITECTURE.md 8.3, docs/QA.md SEC-05/SEC-06).
# Allowed: http https rtmp rtmps rtsp udp rtp mms mmsh srt (scheme is case-insensitive, surrounding whitespace trimmed).
# Everything else must be dropped and counted in a warning, including every mpv
# pseudo-protocol that can read local files or run code (edl, mf, av, lavf, fd, memory, ytdl, ...).
#EXTINF:-1 tvg-id="ok-http",Allowed http
http://stream.example.test/ok.m3u8
#EXTINF:-1 tvg-id="ok-https",Allowed https
https://stream.example.test/ok.m3u8
#EXTINF:-1 tvg-id="ok-rtsp",Allowed rtsp
rtsp://cam.example.test:554/live
#EXTINF:-1 tvg-id="ok-udp",Allowed udp multicast
udp://@239.0.0.1:1234
#EXTINF:-1 tvg-id="ok-rtp",Allowed rtp
rtp://239.0.0.2:5004
#EXTINF:-1 tvg-id="ok-rtmp",Allowed rtmp
rtmp://live.example.test/app/stream
#EXTINF:-1 tvg-id="ok-rtmps",Allowed rtmps
rtmps://live.example.test/app/stream
#EXTINF:-1 tvg-id="ok-mms",Allowed mms
mms://media.example.test/stream
#EXTINF:-1 tvg-id="ok-mmsh",Allowed mmsh
mmsh://media.example.test/stream
#EXTINF:-1 tvg-id="ok-srt",Allowed srt
srt://relay.example.test:9000?streamid=live
#EXTINF:-1 tvg-id="ok-upper",Allowed uppercase scheme
HTTP://UPPER.EXAMPLE.TEST/ok.m3u8
#EXTINF:-1 tvg-id="ok-space",Allowed with surrounding whitespace
   http://padded.example.test/ok.m3u8
#EXTINF:-1 tvg-id="ok-inner-space",Allowed http with an option-looking suffix inside the same line
http://stream.example.test/x.m3u8 --script=/tmp/evil.lua
#EXTINF:-1 tvg-id="bad-file",Dropped file scheme
file:///etc/passwd
#EXTINF:-1 tvg-id="bad-path",Dropped bare absolute path
/etc/passwd
#EXTINF:-1 tvg-id="bad-tilde",Dropped tilde path
~/Videos/private.mp4
#EXTINF:-1 tvg-id="bad-relative",Dropped relative path
live/1.ts
#EXTINF:-1 tvg-id="bad-ftp",Dropped ftp
ftp://files.example.test/list.m3u
#EXTINF:-1 tvg-id="bad-plugin",Dropped kodi plugin
plugin://plugin.video.something/?id=1
#EXTINF:-1 tvg-id="bad-js",Dropped javascript
javascript:alert(1)
#EXTINF:-1 tvg-id="bad-data",Dropped data
data:text/plain,hello
#EXTINF:-1 tvg-id="bad-option",Dropped option injection
--script=/tmp/evil.lua
#EXTINF:-1 tvg-id="bad-dashdash",Dropped bare double dash
--
#EXTINF:-1 tvg-id="bad-edl",Dropped mpv edl
edl://%17%/etc/passwd
#EXTINF:-1 tvg-id="bad-mf",Dropped mpv mf
mf://~/Pictures/*.jpg
#EXTINF:-1 tvg-id="bad-av",Dropped mpv avdevice
av://v4l2:/dev/video0
#EXTINF:-1 tvg-id="bad-lavf",Dropped mpv lavf
lavf://concat:/etc/passwd
#EXTINF:-1 tvg-id="bad-fd",Dropped mpv fd
fd://0
#EXTINF:-1 tvg-id="bad-memory",Dropped mpv memory
memory://#EXTM3U
#EXTINF:-1 tvg-id="bad-ytdl",Dropped mpv ytdl
ytdl://example
#EXTINF:-1 tvg-id="bad-smb",Dropped smb
smb://nas.example.test/share/video.ts
#EXTINF:-1 tvg-id="bad-dvd",Dropped dvd
dvd://1
#EXTINF:-1 tvg-id="bad-null",Dropped null
null://
#EXTINF:-1 tvg-id="bad-empty-host",Dropped http without host
http://
#EXTINF:-1 tvg-id="bad-protorel",Dropped protocol-relative
//stream.example.test/x.m3u8
http://stream.example.test/orphan-1.m3u8
http://stream.example.test/orphan-2.m3u8
