{
  "_comment": [
    "QA fixture: Xtream URL-building expectations for Model.xtreamUrls (ARCHITECTURE-SOURCES.md 3.4) and the Xtream form (UX-SOURCES.md 1.8, 5.4).",
    "Consumed by hand and by scripts/qa-sources-scenarios.sh; Lane 1 may load it in tests/Model.test.js. Unknown keys must be ignored by any loader.",
    "Each case: server/username/password are the raw field values (before sanitizing). expect.ok true carries playlistUrl, epgUrl, host and key = fnv1a32(playlistUrl) computed with the shipped Model.fnv1a32.",
    "expect.ok false carries code = the user-facing code of UX-SOURCES.md 5.4 (canonical per SR6) and archCode = the Model.xtreamUrls code of ARCH 3.4; decision names a lead ruling still open (docs/QA-SOURCES.md section 10).",
    "Percent-encoding rule under test: only A-Za-z0-9-._~ survive; space -> %20, !*'() -> %21 %2A %27 %28 %29, non-ASCII -> UTF-8 percent-encoded uppercase; parameter order fixed: username, password, type, output."
  ],
  "cases": [
    {"id": "SRC-XT-V01", "server": "http://127.0.0.1:8765", "username": "user", "password": "pa ss", "expect": {"ok": true, "playlistUrl": "http://127.0.0.1:8765/get.php?username=user&password=pa%20ss&type=m3u_plus&output=ts", "epgUrl": "http://127.0.0.1:8765/xmltv.php?username=user&password=pa%20ss", "host": "127.0.0.1", "key": "6e90a03e"}, "note": "the harness route: tests/fixtures/qa-sources/xtream/get.php and xmltv.php served on 127.0.0.1:8765"},
    {"id": "SRC-XT-V02", "server": "http://127.0.0.1:8765/", "username": "user", "password": "pa ss", "expect": {"ok": true, "playlistUrl": "http://127.0.0.1:8765/get.php?username=user&password=pa%20ss&type=m3u_plus&output=ts", "epgUrl": "http://127.0.0.1:8765/xmltv.php?username=user&password=pa%20ss", "host": "127.0.0.1", "key": "6e90a03e"}, "note": "trailing slash stripped: same URL, same key as V01 (duplicate on a second add)"},
    {"id": "SRC-XT-V03", "server": "http://127.0.0.1:8765/get.php", "username": "user", "password": "pa ss", "expect": {"ok": true, "playlistUrl": "http://127.0.0.1:8765/get.php?username=user&password=pa%20ss&type=m3u_plus&output=ts", "epgUrl": "http://127.0.0.1:8765/xmltv.php?username=user&password=pa%20ss", "host": "127.0.0.1", "key": "6e90a03e"}, "note": "a pasted get.php path (no query) is stripped once; xmltv.php, player_api.php and /c strip the same way"},
    {"id": "SRC-XT-V04", "server": "http://127.0.0.1:8765/player_api.php", "username": "user", "password": "pa ss", "expect": {"ok": true, "playlistUrl": "http://127.0.0.1:8765/get.php?username=user&password=pa%20ss&type=m3u_plus&output=ts", "epgUrl": "http://127.0.0.1:8765/xmltv.php?username=user&password=pa%20ss", "host": "127.0.0.1", "key": "6e90a03e"}},
    {"id": "SRC-XT-V05", "server": "http://Provider.Example.TEST:8080/", "username": "u", "password": "p", "expect": {"ok": true, "playlistUrl": "http://provider.example.test:8080/get.php?username=u&password=p&type=m3u_plus&output=ts", "epgUrl": "http://provider.example.test:8080/xmltv.php?username=u&password=p", "host": "provider.example.test", "key": "85ac744a"}, "note": "ARCH 3.4 vector: host lowercased, non-default port kept"},
    {"id": "SRC-XT-V06", "server": "https://h.test/c", "username": "a b", "password": "p&q", "expect": {"ok": true, "playlistUrl": "https://h.test/get.php?username=a%20b&password=p%26q&type=m3u_plus&output=ts", "epgUrl": "https://h.test/xmltv.php?username=a%20b&password=p%26q", "host": "h.test", "key": "43269789"}, "note": "ARCH 3.4 vector: the web-player path /c is stripped"},
    {"id": "SRC-XT-V07", "server": "http://h.test:8080/xtream/", "username": "user", "password": "pa ss", "expect": {"ok": true, "playlistUrl": "http://h.test:8080/xtream/get.php?username=user&password=pa%20ss&type=m3u_plus&output=ts", "epgUrl": "http://h.test:8080/xtream/xmltv.php?username=user&password=pa%20ss", "host": "h.test", "key": "648eadcf"}, "note": "a base path other than the four stripped names is kept"},
    {"id": "SRC-XT-V08", "server": "https://h.test:443/get.php", "username": "user", "password": "pa ss", "expect": {"ok": true, "playlistUrl": "https://h.test/get.php?username=user&password=pa%20ss&type=m3u_plus&output=ts", "epgUrl": "https://h.test/xmltv.php?username=user&password=pa%20ss", "host": "h.test", "key": "49aecb60"}, "note": "scheme default port dropped by validateSourceUrl"},
    {"id": "SRC-XT-V09", "server": "http://[::1]:8080", "username": "user", "password": "pa ss", "expect": {"ok": true, "playlistUrl": "http://[::1]:8080/get.php?username=user&password=pa%20ss&type=m3u_plus&output=ts", "epgUrl": "http://[::1]:8080/xmltv.php?username=user&password=pa%20ss", "host": "[::1]", "key": "16142eac"}, "note": "IPv6 literal server; host as validateSourceUrl computes it (brackets kept)"},
    {"id": "SRC-XT-V10", "server": "http://h.test", "username": "a&b=c", "password": "p+q/r?#%", "expect": {"ok": true, "playlistUrl": "http://h.test/get.php?username=a%26b%3Dc&password=p%2Bq%2Fr%3F%23%25&type=m3u_plus&output=ts", "epgUrl": "http://h.test/xmltv.php?username=a%26b%3Dc&password=p%2Bq%2Fr%3F%23%25", "host": "h.test", "key": "e28840a2"}, "note": "query-breaking characters: & = + / ? # % all percent-encoded so the query keeps exactly four parameters"},
    {"id": "SRC-XT-V11", "server": "http://h.test", "username": "u!*'()~-._", "password": "p@h:1", "expect": {"ok": true, "playlistUrl": "http://h.test/get.php?username=u%21%2A%27%28%29~-._&password=p%40h%3A1&type=m3u_plus&output=ts", "epgUrl": "http://h.test/xmltv.php?username=u%21%2A%27%28%29~-._&password=p%40h%3A1", "host": "h.test", "key": "68ad73e9"}, "note": "the five characters encodeURIComponent leaves alone must be encoded (Python quote(safe='') parity); ~-._ survive; @ and : encoded so the password never looks like userinfo"},
    {"id": "SRC-XT-V12", "server": "http://h.test", "username": "p\u00e4ss", "password": "\u20ac", "expect": {"ok": true, "playlistUrl": "http://h.test/get.php?username=p%C3%A4ss&password=%E2%82%AC&type=m3u_plus&output=ts", "epgUrl": "http://h.test/xmltv.php?username=p%C3%A4ss&password=%E2%82%AC", "host": "h.test", "key": "cf2365a9"}, "note": "non-ASCII credentials: UTF-8 bytes, uppercase hex, identical in node, the Qt engine and Python"},
    {"id": "SRC-XT-V13", "server": "  http://127.0.0.1:8765  ", "username": " user ", "password": "pa ss", "expect": {"ok": true, "playlistUrl": "http://127.0.0.1:8765/get.php?username=user&password=pa%20ss&type=m3u_plus&output=ts", "epgUrl": "http://127.0.0.1:8765/xmltv.php?username=user&password=pa%20ss", "host": "127.0.0.1", "key": "6e90a03e"}, "note": "fields are trimmed on submit (UX 2.3); an inner space in the password is data"},
    {"id": "SRC-XT-V14", "server": "http://127.0.0.1:8765", "username": "us\ter\n", "password": "pa\u0000 ss", "expect": {"ok": true, "playlistUrl": "http://127.0.0.1:8765/get.php?username=user&password=pa%20ss&type=m3u_plus&output=ts", "epgUrl": "http://127.0.0.1:8765/xmltv.php?username=user&password=pa%20ss", "host": "127.0.0.1", "key": "6e90a03e"}, "note": "control characters (TAB, LF, NUL) are stripped by sanitizeInput before encoding"},

    {"id": "SRC-XT-E01", "server": "", "username": "user", "password": "pa ss", "expect": {"ok": false, "code": "server_empty", "archCode": "bad_server", "message": "Enter the server URL"}},
    {"id": "SRC-XT-E02", "server": "   ", "username": "user", "password": "pa ss", "expect": {"ok": false, "code": "server_empty", "archCode": "bad_server"}},
    {"id": "SRC-XT-E03", "server": "ftp://h.test", "username": "user", "password": "pa ss", "expect": {"ok": false, "code": "server_scheme", "archCode": "bad_server", "message": "Server must start with http:// or https://"}},
    {"id": "SRC-XT-E04", "server": "http://h.test/get.php?username=a&password=b&type=m3u_plus&output=ts", "username": "user", "password": "pa ss", "expect": {"ok": false, "code": "server_path", "archCode": "bad_server", "message": "Server is just http://host:port - no path"}, "note": "UX 8 item 10: no auto-parse of a pasted get.php URL; the URL form accepts it instead"},
    {"id": "SRC-XT-E05", "server": "http://h.test/#frag", "username": "user", "password": "pa ss", "expect": {"ok": false, "code": "server_path", "archCode": "bad_server"}, "note": "a fragment on the server is refused like a query (ARCH 3.4 step 1)"},
    {"id": "SRC-XT-E06", "server": "http://h .test", "username": "user", "password": "pa ss", "expect": {"ok": false, "code": "invalid", "archCode": "bad_url"}, "note": "shared validateSourceUrl rules apply to the server; UX 5.4 invalid covers the Server field"},
    {"id": "SRC-XT-E07", "server": "http://h.test", "username": "", "password": "pa ss", "expect": {"ok": false, "code": "user_empty", "archCode": "bad_credentials", "message": "Enter the username"}},
    {"id": "SRC-XT-E08", "server": "http://h.test", "username": "user", "password": "", "expect": {"ok": false, "code": "pass_empty", "archCode": "bad_credentials", "message": "Enter the password"}},
    {"id": "SRC-XT-E09", "server": "http://h.test", "username": "\u0000\u0001", "password": "pa ss", "expect": {"ok": false, "code": "user_empty", "archCode": "bad_credentials"}, "note": "a username made only of control characters is empty after sanitizing"},

    {"id": "SRC-XT-D01", "server": "127.0.0.1:8765", "username": "user", "password": "pa ss", "expect": {"ok": true, "playlistUrl": "http://127.0.0.1:8765/get.php?username=user&password=pa%20ss&type=m3u_plus&output=ts", "epgUrl": "http://127.0.0.1:8765/xmltv.php?username=user&password=pa%20ss", "host": "127.0.0.1", "key": "6e90a03e"}, "decision": "SRC-DEC-06", "note": "ARCH D10 / 3.4 prefixes http:// when the server has no scheme (expectation above); UX 5.4 server_scheme and UX 8 item 9 refuse it. The lead picks one before the pass"},
    {"id": "SRC-XT-D02", "server": "http://u:p@h.test", "username": "user", "password": "pa ss", "expect": {"ok": false, "code": null, "archCode": "bad_server"}, "decision": "SRC-DEC-07", "note": "ARCH refuses userinfo on the server; UX 5.4 has no code for it (server_path is the nearest). The lead names the code and the message"},
    {"id": "SRC-XT-D03", "server": "http://h.test", "username": "USERNAME-257", "password": "pa ss", "padTo": {"username": 257}, "expect": {"ok": false, "code": "user_too_long", "archCode": null}, "decision": "SRC-DEC-08", "note": "loader: pad username with 'u' to 257 characters. UX 5.4 user_too_long (cap 256 per SR5); ARCH 3.4 step 2 silently truncates to MAX_XTREAM_FIELD, which would build a login with a wrong credential. Recommend the error"},
    {"id": "SRC-XT-D04", "server": "http://h.test", "username": "user", "password": "PASSWORD-257", "padTo": {"password": 257}, "expect": {"ok": false, "code": "pass_too_long", "archCode": null}, "decision": "SRC-DEC-08"},
    {"id": "SRC-XT-D05", "server": "http://h.test/", "username": "user", "password": "pa ss", "padTo": {"server": 513}, "expect": {"ok": false, "code": null, "archCode": null}, "decision": "SRC-DEC-08", "note": "loader: pad the server path with 'a' to 513 characters. ARCH truncates at 512 then validates (a silently shortened base path); UX has no server length code. Recommend too_long on the Server field"}
  ]
}
