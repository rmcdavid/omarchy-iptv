#!/usr/bin/env python3
"""omarchy-iptv -- data helper for the io.github.rmcdavid.iptv Omarchy shell plugin.

Standard library only (python3 is a hard dependency of Omarchy through uwsm).
Every subcommand prints exactly one JSON object on stdout; human-readable
detail goes to stderr. Never prints a playlist/EPG/stream URL (it may embed
credentials): every message passes through `redact_urls`, errors carry the
host name only.

Exit codes:
  0  ok
  1  runtime error (JSON error object on stdout, one line on stderr)
  2  usage error (argparse)
  3  reserved (not implemented; no subcommand uses it any more)

Subcommands (contract of record: ARCHITECTURE.md (dev branch) section 5):
  playlist --url U [--cache-dir D] [--timeout S]
      fetch + parse M3U -> channels.json, playlist-status.json
  epg [--url U] [--cache-dir D] [--timeout S] [--ttl S] [--force] [--now-only] [--now T]
      XMLTV -> epg-window.txt (private cache), epg-now.json, epg-status.json
  play (--id ID | --url U) [--cache-dir D] [--socket P] [--ipc-timeout S]
      switch the running mpv to a channel over its JSON IPC socket
  stop [--socket P] [--ipc-timeout S]
      ask the running mpv to quit
  status [--socket P] [--ipc-timeout S]
      query the running mpv (media title, host of the path, pause, idle, version)
  state [--state-dir D] show | init | favorite add ID | favorite remove ID | clear-recents
      inspect or edit state.json atomically (init: create it 0600 when missing)
  state [--state-dir D] source list | add --url U [--epg-url E] [--label L] | update KEY ... | remove KEY
      the source history (state.json version 2); output carries hosts, never URLs
  cache [--cache-dir D] migrate [--key K] | remove --key K | prune [--keep K ...] [--active K]
      per-source cache directories under <cache-dir>/sources/<key>/ (M2-01, D5/D6)
"""
from __future__ import annotations

import argparse
import bisect
import errno
import fcntl
import gzip
import io
import json
import os
import re
import select
import signal
import stat
import sys
import time
import urllib.parse
import zlib
from typing import Any, BinaryIO

# Heavier modules (socket, calendar, hashlib, unicodedata, urllib.request,
# xml.etree, traceback) are imported where needed so that `play`, `status`
# and `epg --now-only` start faster.

def _manifest_version() -> str:
    """The plugin's version, read from manifest.json beside this helper.

    D-REL-1: a constant here said 0.2.0 for four releases while the manifest
    moved on, so --version and the User-Agent both lied and nothing noticed.
    manifest.json is on the release allowlist, so it is always beside the
    helper in an install; the fallback only keeps a stray copy starting."""
    try:
        here = os.path.dirname(os.path.abspath(__file__))
        with open(os.path.join(here, os.pardir, "manifest.json"), encoding="utf-8") as fh:
            found = json.load(fh).get("version")
        if isinstance(found, str) and found.strip():
            return found.strip()
    except (OSError, ValueError):
        pass
    return "0.0.0+unknown"


VERSION = _manifest_version()
USER_AGENT = "omarchy-iptv/" + VERSION

EXIT_OK = 0
EXIT_ERROR = 1
EXIT_USAGE = 2

# Schemes a stream URL may use. Anything else is dropped at parse time so it
# can never reach mpv (neither as argv nor over IPC).
STREAM_SCHEMES = {"http", "https", "rtmp", "rtmps", "rtsp", "udp", "rtp", "mms", "mmsh", "srt"}
# Schemes a playlist/EPG *source* may use.
SOURCE_SCHEMES = {"http", "https", "file"}

MAX_SOURCE_BYTES = 64 * 1024 * 1024
# Bounds on what channels.json may carry (S-07): the shell parses that file
# on its UI thread and the guide builds one column row per group. A 64 MB
# source of 40-byte entries would otherwise be ~1.5 M channels. Real lists
# top out around 11k channels / 1k groups; entries beyond MAX_CHANNELS are
# dropped with a warning, groups beyond MAX_GROUPS fold into UNGROUPED
# (which may exist as one extra bucket, so at most MAX_GROUPS + 1 groups).
MAX_CHANNELS = 50000
MAX_GROUPS = 2000
DEFAULT_TIMEOUT = 20
# `--timeout` is a per-socket-operation timeout; a server that trickles one
# byte per second would keep the helper alive forever (S-05). Every HTTP
# download also runs under a wall-clock budget of max(HTTP_DEADLINE_MIN,
# 3 x --timeout) seconds, read in chunks so the check runs often. Tests
# shrink the budget through HTTP_DEADLINE_ENV; the service never sets it.
HTTP_DEADLINE_MIN = 60.0
HTTP_DEADLINE_ENV = "OMARCHY_IPTV_HTTP_DEADLINE"
HTTP_CHUNK = 256 * 1024
DEFAULT_IPC_TIMEOUT = 2.0
UNGROUPED = "Ungrouped"

CHANNELS_FILE = "channels.json"
PLAYLIST_STATUS_FILE = "playlist-status.json"
EPG_NOW_FILE = "epg-now.json"
EPG_STATUS_FILE = "epg-status.json"
# Helper-private programme window (not a QML contract). Line 1 is a JSON
# header; every following line is "<channel id>\t<records>" so that a
# 10k-channel window loads with str.split instead of a JSON parse.
EPG_WINDOW_FILE = "epg-window.txt"
STATE_FILE = "state.json"
# Per-source cache layout (ARCHITECTURE-SOURCES.md D5/D6): every source keeps
# the five file names above inside <cache-dir>/sources/<key>/. The key is
# fnv1a32 of the normalized playlist URL (8 hex digits, "-2", "-3" on a
# collision); it is validated before it ever becomes a path component.
SOURCES_DIR = "sources"
SOURCE_KEY_RE = re.compile(r"^[0-9a-f]{8}(-[0-9]{1,3})?$")
FAILED_FILE = "failed.json"
# FAILED_FILE is in this tuple deliberately: it is what makes a removed
# source take its failure marks with it, which is D-LOGO-4's lesson applied
# before the defect rather than after it.
CACHE_FILES = (CHANNELS_FILE, PLAYLIST_STATUS_FILE, EPG_NOW_FILE, EPG_STATUS_FILE, EPG_WINDOW_FILE,
               FAILED_FILE)
EPG_CACHE_FILES = (EPG_WINDOW_FILE, EPG_NOW_FILE, EPG_STATUS_FILE)
TEMP_PREFIX = ".tmp-"
DEFAULT_EPG_MAX_AGE = 86400
# Channel id schemes (ARCHITECTURE.md decision 6). Scheme 1 shipped from 0.1
# to 0.7: `t:<tvg-id>` when unique in the playlist, else `u:<fnv1a32(url)>`.
# The stream URL of an Xtream provider carries the account password, so every
# `u:` id dies the day that password is rotated -- measured on the user's own
# 3,335-channel list, exactly 1 id of 3,335 survived a rotation, taking every
# favorite, recent, lastPlayed and session record with it. Scheme 2 tries the
# channel NAME in between: the one column a credential rotation cannot touch.
CHANNEL_ID_SCHEME_LEGACY = 1
CHANNEL_ID_SCHEME = 2
# state.json version 2 (ARCHITECTURE-SOURCES.md section 2.1); caps per SR5.
STATE_VERSION = 2
CACHE_LAYOUT = 2
MAX_SOURCES = 50
MAX_SOURCE_URL = 2048
MAX_LABEL = 64
SOURCE_ORIGINS = ("guide", "xtream", "cli", "migrated")
SOURCE_KINDS = ("http", "file")
UNSAFE_PATH_PREFIXES = ("/proc", "/sys", "/dev")

# EPG window kept in the private cache: programmes overlapping
# [now - EPG_PAST_SECONDS, now + EPG_FUTURE_SECONDS] at fetch time.
EPG_PAST_SECONDS = 2 * 3600
EPG_FUTURE_SECONDS = 12 * 3600
EPG_DEFAULT_TTL = 6 * 3600
EPG_REFETCH_MARGIN = 2 * 3600     # re-download when the window ends sooner than this
EPG_VALID_MAX = 300               # epg-now.json is never declared valid longer than this
EPG_MAX_TITLE = 200
EPG_MAX_PER_CHANNEL = 400
EPG_DEFAULT_DURATION = 3600       # for a programme without a stop and no successor
# One record per programme, 'SSSSSSSSSS EEEEEEEEEE "title"' (fixed-width
# epochs, JSON-encoded title), joined by DEL. The fixed prefix lets bisect and
# plain string comparison find now/next, and the pre-encoded title lets the
# recompute emit epg-now.json by concatenation (no per-channel encoder work).
EPG_RECORD_SEP = "\x7f"

MPV_DEFAULT_USER_AGENT = "libmpv"   # mpv 0.41 `--list-options` default, used when option-info is unavailable
# mpv property-expands the `title` option ("${path}" would render the stream
# URL, credentials included, in the window title; S-01). "$>" disables
# expansion for the rest of the string (verified on mpv 0.41 via expand-text).
# `force-media-title` is not expanded (verified) and stays raw so media-title
# and the OSC show the plain name. Mirrors Model.MPV_RAW_PREFIX.
MPV_RAW_PREFIX = "$>"

_HEADER_NAME = re.compile(r"^[A-Za-z0-9-]+$")
_SAFE_OPTION = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.\-]*$")   # never option-looking (D-QA-09)
# Combining Diacritical Marks (U+0300-U+036F) after an ASCII letter, i.e. a
# decomposed Latin accent. Marks on other scripts stay (Cyrillic breve in
# "\u0439" must not fold to "\u0438").
_LATIN_MARKS = re.compile("([a-z])[\u0300-\u036f]+")
_URL_ANYWHERE = re.compile(r"\b([A-Za-z][A-Za-z0-9+.\-]*)://[^\s'\"<>]+")
_LEADING_DASHES = re.compile(r"^[\s\-]+")
# make_channel's last-resort display name, and the pattern that recognises one
# after normalize_text. Built from the same constant so the two cannot drift:
# engineering rule 13 (dev branch), two things joined by a name rather than by a call.
GENERATED_NAME_WORD = "Channel"
GENERATED_NAME_FORMAT = GENERATED_NAME_WORD + " %d"
_GENERATED_NAME = re.compile(r"^" + GENERATED_NAME_WORD.lower() + r" [0-9]+$")
_CONTROL_WS = re.compile(r"[\s\x00-\x1f\x7f]+")
# Mirrors Model.sanitizeInput: C0 controls, DEL and C1 controls are dropped.
_CONTROL_CHARS = re.compile("[\x00-\x1f\x7f-\x9f]")
_SCHEME_RE = re.compile(r"^([A-Za-z][A-Za-z0-9+.\-]*):(.*)$", re.S)
# Model.validateSourceUrl's scheme match ([\s\S]* there): a line separator
# after the scheme is caught by the whitespace rule (`invalid`, D-SRC-06),
# never read as a missing scheme.
_SOURCE_SCHEME_RE = re.compile(r"^([A-Za-z][A-Za-z0-9+.\-]*):(.*)$", re.S)
_AUTHORITY_END = re.compile(r"[/?#]")
_BARE_HOST_CHARS = re.compile(r"[:\[\]]")
_ASCII_DIGITS = re.compile(r"^[0-9]+$")
_ZERO_WIDTH = re.compile("[\u200b-\u200d\u2060\ufeff]")
_IPV6_LITERAL = re.compile(r"^\[[0-9A-Fa-f:.]*:[0-9A-Fa-f:.]*(?:%25[A-Za-z0-9._~\-]+)?\]$")
_URL_SPACE = re.compile("[\\s\ufeff]")          # JS \s includes U+FEFF, Python's does not
_BAD_ESCAPE = re.compile(r"%(?![0-9A-Fa-f]{2})")
_XMLTV_TIME = re.compile(r"^(\d{4})(\d{2})(\d{2})(\d{2})?(\d{2})?(\d{2})?\s*(?:([+-])(\d{2})(\d{2})|Z)?$")


class HelperError(Exception):
    """A user-facing failure. `code` is stable (UI may switch on it)."""

    def __init__(self, code: str, message: str, **extra: Any) -> None:
        super().__init__(message)
        self.code = code
        self.message = message
        self.extra = extra


# ----------------------------------------------------------------- paths

def home_dir() -> str:
    return os.path.expanduser("~")


def cache_dir(explicit: str | None = None) -> str:
    if explicit:
        return os.path.abspath(os.path.expanduser(explicit))
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(home_dir(), ".cache")
    return os.path.join(base, "omarchy-iptv")


def state_dir(explicit: str | None = None) -> str:
    if explicit:
        return os.path.abspath(os.path.expanduser(explicit))
    base = os.environ.get("XDG_STATE_HOME") or os.path.join(home_dir(), ".local", "state")
    return os.path.join(base, "omarchy-iptv")


def runtime_dir() -> str:
    base = os.environ.get("XDG_RUNTIME_DIR") or cache_dir()
    return os.path.join(base, "omarchy-iptv")


def default_socket_path() -> str:
    return os.path.join(runtime_dir(), "mpv.sock")


def socket_path(explicit: str | None = None) -> str:
    if explicit:
        return os.path.abspath(os.path.expanduser(explicit))
    return default_socket_path()


def ensure_private_dir(path: str) -> None:
    """mkdir -p with every directory this call creates set to 0700 (the
    per-source layout means the helper may be the first to create
    <cache-dir>/sources/, which must be private like its children)."""
    missing: list[str] = []
    current = path
    while current and not os.path.isdir(current):
        missing.append(current)
        parent = os.path.dirname(current)
        if parent == current:
            break
        current = parent
    for directory in reversed(missing):
        try:
            os.mkdir(directory, 0o700)
        except FileExistsError:
            continue
        try:
            os.chmod(directory, 0o700)
        except OSError:
            pass
    try:
        os.chmod(path, 0o700)
    except OSError:
        pass


# ------------------------------------------------------------- redaction

def url_host(url: str) -> str:
    """Host name of a URL, never the userinfo, path or query."""
    try:
        return urllib.parse.urlsplit(url).hostname or ""
    except ValueError:
        return ""


def source_host(url: str) -> str:
    try:
        parts = urllib.parse.urlsplit(url)
    except ValueError:
        return ""
    if parts.scheme in ("http", "https"):
        return parts.hostname or ""
    return "local file"


def redact_urls(text: Any) -> str:
    """Replace every URL inside `text` with scheme://host (R12)."""

    def replace(match: re.Match[str]) -> str:
        raw = match.group(0)
        trailing = ""
        while raw and raw[-1] in ".,;:!?)]":
            trailing = raw[-1] + trailing
            raw = raw[:-1]
        host = url_host(raw)
        return "%s://%s%s" % (match.group(1).lower(), host or "[redacted]", trailing)

    return _URL_ANYWHERE.sub(replace, "" if text is None else str(text))


def log(message: str) -> None:
    sys.stderr.write("omarchy-iptv: %s\n" % redact_urls(message))


# ------------------------------------------------------- normalization
# Must match Model.js normalizeText/searchKey/fnv1a32 byte for byte.

FOLD_GROUPS = [
    ("\u00e0\u00e1\u00e2\u00e3\u00e4\u00e5\u0101\u0103\u0105", "a"),
    ("\u00e7\u0107\u010d", "c"),
    ("\u010f\u0111", "d"),
    ("\u00e8\u00e9\u00ea\u00eb\u0113\u0117\u0119\u011b", "e"),
    ("\u00ec\u00ed\u00ee\u00ef\u012b\u0131", "i"),
    ("\u0142\u013e", "l"),
    ("\u00f1\u0144\u0148", "n"),
    ("\u00f2\u00f3\u00f4\u00f5\u00f6\u00f8\u014d\u0151", "o"),
    ("\u0159", "r"),
    ("\u015b\u0161\u015f", "s"),
    ("\u0165\u0163", "t"),
    ("\u00f9\u00fa\u00fb\u00fc\u016b\u016f\u0171", "u"),
    ("\u00fd\u00ff", "y"),
    ("\u017a\u017c\u017e", "z"),
    ("\u00df", "ss"),
    ("\u00e6", "ae"),
    ("\u0153", "oe"),
]
FOLD = {ch: to for chars, to in FOLD_GROUPS for ch in chars}
_PUNCT = re.compile(r"[\s!-/:-@\[-`{-~]+")
# The same class WITHOUT `*` (U+002A) and `+` (U+002B), for the id fold only.
# Folding is two jobs, not one. SEARCH wants punctuation gone -- a user typing
# "amc" must reach "USA: AMC+" -- so _PUNCT and search_key stay exactly as they
# are. An ID wants every character that tells two streams apart, and over the
# user's four real playlists `+` and `*` are the two that do: dropping them
# merges "USA  AMC" with "USA: AMC+", "US: ESPN" with "US: ESPN*", "US NESN
# (A)" with "US NESN+ (A)" and four Fanduel regional pairs. Measured, keeping
# them takes the four lists from 75 colliding name groups / 155 rows to 65 /
# 133 and raises surviving ids from 5,108 to 5,127 of 5,221. `&`, `#` and `@`
# were measured the same way and change nothing on any of the four, so they
# are not in the class. Mirrors ID_PUNCT_RE in Model.js.
_ID_PUNCT = re.compile(r"[\s!-)\,-/:-@\[-`{-~]+")


def normalize_text(value: Any) -> str:
    """Lower-case, fold Latin diacritics (precomposed via FOLD, decomposed via
    NFD + dropping U+0300-U+036F after an ASCII letter, then NFC so every
    other script recomposes), ASCII punctuation to one space (D-QA-08).
    Mirrors Model.js decompose()/normalizeText byte for byte (NFD, not NFKD)."""
    return fold_text(value, _PUNCT)


def normalize_id_text(value: Any) -> str:
    """The id fold (mirror: Model.normalizeIdText). Identical to
    normalize_text except that `+` and `*` survive, because they are the
    difference between two channels rather than noise inside one. Never use
    it for search."""
    return fold_text(value, _ID_PUNCT)


def fold_text(value: Any, punct: "re.Pattern[str]") -> str:
    text = ("" if value is None else str(value)).lower()
    if not text.isascii():
        import unicodedata
        text = unicodedata.normalize("NFC", _LATIN_MARKS.sub(r"\1", unicodedata.normalize("NFD", text)))
    folded = "".join(FOLD.get(ch, ch) for ch in text)
    return punct.sub(" ", folded).strip(" ")


def search_key(name: Any, group: Any) -> str:
    key = normalize_text(name)
    grp = normalize_text(group)
    if grp:
        key = grp if not key else key + " " + grp
    return key


def fnv1a32(value: Any) -> str:
    text = "" if value is None else str(value)
    hash_ = 0x811C9DC5
    for byte in text.encode("utf-8"):
        hash_ ^= byte
        hash_ = (hash_ * 0x01000193) & 0xFFFFFFFF
    return "%08x" % hash_


# -------------------------------------------------------------- sources
# Python mirror of Model.sanitizeInput / validateSourceUrl / sourceKey /
# deriveLabel (ARCHITECTURE-SOURCES.md section 3, codes per UX-SOURCES.md
# 5.4 as ruled by SR6). Both sides run the source-urls.json. fixture (dev branch)

def utf16_length(text: str) -> int:
    """Length in UTF-16 code units, the unit JS strings and caps use."""
    return len(text) + sum(1 for ch in text if ord(ch) > 0xFFFF)


def truncate_utf16(text: str, limit: int) -> str:
    if utf16_length(text) <= limit:
        return text
    out: list[str] = []
    used = 0
    for ch in text:
        width = 2 if ord(ch) > 0xFFFF else 1
        if used + width > limit:
            break
        out.append(ch)
        used += width
    return "".join(out)


def sanitize_input(value: Any, limit: int) -> str:
    """Model.sanitizeInput: one leading byte-order mark (a paste artefact,
    SR15) dropped, control characters (CR, LF, TAB included) removed, ASCII
    space and NBSP trimmed, capped at `limit` UTF-16 units. Applied at every
    field boundary and again inside validate_source_url."""
    text = "" if value is None else str(value)
    if text.startswith("\ufeff"):
        text = text[1:]
    text = _CONTROL_CHARS.sub("", text)
    return truncate_utf16(text.strip(" \u00a0"), limit)


def cap_code_points(text: str, limit: int) -> str:
    """Model.capCodePoints: the label cap counts Unicode code points, not
    UTF-16 units (SR22: JS [...s].length, Python len)."""
    return text[:limit]


def _validation(ok: bool, code: str, message: str, kind: str = "", url: str = "", host: str = "") -> dict[str, Any]:
    return {"ok": ok, "code": code, "message": message, "kind": kind, "url": url, "host": host}


def _validate_path(path: str) -> dict[str, Any]:
    for prefix in UNSAFE_PATH_PREFIXES:
        if path == prefix or path.startswith(prefix + "/"):
            return _validation(False, "unsafe_path", "paths under /proc, /sys and /dev are not allowed")
    return _validation(True, "ok", "", "file", path, "")


def looks_like_host(text: str) -> bool:
    """SR12: a "." or ":" before the first "/" reads as a host."""
    return re.search(r"[.:]", text.split("/", 1)[0]) is not None


def validate_source_url(text: Any, origin: str = "form") -> dict[str, Any]:
    """Mirror of Model.validateSourceUrl(text, {origin}) -> {ok, code,
    message, kind, url, host}; `url` is the normalized form (the source
    identity): scheme and host lower-cased, numeric port normalized (leading
    zeros stripped, the scheme default dropped), empty path `/`, query
    verbatim, fragment dropped, userinfo kept. Codes: empty, too_long,
    scheme, invalid, relative_path, unsafe_path (UX-SOURCES.md 5.4, SR6).
    `origin` "cli" accepts `~` paths verbatim (SR11; expanded by the reader),
    the forms refuse them. The authority refuses backslashes, zero-width
    characters, ports above 65535 and bracket literals that are not IPv6
    (SR15). Messages never contain a URL."""
    cli = origin == "cli"
    value = sanitize_input(text, MAX_SOURCE_URL + 1)
    if value == "":
        return _validation(False, "empty", "no source URL or path given")
    if utf16_length(value) > MAX_SOURCE_URL:
        return _validation(False, "too_long", "source URL longer than %d characters" % MAX_SOURCE_URL)
    if value.startswith("//"):
        return _validation(False, "scheme", "scheme-relative URLs are not supported (use http or https)")
    if value.startswith("/"):
        return _validate_path(value)
    if value.startswith("~"):
        if cli:
            return _validation(True, "ok", "", "file", value, "")
        return _validation(False, "relative_path", "use an absolute path (starts with /, not ~)")
    if value in (".", "..") or value.startswith("./") or value.startswith("../"):
        return _validation(False, "relative_path", "use an absolute path (starts with /)")
    match = _SOURCE_SCHEME_RE.match(value)
    if not match:
        if looks_like_host(value):
            return _validation(False, "scheme", "use http, https, file or an absolute path")
        return _validation(False, "relative_path", "use an absolute path (starts with /)")
    scheme = match.group(1).lower()
    rest = match.group(2)
    if scheme == "file":
        if not rest.startswith("//"):
            return _validation(False, "invalid", "file URL is missing the two slashes after the scheme")
        after = re.sub(r"[?#].*$", "", rest[2:], flags=re.S)
        slash = after.find("/")
        if slash == -1:
            return _validation(False, "invalid", "file URL has no path")
        path = after[slash:]
        if _BAD_ESCAPE.search(path):
            return _validation(False, "invalid", "file URL has a malformed percent escape")
        try:
            path = urllib.parse.unquote(path, errors="strict")
        except UnicodeDecodeError:
            return _validation(False, "invalid", "file URL path is not valid UTF-8")
        if not path.startswith("/"):
            return _validation(False, "invalid", "file URL path is not absolute")
        return _validate_path(path)
    if scheme not in ("http", "https"):
        return _validation(False, "scheme", "unsupported source scheme '%s' (use http, https or an absolute path)" % scheme)
    if not rest.startswith("//"):
        return _validation(False, "invalid", "URL is missing the two slashes after the scheme")
    if _URL_SPACE.search(rest):
        return _validation(False, "invalid", "URL contains whitespace")
    body = rest[2:]
    cut = _AUTHORITY_END.search(body)
    authority = body if cut is None else body[:cut.start()]
    tail = "" if cut is None else body[cut.start():]
    if "\\" in authority or _ZERO_WIDTH.search(authority):
        return _validation(False, "invalid", "URL host contains an invalid character")
    at = authority.rfind("@")
    userinfo = authority[:at] if at != -1 else ""
    hostport = authority[at + 1:] if at != -1 else authority
    port = ""
    if hostport.startswith("["):
        close = hostport.find("]")
        if close == -1:
            return _validation(False, "invalid", "unterminated IPv6 literal")
        host = hostport[:close + 1]
        if not _IPV6_LITERAL.match(host):
            return _validation(False, "invalid", "bracket literal is not an IPv6 address")
        after_host = hostport[close + 1:]
        if after_host:
            if not after_host.startswith(":"):
                return _validation(False, "invalid", "unexpected text after the IPv6 literal")
            port = after_host[1:]
    else:
        colon = hostport.rfind(":")
        host, port = (hostport[:colon], hostport[colon + 1:]) if colon != -1 else (hostport, "")
        if _BARE_HOST_CHARS.search(host):
            return _validation(False, "invalid", "URL host contains an invalid character")
    if host == "":
        return _validation(False, "invalid", "URL has no host name")
    host = host.lower()
    if port != "":
        if not _ASCII_DIGITS.match(port):
            return _validation(False, "invalid", "URL port is not a number")
        port = port.lstrip("0") or "0"
        if int(port) > 65535:
            return _validation(False, "invalid", "URL port is above 65535")
    if port == ("80" if scheme == "http" else "443"):
        port = ""
    hash_at = tail.find("#")
    if hash_at != -1:
        tail = tail[:hash_at]
    query_at = tail.find("?")
    path = tail if query_at == -1 else tail[:query_at]
    query = "" if query_at == -1 else tail[query_at + 1:]
    if path == "":
        path = "/"
    url = "%s://%s%s%s%s%s" % (scheme, userinfo + "@" if userinfo else "", host, ":" + port if port else "", path, "?" + query if query else "")
    return _validation(True, "ok", "", "http", url, host)


def source_cache_key(url: str) -> str:
    """Cache directory name of a normalized playlist URL (Model.sourceKey)."""
    return fnv1a32(url)


def find_source(sources: list[dict[str, Any]], key: str) -> dict[str, Any] | None:
    for record in sources:
        if record.get("key") == key:
            return record
    return None


def find_source_by_url(sources: list[dict[str, Any]], url: str) -> dict[str, Any] | None:
    for record in sources:
        if record.get("url") == url:
            return record
    return None


def allocate_source_key(sources: list[dict[str, Any]], url: str) -> str:
    """The record's key when the URL is known, else fnv1a32 with a "-2",
    "-3", ... suffix while another record already uses that key."""
    existing = find_source_by_url(sources, url)
    if existing is not None:
        return str(existing["key"])
    base = source_cache_key(url)
    key = base
    suffix = 2
    while find_source(sources, key) is not None:
        key = "%s-%d" % (base, suffix)
        suffix += 1
    return key


def host_port_of(url: str) -> str:
    """Model.hostPortOf: host[:port] of a URL, lower-cased; "" for paths."""
    match = re.match(r"^[A-Za-z][A-Za-z0-9+.\-]*://(?:[^@/?#]*@)?([^/?#]+)", url)
    return match.group(1).lower() if match else ""


def derive_label(url: str, kind: str) -> str:
    """Model.deriveLabel (UX-SOURCES.md 5.6): host (lower-case, leading www.
    removed, :port kept when it is not the default) for http(s); the file
    name for paths; capped at MAX_LABEL code points (SR19, SR20, SR22)."""
    text = "" if url is None else str(url)
    checked = validate_source_url(text, origin="cli")
    if kind == "file" or checked["kind"] == "file":
        source = checked["url"] if checked["ok"] else text
        name = source.rstrip("/").rsplit("/", 1)[-1]
        return cap_code_points(sanitize_input(name, MAX_SOURCE_URL), MAX_LABEL) or "local file"
    hostport = host_port_of(checked["url"] if checked["ok"] else text)
    if hostport == "":
        return cap_code_points(sanitize_input(text, MAX_SOURCE_URL), MAX_LABEL)
    if hostport.startswith("www."):
        hostport = hostport[4:]
    return cap_code_points(sanitize_input(hostport, MAX_SOURCE_URL), MAX_LABEL)


def label_key(text: Any) -> str:
    """Model.labelKey: the case-insensitive comparison form (SR21)."""
    return sanitize_input(text, MAX_SOURCE_URL).lower()


def unique_label(label: str, existing: list[str]) -> str:
    """Model.uniqueLabel: " 2", " 3", ... appended while `label` is taken by
    another source (case-insensitive, SR21); the cap counts code points
    (SR22). Derived labels only; a typed label is refused instead."""
    taken = {label_key(item) for item in existing}
    base = cap_code_points(sanitize_input(label, MAX_SOURCE_URL), MAX_LABEL) or "source"
    if base.lower() not in taken:
        return base
    for suffix in range(2, 1000):
        tail = " %d" % suffix
        candidate = cap_code_points(base, MAX_LABEL - len(tail)) + tail
        if candidate.lower() not in taken:
            return candidate
    return base


_ATTR_QUOTED = re.compile(r'\s*([A-Za-z0-9_.\-]+)="([^"]*)"')
_ATTR_BARE = re.compile(r'\s*([A-Za-z0-9_.\-]+)=([^\s,"]+)')

# Channel-number attributes, in precedence order (M2-03 1.1, ruling CN11).
# `tvg-chno` is what every asset in this repo uses; the two aliases are read
# because a playlist that HAS numbers and silently shows none is the worst
# failure this feature can have, and there is no error for the user to search
# for. Keys arrive lower-cased from parse_attrs, so the match is
# case-insensitive, and both the quoted and the bare form are already handled.
CHNO_ATTRS = ("tvg-chno", "tvg-channel-number", "channel-number")


def parse_attrs(text: str) -> tuple[dict[str, str], str]:
    """Parse `key="value" key2=value ...` from the start of `text`.

    Returns (attrs, remainder). Attribute values may contain commas; the
    remainder starts at the first character that is not an attribute.
    Keys are lower-cased; when a key repeats, the last non-empty value wins.
    """
    attrs: dict[str, str] = {}
    pos = 0
    while pos < len(text):
        match = _ATTR_QUOTED.match(text, pos) or _ATTR_BARE.match(text, pos)
        if not match:
            break
        key = match.group(1).lower()
        value = match.group(2).strip()
        if value or key not in attrs:
            attrs[key] = value
        pos = match.end()
    return attrs, text[pos:]


def parse_extinf(line: str) -> tuple[dict[str, str], str]:
    """#EXTINF:<duration> [attrs],<title> -> (attrs, title).

    The comma is optional: `#EXTINF:-1 tvg-id="x" Name` yields title "Name".
    """
    body = line[len("#EXTINF:"):]
    match = re.match(r"\s*(-?\d+(?:\.\d+)?)?", body)
    body = body[match.end():] if match else body
    attrs, rest = parse_attrs(body)
    rest = rest.lstrip()
    if rest.startswith(","):
        rest = rest[1:]
    return attrs, rest.strip()


def stream_scheme(url: str) -> str:
    try:
        return urllib.parse.urlsplit(url).scheme.lower()
    except ValueError:
        return ""


def is_stream_url(url: str) -> bool:
    """Allow-listed scheme with a non-empty host; never option-looking (D-QA-07)."""
    if url.startswith("-"):
        return False
    try:
        parts = urllib.parse.urlsplit(url)
    except ValueError:
        return False
    return parts.scheme.lower() in STREAM_SCHEMES and bool(parts.hostname)


def clean_header_value(value: str) -> str:
    return value.replace("\r", " ").replace("\n", " ").strip()


def split_groups(value: str) -> list[str]:
    """`A;B;C` -> ["A", "B", "C"] (trimmed, empties and repeats dropped)."""
    groups: list[str] = []
    for part in value.split(";"):
        name = part.strip()
        if name and name not in groups:
            groups.append(name)
    return groups


def channel_number(attrs: dict[str, str]) -> str:
    """The first non-empty channel-number attribute, whitespace-trimmed.

    Normalization stops here, deliberately (M2-03 1.1-1.2): which ATTRIBUTE
    carries the number and what an empty one means is the helper's business,
    what the number MEANS is Model.parseChno's. So the value is stored
    verbatim after `.strip()` - leading zeros, `.` / `-` subchannel
    separators, `N/A` and everything else reach channels.json as written,
    and one implementation decides that 007 is channel 7 (rule: one rule,
    one place). Returns "" when no attribute carries one, and the caller
    omits the key entirely so a reader can tell "no number" from "empty".
    """
    for key in CHNO_ATTRS:
        value = attrs.get(key, "").strip()
        if value:
            return value
    return ""


def clean_name(value: str) -> str:
    """Display-name candidate: never starts with "-" (S-04). The name is an
    argv item for omarchy-notification-send, where "--urgency=x did not play"
    would be parsed as an option. Mirrors Model.cleanName."""
    return _LEADING_DASHES.sub("", value or "").strip()


def make_channel(attrs: dict[str, str], title: str, url: str, extgrp: str,
                 vlcopt: dict[str, str], kodiprop: dict[str, str],
                 warnings: list[str], index: int = 1) -> dict[str, Any]:
    tvg_id = attrs.get("tvg-id", "").strip()
    tvg_name = attrs.get("tvg-name", "").strip()
    # Never fall back to the URL: the name is rendered everywhere (R12, D-QA-02).
    name = clean_name(title) or clean_name(tvg_name) or clean_name(tvg_id) or GENERATED_NAME_FORMAT % index
    group_text = attrs.get("group-title", "").strip() or extgrp
    groups = split_groups(group_text) if group_text else []
    # Ruling R5: multi-group entries list under the FIRST group; the whole
    # group string stays searchable through searchKey and `groups`.
    group = groups[0] if groups else UNGROUPED
    channel: dict[str, Any] = {
        "id": "",
        "name": name,
        "group": group,
        "url": url,
    }
    if len(groups) > 1:
        channel["groups"] = groups
    if tvg_id:
        channel["tvgId"] = tvg_id
    if tvg_name and tvg_name != name:
        channel["tvgName"] = tvg_name
    logo = attrs.get("tvg-logo", "").strip()
    if logo and stream_scheme(logo) in ("http", "https"):
        channel["logo"] = logo
    chno = channel_number(attrs)
    if chno:
        channel["chno"] = chno

    headers: dict[str, str] = {}
    options: dict[str, str] = {}
    for key, value in vlcopt.items():
        cleaned = clean_header_value(value)
        if key == "http-user-agent":
            if cleaned:
                headers["User-Agent"] = cleaned
        elif key == "http-referrer":
            if cleaned:
                headers["Referer"] = cleaned
        elif _SAFE_OPTION.match(key):
            options["vlc:" + key] = value
        else:
            warnings.append("dropped option-looking key for %s" % name)
    for key, value in kodiprop.items():
        if key in ("inputstream.adaptive.stream_headers", "inputstream.adaptive.manifest_headers"):
            for hname, hvalue in urllib.parse.parse_qsl(value, keep_blank_values=False):
                cleaned = clean_header_value(hvalue)
                if not _HEADER_NAME.match(hname):
                    warnings.append("dropped header with unsafe name for %s" % name)
                elif cleaned:
                    headers[hname] = cleaned
        elif _SAFE_OPTION.match(key):
            options["kodi:" + key] = value
        else:
            warnings.append("dropped option-looking key for %s" % name)
    if headers:
        channel["headers"] = headers
    if options:
        channel["options"] = options
    channel["searchKey"] = search_key(name, " ".join(groups) if groups else group)
    # F-PERF-1. `searchKey` has been precomputed since M0 precisely so the
    # guide's filter does not fold 10,000 strings on every keystroke. The
    # ranker needs a SECOND fold -- the name alone, to rank a name match above
    # a group match -- and that one was never added, so `filterChannels` fell
    # back to folding it per channel per call. Measured over 10,000 channels:
    # 28.05 ms for the query "a" against a 30 ms keystroke budget, of which
    # the ranker itself is 2.9 ms; with this key present the same call is
    # 5.11 ms, and a query matching nothing goes from 22.31 to 1.07.
    #
    # An older cache without this key still works -- the reader keeps its
    # fallback -- so there is no migration, only a slower guide until the next
    # refresh writes one.
    channel["nameKey"] = normalize_text(name)
    return channel


def parse_m3u(text: str) -> dict[str, Any]:
    """Tolerant M3U/M3U8 parser.

    Understands #EXTM3U (url-tvg / x-tvg-url hint), #EXTINF with quoted or
    bare attributes and a title that may contain commas (comma optional),
    #EXTGRP (persists until the next #EXTGRP, like VLC; group-title wins),
    #EXTVLCOPT and #KODIPROP (apply to the next URL line only). Unknown
    comments are ignored. Accepts a BOM, CRLF and blank lines. Location
    lines outside STREAM_SCHEMES (bare paths, option-looking lines, free
    text, URLs without a host) are skipped and counted; an #EXTINF that is
    followed by another #EXTINF is counted as having no URL. Output is
    bounded by MAX_CHANNELS and MAX_GROUPS (S-07); a channel moved to
    UNGROUPED keeps its provider group in `groups` and `searchKey`.
    """
    channels: list[dict[str, Any]] = []
    warnings: list[str] = []
    pending: tuple[dict[str, str], str] | None = None
    extgrp = ""
    vlcopt: dict[str, str] = {}
    kodiprop: dict[str, str] = {}
    epg_hint = ""
    skipped_scheme = 0
    skipped_orphan = 0
    skipped_no_url = 0
    over_cap = 0
    regrouped = 0
    seen_groups: set[str] = set()
    is_playlist = False

    if text.startswith("\ufeff"):
        text = text[1:]

    for raw in text.split("\n"):
        line = raw.strip()
        if not line:
            continue
        if line.startswith("#EXTM3U"):
            is_playlist = True
            attrs, _ = parse_attrs(line[len("#EXTM3U"):])
            epg_hint = attrs.get("url-tvg") or attrs.get("x-tvg-url") or epg_hint
            continue
        if line.startswith("#EXTINF:"):
            is_playlist = True
            if pending is not None:
                skipped_no_url += 1
            pending = parse_extinf(line)
            continue
        if line.startswith("#EXTGRP:"):
            extgrp = line[len("#EXTGRP:"):].strip()
            continue
        if line.startswith("#EXTVLCOPT:"):
            key, _, value = line[len("#EXTVLCOPT:"):].partition("=")
            vlcopt[key.strip().lower()] = value.strip()
            continue
        if line.startswith("#KODIPROP:"):
            key, _, value = line[len("#KODIPROP:"):].partition("=")
            kodiprop[key.strip().lower()] = value.strip()
            continue
        if line.startswith("#"):
            continue
        # Any other line is the pending entry's location (VLC semantics), even
        # a bare path or free text: those fail the allow-list and are counted.
        if pending is None:
            skipped_orphan += 1
            vlcopt, kodiprop = {}, {}
            continue
        url = line
        if not is_stream_url(url):
            skipped_scheme += 1
        elif len(channels) >= MAX_CHANNELS:
            over_cap += 1
        else:
            attrs, title = pending
            channel = make_channel(attrs, title, url, extgrp, vlcopt, kodiprop, warnings, len(channels) + 1)
            group = channel["group"]
            if group not in seen_groups:
                if len(seen_groups) >= MAX_GROUPS and group != UNGROUPED:
                    channel["group"] = group = UNGROUPED
                    regrouped += 1
                seen_groups.add(group)
            channels.append(channel)
        pending = None
        vlcopt, kodiprop = {}, {}

    if pending is not None:
        skipped_no_url += 1
    if skipped_scheme:
        warnings.append("%d entries skipped: unsupported URL scheme" % skipped_scheme)
    if skipped_orphan:
        warnings.append("%d URL lines without #EXTINF skipped" % skipped_orphan)
    if skipped_no_url:
        warnings.append("%d #EXTINF entries without a URL skipped" % skipped_no_url)
    if over_cap:
        warnings.append("truncated to %d channels (%d entries skipped)" % (MAX_CHANNELS, over_cap))
    if regrouped:
        warnings.append("group count capped at %d; %d channels listed under %s" % (MAX_GROUPS, regrouped, UNGROUPED))
    assign_ids(channels)
    return {"channels": channels, "warnings": warnings, "epgUrlHint": epg_hint, "isPlaylist": is_playlist}


def name_id_key(name: Any) -> str:
    """The `n:` base of a channel name, or "" when the name cannot key one.

    Mirrors Model.nameIdKey. The name is normalized through the shared
    normalize_text, so re-casing or re-punctuating a title does not move the
    id. A name that normalizes to nothing cannot key anything, and neither can
    make_channel's last-resort `Channel <n>`: that n is the row's POSITION in
    the file, so keying on it would move the id whenever the provider inserts
    a row above -- worse than the URL hash it would replace.
    """
    norm = normalize_id_text(name)
    if norm == "" or _GENERATED_NAME.match(norm):
        return ""
    return "n:" + fnv1a32(norm)


def suffix_ids(bases: list[str]) -> list[str]:
    """`#2`, `#3`... on a repeated base so every row stays addressable."""
    seen: dict[str, int] = {}
    out: list[str] = []
    for base in bases:
        count = seen.get(base, 0) + 1
        seen[base] = count
        out.append(base if count == 1 else "%s#%d" % (base, count))
    return out


def channel_ids(channels: list[dict[str, Any]], scheme: int = CHANNEL_ID_SCHEME) -> list[str]:
    """Every channel's id, in playlist order (mirror: Model.channelIds).

    Scheme 1: `t:<tvg-id>` when that tvg-id is unique in the playlist, else
    `u:<fnv1a32(url)>`, with `#2`, `#3`... on a repeat.

    Scheme 2 is scheme 1 with ONE substitution: a row that would fall back to
    the URL hash uses `n:<fnv1a32(normalize_text(name))>` instead, and only
    when that name key is unique across the whole playlist. Every other row
    keeps the exact id it already had.

    Doing it as a substitution rather than as a third branch of the base rule
    is what makes the upgrade safe, and it took a failing test to find that
    out. Recompute the suffixes over the new stream instead and a list with
    two rows on one URL re-uses one row's OLD id for the OTHER row -- the
    saved favorite still resolves, silently, to a different channel, which is
    the exact failure this change exists to stop. As a substitution, a
    scheme-2 id is either the row's own scheme-1 id or an `n:` id that has
    never existed before, so no id can ever change meaning.

    The uniqueness test on the name is the other half. A name two rows share
    cannot tell them apart, so an HD/SD twin pair or two feeds of one channel
    keep their URL ids rather than being merged into one favorite. The test
    runs on the HASHED key, so an fnv1a32 collision between two different
    names is handled by the same rule: both sides keep their URL ids.

    Names are counted over EVERY channel, including the ones that take a `t:`
    id. Counting only the rest buys 33 more surviving ids on the user's
    1,833-channel sports list (99.1 per cent against 97.3) at the price of
    coupling the name column to the tvg-id column: a tvg-id appearing or
    ceasing to be unique would then move a DIFFERENT row's id. The name pool
    is kept independent of anything but names.

    ACCEPTED LIMIT, UNRESOLVED AND NOT DESIGNED AROUND (D-ID-1). The
    uniqueness test above is answered from ONE snapshot of the playlist, and
    uniqueness is a property that only exists ACROSS snapshots. When two rows
    share a name today the test refuses both, which looks safe and is only a
    DEFERRAL: the day the provider drops one member of the pair, the survivor
    is suddenly unique, takes the `n:` key, and inherits any favorite that
    meant the row which went away. That is a silent WRONG channel, which is
    worse than the silent loss this whole change exists to stop -- the same
    failure mode that made scheme 2 a substitution rather than a third branch,
    reappearing on a longer timescale.

    Measured with name_id_key over the user's four real lists:

      USChannels.m3u     3,335 rows, 26 colliding name groups,  55 rows, largest 3
      SportsPPVAll.m3u   1,833 rows, 39 colliding name groups,  78 rows, largest 2
      Kids.m3u              48 rows,  0
      Default.m3u            5 rows,  0

    So at most 133 rows of 5,221 are exposed, and only if a provider removes a
    member of a colliding pair while the user holds a reference to it. Nobody
    has a second snapshot of these lists over time, so the rate is UNKNOWN,
    not small: the number above bounds how many rows could be affected, not
    how often it happens.

    What would settle it: keep the previous playlist's name pool in the cache
    and refuse to hand a freed `n:` key to a survivor -- a key that was ever
    shared stays burned. That needs a second snapshot to design against and a
    cache field this version does not have, so it is recorded here rather than
    guessed at. Until then the exposure is accepted, measured and named.
    """
    legacy = legacy_channel_ids(channels)
    return legacy if scheme < CHANNEL_ID_SCHEME else substitute_name_ids(channels, legacy)


def legacy_channel_ids(channels: list[dict[str, Any]]) -> list[str]:
    """Scheme 1, and the base every scheme-2 id is built from."""
    tvg_counts: dict[str, int] = {}
    for channel in channels:
        tvg = channel.get("tvgId", "")
        if tvg:
            tvg_counts[tvg] = tvg_counts.get(tvg, 0) + 1
    return suffix_ids([
        "t:" + channel.get("tvgId", "") if channel.get("tvgId") and tvg_counts[channel["tvgId"]] == 1
        else "u:" + fnv1a32(channel.get("url", ""))
        for channel in channels
    ])


def substitute_name_ids(channels: list[dict[str, Any]], legacy: list[str]) -> list[str]:
    """The one substitution scheme 2 makes on top of scheme 1. Separate from
    channel_ids so channel_id_remap can hash every URL once instead of twice:
    measured on the user's 3,335-channel list that is 80 ms against 123 ms,
    and the helper's budget is 10,000 channels parsed in under a second."""
    name_keys = [name_id_key(channel.get("name", "")) for channel in channels]
    name_counts: dict[str, int] = {}
    for key in name_keys:
        if key:
            name_counts[key] = name_counts.get(key, 0) + 1
    return [
        name_keys[index] if legacy[index].startswith("u:") and name_keys[index] and name_counts[name_keys[index]] == 1
        else legacy[index]
        for index in range(len(legacy))
    ]


def assign_ids(channels: list[dict[str, Any]], scheme: int = CHANNEL_ID_SCHEME) -> None:
    """Stable ids per ARCHITECTURE.md decision 6, written onto the channels."""
    for channel, value in zip(channels, channel_ids(channels, scheme)):
        channel["id"] = value


def channel_id_remap(channels: list[dict[str, Any]]) -> dict[str, str]:
    """{scheme-1 id: scheme-2 id} for the rows the scheme change moves.

    Computable from any channel list whose URLs have not rotated yet, which is
    the ordinary upgrade: the fix lands, then some day the password changes.

    Idempotent with no marker anywhere in state.json, and no schema change of
    any kind. Because scheme 2 is a substitution (channel_ids), every key of
    this map is the scheme-1 id of a row that now answers to an `n:` id, and
    an `n:` id is never a key. So after one pass nothing in the state holds a
    key and a second pass moves nothing. `test_no_key_is_also_a_new_id` pins
    that invariant: it is what makes the whole upgrade safe, so it is checked
    rather than asserted in prose.
    """
    old = legacy_channel_ids(channels)
    new = substitute_name_ids(channels, old)
    return {before: after for before, after in zip(old, new) if before != after}


def remap_state_ids(state: dict[str, Any], remap: dict[str, str]) -> int:
    """Move every channel reference state.json persists (Model.remapStateIds).

    Returns the number of references moved. Favorites keep their order and one
    that lands on a favorite already in the list is merged rather than
    duplicated -- which is possible, because favorites are global across
    sources (ARCHITECTURE-SOURCES.md D14) and another source may already have
    contributed the target id. Recents are merged the same way, most recent
    entry kept: they are keyed by id exactly as favorites are, and review
    found only favorites were being de-duplicated, so two rows landing on one
    id left the guide rendering the channel twice.

    Deliberately tolerant of a RAW state dict, not only a normalized one: the
    file this runs against is rewritten in place (remap_state_file) so that
    keys this helper version does not know survive the write. A field of an
    unexpected shape is left exactly as it is rather than coerced.
    """
    if not remap:
        return 0
    moved = 0
    items = state.get("favorites")
    if isinstance(items, list):
        favorites: list[Any] = []
        for item in items:
            target = remap.get(item, item) if isinstance(item, str) else item
            if target != item:
                moved += 1
            if target not in favorites:
                favorites.append(target)
        state["favorites"] = favorites
    entries = state.get("recents")
    if isinstance(entries, list):
        recents: list[Any] = []
        seen: set[str] = set()
        for entry in entries:
            if not isinstance(entry, dict):
                recents.append(entry)
                continue
            current = entry.get("id")
            target = remap.get(current) if isinstance(current, str) else None
            if target is not None:
                entry["id"] = target
                moved += 1
            key = entry.get("id")
            if isinstance(key, str):
                if key in seen:
                    continue
                seen.add(key)
            recents.append(entry)
        state["recents"] = recents
    for name in ("lastPlayed", "session"):
        entry = state.get(name)
        if not isinstance(entry, dict):
            continue
        current = entry.get("id")
        target = remap.get(current) if isinstance(current, str) else None
        if target is not None:
            entry["id"] = target
            moved += 1
    return moved


def remap_state_file(path: str, channels: list[dict[str, Any]]) -> int:
    """Rewrite state.json's channel references onto the current id scheme.

    Runs after a successful playlist fetch, when the caller named a state
    directory explicitly (cmd_playlist), and writes only when something
    actually moves -- which is at most once per state file, ever. That single
    write lands in the same class as the `state source add` the service
    already asks for mid-session: the service's FileView reloads state.json
    and Model.stateOnLoad merges it. It cannot become a periodic writer,
    because after the first pass the map moves nothing.

    The write edits the RAW document. An earlier version rebuilt it from
    normalize_state, which is a whitelist: every key this helper version does
    not know -- a field a newer version wrote, or an older one -- was silently
    dropped on a write the user never asked for. Moving four fields is the
    whole remit, so four fields are what it touches.
    """
    raw = read_json(path)
    if not isinstance(raw, dict):
        return 0
    remap = channel_id_remap(channels)
    if not remap:
        return 0
    updated = dict(raw)
    moved = remap_state_ids(updated, remap)
    if moved:
        write_json_atomic(path, updated)
    return moved


# ------------------------------------------------------------------- IO

# validate_source_url codes -> the helper's runtime error codes of 0.1 (the
# guide renders these through Model.statusReason; CLI users see them too).
_RESOLVE_CODES = {"empty": "no_source", "scheme": "unsupported_scheme", "invalid": "bad_url", "relative_path": "bad_url"}


def resolve_source(url: str, label: str = "playlist") -> tuple[str, str]:
    """-> ("http", normalized url) or ("file", absolute path). Refuses
    anything else through validate_source_url (D11: the guide and the
    helper accept exactly the same set; the 2,048-character cap and control
    characters are enforced here too). A leading `~` is expanded first, as
    in 0.1, for values set from the command line."""
    value = (url or "").strip()
    if value.startswith("~"):
        value = os.path.expanduser(value)
    result = validate_source_url(value)
    if not result["ok"]:
        code = _RESOLVE_CODES.get(result["code"], result["code"])
        if code == "no_source":
            raise HelperError(code, "no %s URL configured" % label)
        raise HelperError(code, "%s %s" % (label, result["message"]))
    return result["kind"], result["url"]


def read_local_source(path: str, label: str = "playlist") -> bytes:
    """Messages carry the base name only, never the full path (R12, D-QA-12)."""
    real = os.path.realpath(path)
    name = os.path.basename(real) or "file"
    if not os.path.isabs(real) or real.startswith(("/proc/", "/sys/", "/dev/")):
        raise HelperError("unsafe_path", "refusing to read a %s from /proc, /sys or /dev" % label)
    if not os.path.isfile(real):
        raise HelperError("not_found", "%s file not found: %s" % (label, name))
    size = os.path.getsize(real)
    if size > MAX_SOURCE_BYTES:
        raise HelperError("too_large", "%s file %s is larger than %d MB" % (label, name, MAX_SOURCE_BYTES // (1024 * 1024)))
    with open(real, "rb") as handle:
        return handle.read(MAX_SOURCE_BYTES + 1)


def split_userinfo(url: str) -> tuple[str, str]:
    """-> (URL without user:pass@, "user:pass" or ""). urllib does not accept
    userinfo in the netloc, so it is sent as HTTP Basic auth instead."""
    parts = urllib.parse.urlsplit(url)
    if parts.username is None:
        return url, ""
    host = parts.hostname or ""
    if ":" in host:
        host = "[" + host + "]"
    if parts.port is not None:
        host = "%s:%d" % (host, parts.port)
    auth = "%s:%s" % (urllib.parse.unquote(parts.username), urllib.parse.unquote(parts.password or ""))
    return urllib.parse.urlunsplit((parts.scheme, host, parts.path, parts.query, parts.fragment)), auth


def request_origin(url: str) -> tuple[str, str, int | None]:
    """(scheme, host, port): the scope a credential belongs to."""
    try:
        parts = urllib.parse.urlsplit(url)
        return parts.scheme.lower(), (parts.hostname or "").lower(), parts.port
    except ValueError:
        return "", "", None


def make_opener(label: str, host: str) -> Any:
    """urlopen replacement whose redirect handler (S-06) refuses non-http(s)
    targets (urllib's default happily follows a 302 to ftp://) and drops
    Authorization / Cookie when the origin (scheme, host, port) changes, so
    a provider that bounces to a third party never receives the user's
    credentials. urllib itself refuses file:/data: targets and loops with a
    3xx HTTPError, which read_http_source maps to the same error code."""
    import urllib.request

    class SafeRedirectHandler(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req: Any, fp: Any, code: int, msg: str, headers: Any, newurl: str) -> Any:
            scheme = stream_scheme(newurl)
            if scheme not in ("http", "https"):
                try:
                    fp.close()
                except OSError:
                    pass
                raise HelperError("unsafe_redirect", "%s from %s redirected to an unsupported scheme '%s'" % (label, host, scheme or "none"))
            new = super().redirect_request(req, fp, code, msg, headers, newurl)
            if new is not None and request_origin(newurl) != request_origin(req.full_url):
                for name in ("Authorization", "Cookie"):
                    new.remove_header(name)
            return new

    return urllib.request.build_opener(SafeRedirectHandler())


def http_deadline(timeout: float) -> float:
    """Wall-clock budget in seconds for one download (see HTTP_DEADLINE_MIN)."""
    override = os.environ.get(HTTP_DEADLINE_ENV, "")
    if override:
        try:
            return max(0.05, float(override))
        except ValueError:
            pass
    return max(HTTP_DEADLINE_MIN, 3.0 * float(timeout))


def read_http_source(url: str, timeout: float, label: str = "playlist") -> bytes:
    import base64
    import http.client
    import urllib.error
    import urllib.request
    host = source_host(url)
    target, auth = split_userinfo(url)
    headers = {"User-Agent": USER_AGENT, "Accept": "*/*"}
    if auth:
        headers["Authorization"] = "Basic " + base64.b64encode(auth.encode("utf-8")).decode("ascii")
    request = urllib.request.Request(target, headers=headers)
    opener = make_opener(label, host)
    budget = http_deadline(timeout)
    deadline = time.monotonic() + budget
    chunks: list[bytes] = []
    total = 0
    try:
        with opener.open(request, timeout=timeout) as response:
            # read1: at most one socket read per call, so a trickling server
            # cannot park us inside read() past the deadline check.
            while total <= MAX_SOURCE_BYTES:
                if time.monotonic() >= deadline:
                    # No seconds in the message: the guide renders the code as
                    # "Timed out" and the README states the deadline, so a
                    # number here could only disagree with them (D-LIVE-11).
                    raise HelperError("timeout", "%s download from %s exceeded its deadline" % (label, host))
                chunk = response.read1(HTTP_CHUNK)
                if not chunk:
                    break
                chunks.append(chunk)
                total += len(chunk)
    except HelperError:
        raise
    except urllib.error.HTTPError as error:
        if 300 <= error.code < 400:
            # urllib refused the redirect itself (file:, data:, a loop); its
            # message carries the target URL, so it is not repeated here.
            raise HelperError("unsafe_redirect", "%s redirect from %s not followed" % (label, host))
        raise HelperError("http_%d" % error.code, "HTTP %d from %s" % (error.code, host))
    except urllib.error.URLError as error:
        reason = getattr(error, "reason", error)
        raise HelperError("network", "could not reach %s: %s" % (host, redact_urls(reason)))
    except (TimeoutError, OSError, ValueError, http.client.HTTPException) as error:
        raise HelperError("network", "could not reach %s: %s" % (host, redact_urls(error)))
    if total > MAX_SOURCE_BYTES:
        raise HelperError("too_large", "%s from %s exceeds %d MB" % (label, host, MAX_SOURCE_BYTES // (1024 * 1024)))
    return b"".join(chunks)


def fetch_bytes(url: str, timeout: float, label: str = "playlist") -> bytes:
    kind, target = resolve_source(url, label)
    if kind == "file":
        return read_local_source(target, label)
    return read_http_source(target, timeout, label)


def too_large_inflated(label: str) -> HelperError:
    return HelperError("too_large", "decompressed %s exceeds %d MB" % (label, MAX_SOURCE_BYTES // (1024 * 1024)))


def decode_text(data: bytes, label: str = "playlist") -> str:
    """UTF-8 text; gzip (by magic bytes) is inflated with the same 64 MB cap
    as the download so a gzip bomb cannot exhaust memory (D-QA-06)."""
    if data[:2] == b"\x1f\x8b":
        try:
            with gzip.GzipFile(fileobj=io.BytesIO(data), mode="rb") as stream:
                data = stream.read(MAX_SOURCE_BYTES + 1)
        except (OSError, EOFError, zlib.error) as error:
            raise HelperError("bad_gzip", "could not decompress %s: %s" % (label, error))
        if len(data) > MAX_SOURCE_BYTES:
            raise too_large_inflated(label)
    return data.decode("utf-8", errors="replace")


def fetch_source(url: str, timeout: float) -> str:
    return decode_text(fetch_bytes(url, timeout, "playlist"), "playlist")


class CappedReader:
    """Binary stream wrapper that refuses to hand out more than `limit` bytes
    in total (the inflated-size cap for streamed gzip, D-QA-06)."""

    def __init__(self, stream: Any, limit: int, label: str) -> None:
        self.stream = stream
        self.limit = limit
        self.label = label
        self.total = 0

    def read(self, size: int = -1) -> bytes:
        chunk = self.stream.read(size)
        self.total += len(chunk)
        if self.total > self.limit:
            raise too_large_inflated(self.label)
        return chunk

    def close(self) -> None:
        self.stream.close()


def open_xml_stream(data: bytes) -> Any:
    """Bytes -> readable stream; gzip is detected by magic bytes, not by name."""
    if data[:2] == b"\x1f\x8b":
        return CappedReader(gzip.GzipFile(fileobj=io.BytesIO(data), mode="rb"), MAX_SOURCE_BYTES, "EPG")
    return io.BytesIO(data)


def write_text_atomic(path: str, text: str) -> None:
    """Temp file in the same (0700) directory, mode 0600, rename over `path`."""
    directory = os.path.dirname(path)
    ensure_private_dir(directory)
    tmp = os.path.join(directory, ".tmp-%s-%s" % (os.path.basename(path), os.urandom(4).hex()))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def write_bytes_atomic(path: str, data: bytes) -> None:
    """The binary sibling of write_text_atomic, same 0700 / 0600 discipline.

    Added for logos (M2-04), which are the first non-text thing this helper
    writes into the cache.
    """
    directory = os.path.dirname(path)
    ensure_private_dir(directory)
    tmp = os.path.join(directory, ".tmp-%s-%s" % (os.path.basename(path), os.urandom(4).hex()))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def write_json_atomic(path: str, payload: Any) -> None:
    # json.dumps (one-shot C encoder) is several times faster than json.dump.
    write_text_atomic(path, json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + "\n")


def json_string(text: str) -> str:
    """JSON string literal; the common quote-free case skips the encoder."""
    if '"' in text or "\\" in text:
        return json.dumps(text, ensure_ascii=False)
    return '"' + text + '"'


def read_json(path: str) -> Any:
    try:
        with open(path, "r", encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def emit(payload: Any) -> None:
    sys.stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def error_payload(kind: str, error: HelperError, **extra: Any) -> dict[str, Any]:
    payload: dict[str, Any] = {
        "ok": False,
        "kind": kind,
        "error": {"code": error.code, "message": redact_urls(error.message)},
    }
    payload.update(error.extra)
    payload.update(extra)
    return payload


def write_status_quietly(path: str, status: dict[str, Any]) -> None:
    try:
        write_json_atomic(path, status)
    except OSError as io_error:
        log("could not write %s: %s" % (os.path.basename(path), io_error))


# ------------------------------------------------------------ playlist

def cmd_playlist(args: argparse.Namespace) -> int:
    directory = cache_dir(args.cache_dir)
    channels_path = os.path.join(directory, CHANNELS_FILE)
    status_path = os.path.join(directory, PLAYLIST_STATUS_FILE)
    previous = read_json(status_path) or {}
    started = time.monotonic()
    try:
        text = fetch_source(args.url, args.timeout)
        parsed = parse_m3u(text)
        if not parsed["channels"]:
            if not parsed["isPlaylist"]:
                raise HelperError("not_a_playlist", "source from %s is not an M3U playlist (no #EXTM3U or #EXTINF lines)" % source_host(args.url))
            raise HelperError("empty_playlist", "no playable channels found in playlist from %s" % source_host(args.url))
        now = int(time.time())
        document = {
            "version": 1,
            "generatedAt": now,
            "sourceHost": source_host(args.url),
            "epgUrlHint": parsed["epgUrlHint"],
            "count": len(parsed["channels"]),
            "channels": parsed["channels"],
        }
        write_json_atomic(channels_path, document)
        groups = {channel["group"] for channel in parsed["channels"]}
        status = {
            "ok": True,
            "kind": "playlist",
            "sourceHost": source_host(args.url),
            "fetchedAt": now,
            "durationMs": int((time.monotonic() - started) * 1000),
            "channelCount": len(parsed["channels"]),
            "groupCount": len(groups),
            "warnings": parsed["warnings"],
            "stale": False,
            "error": None,
        }
        write_json_atomic(status_path, status)
        # The upgrade path of ARCHITECTURE.md decision 6. A state file written
        # under id scheme 1 still names its favorites by a hash of the
        # credentialed stream URL, and this is the one place the helper holds
        # both that state and the channel list needed to move them. It writes
        # at most once per state file and never fails the fetch: a playlist
        # that parsed is a success whatever the state file turns out to be.
        #
        # `--state-dir` is REQUIRED, with no default of any kind. An earlier
        # version resolved it with `state_dir(getattr(args, "state_dir",
        # None))`, so every `playlist` run that did not name a state directory
        # reached into the live one: one `unittest discover` put 124 remap
        # passes over the user's own ~/.local/state/omarchy-iptv/state.json,
        # and `playlist --url ... --cache-dir /tmp/scratch` did the same from
        # a shell. Two callers pass a playlist URL here -- the active source's
        # fetch and the probe that runs while a NEW source is being added --
        # and only the first may move saved references, so the caller has to
        # say which it is. Silence means touch nothing.
        if args.state_dir:
            try:
                moved = remap_state_file(os.path.join(state_dir(args.state_dir), STATE_FILE), parsed["channels"])
                if moved:
                    log("playlist: moved %d saved channel reference(s) onto id scheme %d" % (moved, CHANNEL_ID_SCHEME))
            except OSError as error:
                log("playlist: could not update saved channel references (%s)" % type(error).__name__)
        emit(status)
        return EXIT_OK
    except HelperError as error:
        stale = os.path.isfile(channels_path)
        status = error_payload(
            "playlist", error,
            sourceHost=source_host(args.url or ""),
            fetchedAt=previous.get("fetchedAt") if isinstance(previous, dict) else None,
            stale=stale,
            durationMs=int((time.monotonic() - started) * 1000),
        )
        write_status_quietly(status_path, status)
        log("playlist: %s" % error.message)
        emit(status)
        return EXIT_ERROR


# ----------------------------------------------------------------- EPG

def parse_xmltv_time(raw: str | None, cache: dict[str, int | None]) -> int | None:
    """`20260912213000 +0100` -> epoch seconds. Missing offset means UTC.

    Shorter forms (YYYYMMDD, YYYYMMDDHH, YYYYMMDDHHMM) are padded with zeros.
    Returns None for anything unparseable. `cache` is keyed by the raw
    string because a feed repeats the same few thousand boundaries.
    """
    if not raw:
        return None
    if raw in cache:
        return cache[raw]
    match = _XMLTV_TIME.match(raw.strip())
    if not match:
        cache[raw] = None
        return None
    import calendar
    year, month, day, hour, minute, second = (int(match.group(index) or 0) for index in range(1, 7))
    try:
        ts = calendar.timegm((year, month, day, hour, minute, second, 0, 0, 0))
    except (ValueError, OverflowError):
        cache[raw] = None
        return None
    if match.group(7):
        offset = int(match.group(8)) * 3600 + int(match.group(9)) * 60
        ts -= offset if match.group(7) == "+" else -offset
    cache[raw] = ts
    return ts


def clean_title(text: str | None) -> str:
    if not text:
        return ""
    return _CONTROL_WS.sub(" ", text).strip()[:EPG_MAX_TITLE]


def build_alias(channels_doc: Any) -> tuple[dict[str, str] | None, int]:
    """Playlist tvg-ids -> alias map (exact id and, when free, its lower-case
    form) so XMLTV ids match case-sensitively first, case-insensitively
    second. Returns (None, 0) when no channel cache exists."""
    if not isinstance(channels_doc, dict) or not isinstance(channels_doc.get("channels"), list):
        return None, 0
    alias: dict[str, str] = {}
    total = 0
    for channel in channels_doc["channels"]:
        total += 1
        tvg = channel.get("tvgId") if isinstance(channel, dict) else None
        if isinstance(tvg, str) and tvg:
            alias[tvg] = tvg
    for tvg in list(alias):
        low = tvg.lower()
        if low not in alias:
            alias[low] = tvg
    return alias, total


def source_key(url: str) -> str:
    import hashlib
    return hashlib.sha256(url.strip().encode("utf-8")).hexdigest()[:16]


# The last epoch second that still fits ten digits: 2286-11-20T17:46:39Z.
#
# Ten digits is not a formatting preference, it is the record format's
# CONTRACT. The readers slice [0:10], [11:21] and [22:] rather than splitting,
# because bisect over fixed-width prefixes is what buys the 10,000-channel
# budget (see EPG_RECORD_SEP). But "%010d" sets a MINIMUM width and not a
# maximum, so a larger timestamp pushed the title into the number field and
# produced a line no JSON parser would accept -- and epg-now.json is written by
# concatenation, so ONE such programme cost every channel of that source its
# guide data, silently, while the helper exited 0 reporting ok:true. An
# eleven-digit stop was quieter and worse: valid JSON carrying a truncated
# stop, so the row showed as having nothing on.
#
# Feeds really do carry these. `99991231235959` is a common "runs forever"
# sentinel for 24/7 streams, and it is twelve digits.
#
# Clamping here makes the function total and keeps the invariant at the one
# place records are made, rather than asking three readers to defend against
# input their own format forbids.
EPG_MAX_EPOCH = 9999999999


def encode_record(start: int, stop: int, title: str) -> str:
    """See EPG_RECORD_SEP. `start`/`stop` are clamped into the ten-digit range
    the record format requires; a stop past 2286 means "runs forever" and is
    truthfully represented by the furthest instant the format can hold."""
    start = 0 if start < 0 else min(start, EPG_MAX_EPOCH)
    stop = 0 if stop < 0 else min(stop, EPG_MAX_EPOCH)
    return "%010d %010d %s" % (start, stop, json.dumps(title, ensure_ascii=False))


def encode_records(items: list[tuple[int, int | None, str]]) -> tuple[str, int]:
    """Sort, infer missing stops, drop duplicates, cap, and pack a channel's
    programmes into the record string described at EPG_RECORD_SEP."""
    items.sort(key=lambda item: item[0])
    records: list[str] = []
    last: tuple[int, int, str] | None = None
    count = len(items)
    for index, (start, stop, title) in enumerate(items):
        if stop is None:
            stop = start + EPG_DEFAULT_DURATION
            for later in range(index + 1, count):
                if items[later][0] > start:
                    stop = items[later][0]
                    break
        if stop <= start or start < 0:
            continue
        current = (start, stop, title)
        if current == last:
            continue
        last = current
        records.append(encode_record(start, stop, title))
        if len(records) >= EPG_MAX_PER_CHANNEL:
            break
    return EPG_RECORD_SEP.join(records), len(records)


def parse_xmltv(stream: BinaryIO, now: int, alias: dict[str, str] | None) -> dict[str, Any]:
    """Stream-parse XMLTV into per-channel record strings for the window.

    `alias` (from build_alias) restricts the result to playlist channels and
    maps XMLTV ids onto playlist tvg-ids; None keeps every channel under its
    XMLTV id. Elements are released as soon as they are processed.
    """
    import xml.etree.ElementTree as ET
    window_start = now - EPG_PAST_SECONDS
    window_end = now + EPG_FUTURE_SECONDS
    time_cache: dict[str, int | None] = {}
    pending: dict[str, list[tuple[int, int | None, str]]] = {}
    seen_ids: set[str] = set()
    channel_elements = 0
    bad_time = 0
    no_title = 0
    unknown = 0
    total_programmes = 0
    root: Any = None
    try:
        for event, elem in ET.iterparse(stream, events=("start", "end")):
            if event == "start":
                if root is None:
                    root = elem
                continue
            tag = elem.tag
            if tag == "programme":
                total_programmes += 1
                cid = _CONTROL_WS.sub(" ", elem.get("channel") or "").strip()
                key = cid if alias is None else (alias.get(cid) or alias.get(cid.lower()))
                if not key:
                    unknown += 1
                else:
                    seen_ids.add(key)
                    start = parse_xmltv_time(elem.get("start"), time_cache)
                    if start is None:
                        bad_time += 1
                    else:
                        stop = parse_xmltv_time(elem.get("stop"), time_cache)
                        effective_stop = stop if stop is not None else start + EPG_DEFAULT_DURATION
                        if effective_stop > window_start and start < window_end:
                            title_elem = elem.find("title")
                            title = clean_title(title_elem.text if title_elem is not None else "")
                            if title:
                                pending.setdefault(key, []).append((start, stop, title))
                            else:
                                no_title += 1
            elif tag == "channel":
                channel_elements += 1
            # Release every finished element: the tree never holds more than
            # the element being built, whatever the feed puts under <tv>.
            if root is not None and elem is not root:
                root.clear()
    except ET.ParseError as error:
        raise HelperError("bad_xml", "could not parse EPG XML: %s" % error)
    except (OSError, EOFError, zlib.error) as error:
        raise HelperError("bad_gzip", "could not decompress EPG: %s" % error)
    if total_programmes == 0:
        raise HelperError("empty_epg", "no programmes found in the EPG")

    channels: dict[str, str] = {}
    kept = 0
    for key, items in pending.items():
        blob, count = encode_records(items)
        if count:
            channels[key] = blob
            kept += count
    warnings: list[str] = []
    if bad_time:
        warnings.append("%d programmes with unreadable times skipped" % bad_time)
    if no_title:
        warnings.append("%d programmes without a title skipped" % no_title)
    if alias is not None and unknown:
        warnings.append("%d programmes for channels not in the playlist dropped" % unknown)
    return {
        "channels": channels,
        "seenIds": seen_ids,
        "windowStart": window_start,
        "windowEnd": window_end,
        "epgChannels": len(seen_ids),
        "channelElements": channel_elements,
        "programmeCount": kept,
        "warnings": warnings,
    }


def count_matched(channels_doc: Any, seen_ids: set[str]) -> int:
    matched = 0
    for channel in channels_doc.get("channels", []):
        tvg = channel.get("tvgId") if isinstance(channel, dict) else None
        if isinstance(tvg, str) and tvg in seen_ids:
            matched += 1
    return matched


def channels_mtime(path: str) -> int | None:
    try:
        return int(os.stat(path).st_mtime_ns)
    except OSError:
        return None


def window_lines(channels: dict[str, str]) -> list[str]:
    """'"<id>"\t<records>' per channel; the id is stored JSON-encoded."""
    return ["%s\t%s" % (json_string(cid), blob) for cid, blob in channels.items()]


def write_window(path: str, meta: dict[str, Any], channels: dict[str, str]) -> None:
    lines = [json.dumps(meta, ensure_ascii=False, separators=(",", ":"))]
    lines.extend(window_lines(channels))
    write_text_atomic(path, "\n".join(lines) + "\n")


def load_window(path: str) -> dict[str, Any] | None:
    """-> the header keys plus "lines" (the raw channel lines), or None."""
    try:
        with open(path, "r", encoding="utf-8") as handle:
            text = handle.read()
    except OSError:
        return None
    head, _, body = text.partition("\n")
    try:
        meta = json.loads(head)
    except ValueError:
        return None
    if not isinstance(meta, dict) or meta.get("version") != 1:
        return None
    window = dict(meta)
    window["lines"] = body.split("\n")
    return window


def window_channels(window: dict[str, Any]) -> dict[str, str]:
    """Channel id -> record blob (diagnostics and tests; not the hot path)."""
    out: dict[str, str] = {}
    for line in window.get("lines", []):
        cid, tab, blob = line.partition("\t")
        if tab:
            out[json.loads(cid)] = blob
    return out


def needs_refetch(window: dict[str, Any], url: str, now: int, ttl: float, channels_path: str) -> str:
    """Empty string when the cached window is still good, else the reason."""
    if window.get("sourceKey") != source_key(url):
        return "source changed"
    fetched_at = int(window.get("fetchedAt") or 0)
    if now - fetched_at >= ttl or fetched_at > now + 60:
        return "cache older than ttl"
    if int(window.get("windowEnd") or 0) - now < EPG_REFETCH_MARGIN:
        return "window nearly exhausted"
    if window.get("channelsMtime") != channels_mtime(channels_path):
        return "playlist changed"
    return ""


def fetch_window(url: str, timeout: float, now: int, directory: str) -> dict[str, Any]:
    channels_path = os.path.join(directory, CHANNELS_FILE)
    data = fetch_bytes(url, timeout, "EPG")
    channels_doc = read_json(channels_path)
    mtime = channels_mtime(channels_path)
    alias, channel_total = build_alias(channels_doc)
    parsed = parse_xmltv(open_xml_stream(data), now, alias)
    matched = count_matched(channels_doc, parsed["seenIds"]) if alias is not None else None
    warnings = list(parsed["warnings"])
    if alias is not None and matched == 0:
        warnings.append("no EPG channel id matches a playlist tvg-id")
    meta = {
        "version": 1,
        "fetchedAt": now,
        "sourceHost": source_host(url),
        "sourceKey": source_key(url),
        "channelsMtime": mtime,
        "windowStart": parsed["windowStart"],
        "windowEnd": parsed["windowEnd"],
        "restricted": alias is not None,
        "channelTotal": channel_total if alias is not None else None,
        "matched": matched,
        "epgChannels": parsed["epgChannels"],
        "programmeCount": parsed["programmeCount"],
        "warnings": warnings,
    }
    write_window(os.path.join(directory, EPG_WINDOW_FILE), meta, parsed["channels"])
    window = dict(meta)
    window["lines"] = window_lines(parsed["channels"])
    return window


def record_to_dict(record: str) -> dict[str, Any]:
    return {"title": json.loads(record[22:]), "start": int(record[:10]), "stop": int(record[11:21])}


def programme_json(record: str) -> str:
    start = record[:10]
    stop = record[11:21]
    if start[0] == "0" or stop[0] == "0":
        start, stop = str(int(start)), str(int(stop))  # no leading zeros in JSON numbers
    return '{"title":' + record[22:] + ',"start":' + start + ',"stop":' + stop + "}"


def compute_now_next(window: dict[str, Any], now: int) -> tuple[list[str], int, int]:
    """-> (JSON fragments `"id":{"now":...,"next":...}`, validUntil, channels with a `now`).

    `now` is the programme with the latest start <= now that has not ended
    (a few earlier records are probed so an overlapped long programme still
    counts); `next` is the first programme starting after now. The hot path
    for 10k channels: fixed-width record prefixes make bisect and string
    comparison enough, and the output is assembled as text.
    """
    sep = EPG_RECORD_SEP
    bisect_right = bisect.bisect_right
    now_str = "%010d" % now
    now_key = now_str + "~"
    boundary = "%010d" % (now + EPG_VALID_MAX)
    now_count = 0
    fragments: list[str] = []
    for line in window["lines"]:
        cid, tab, blob = line.partition("\t")
        if not tab:
            continue
        records = blob.split(sep)
        index = bisect_right(records, now_key)
        current = None
        probe = index - 1
        floor = index - 5
        while probe >= 0 and probe > floor:
            record = records[probe]
            if record[11:21] > now_str:
                current = record
                break
            probe -= 1
        following = records[index] if index < len(records) else None
        if current is None and following is None:
            continue
        parts: list[str] = []
        if current is not None:
            parts.append('"now":' + programme_json(current))
            if current[11:21] < boundary:
                boundary = current[11:21]
            now_count += 1
        if following is not None:
            parts.append('"next":' + programme_json(following))
            if following[:10] < boundary:
                boundary = following[:10]
        fragments.append(cid + ":{" + ",".join(parts) + "}")
    return fragments, max(int(boundary), now + 1), now_count


def write_epg_now(directory: str, window: dict[str, Any], now: int) -> tuple[int, int]:
    fragments, valid_until, now_count = compute_now_next(window, now)
    head = json.dumps({
        "version": 1,
        "generatedAt": now,
        "validUntil": valid_until,
        "fetchedAt": window.get("fetchedAt"),
        "sourceHost": window.get("sourceHost", ""),
    }, ensure_ascii=False, separators=(",", ":"))
    text = head[:-1] + ',"channels":{' + ",".join(fragments) + "}}\n"
    write_text_atomic(os.path.join(directory, EPG_NOW_FILE), text)
    return valid_until, now_count


def cmd_epg(args: argparse.Namespace) -> int:
    directory = cache_dir(args.cache_dir)
    now = int(args.now) if args.now else int(time.time())
    window_path = os.path.join(directory, EPG_WINDOW_FILE)
    status_path = os.path.join(directory, EPG_STATUS_FILE)
    channels_path = os.path.join(directory, CHANNELS_FILE)
    url = (args.url or "").strip()
    started = time.monotonic()
    window = load_window(window_path)
    previous = read_json(status_path) or {}
    try:
        if args.now_only:
            if window is None:
                raise HelperError("no_cache", "no cached EPG window yet; fetch the EPG first")
            from_cache = True
            reason = ""
        else:
            if not url:
                raise HelperError("no_source", "no EPG URL configured")
            reason = "forced" if args.force else ("no cache" if window is None else needs_refetch(window, url, now, args.ttl, channels_path))
            if reason:
                window = fetch_window(url, args.timeout, now, directory)
                from_cache = False
            else:
                from_cache = True
        assert window is not None
        valid_until, now_count = write_epg_now(directory, window, now)
        fetched_at = int(window.get("fetchedAt") or 0)
        status = {
            "ok": True,
            "kind": "epg",
            "sourceHost": window.get("sourceHost", ""),
            "fetchedAt": fetched_at,
            "generatedAt": now,
            "validUntil": valid_until,
            "durationMs": int((time.monotonic() - started) * 1000),
            "fromCache": from_cache,
            "matched": window.get("matched"),
            "channelTotal": window.get("channelTotal"),
            "epgChannels": window.get("epgChannels", 0),
            "programmeCount": window.get("programmeCount", 0),
            "nowCount": now_count,
            "warnings": list(window.get("warnings") or []),
            "stale": from_cache and (now - fetched_at > args.ttl),
            "error": None,
        }
        write_json_atomic(status_path, status)
        emit(status)
        return EXIT_OK
    except HelperError as error:
        if window is not None:
            try:
                write_epg_now(directory, window, now)
            except OSError as io_error:
                log("could not refresh %s: %s" % (EPG_NOW_FILE, io_error))
        host = source_host(url) if url else (window.get("sourceHost", "") if window else "")
        status = error_payload(
            "epg", error,
            sourceHost=host,
            fetchedAt=window.get("fetchedAt") if window else (previous.get("fetchedAt") if isinstance(previous, dict) else None),
            stale=window is not None,
            matched=window.get("matched") if window else None,
            channelTotal=window.get("channelTotal") if window else None,
            durationMs=int((time.monotonic() - started) * 1000),
        )
        write_status_quietly(status_path, status)
        log("epg: %s" % error.message)
        emit(status)
        return EXIT_ERROR


# ------------------------------------------------------------- mpv IPC

class MpvIpc:
    """Minimal client for mpv's JSON IPC: one request at a time, replies
    correlated by request_id, unsolicited events KEPT.

    Events used to be dropped where a reply was expected. `player start`
    subscribes with `request_log_messages` before the first `loadfile` and
    then has to see that load's `start-file` / `end-file` / `log-message`
    (F3), so an event a request steps over is appended to `self.events` and
    read back by `drain_events()` instead of being thrown away.
    """

    def __init__(self, path: str, timeout: float) -> None:
        self.path = path
        self.timeout = timeout
        self.sock: Any = None
        self.buffer = b""
        self.next_id = 1
        self.refused = False
        self.events: list[dict[str, Any]] = []
        self.closed = False

    def connect(self) -> None:
        import socket
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(self.timeout)
        try:
            sock.connect(self.path)
        except FileNotFoundError:
            sock.close()
            raise HelperError("not_running", "mpv socket not found")
        except ConnectionRefusedError:
            sock.close()
            self.refused = True
            raise HelperError("not_running", "mpv socket not reachable")
        except TimeoutError:
            sock.close()
            raise HelperError("not_running", "mpv socket did not accept the connection")
        except OSError as error:
            sock.close()
            raise HelperError("ipc_error", "could not connect to mpv: %s" % (error.strerror or error))
        self.sock = sock

    def close(self) -> None:
        if self.sock is not None:
            try:
                self.sock.close()
            except OSError:
                pass
            self.sock = None

    def read_line(self, deadline: float) -> bytes | None:
        """One JSON line from mpv, or None once mpv closed the connection."""
        assert self.sock is not None
        while b"\n" not in self.buffer:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise HelperError("ipc_error", "mpv did not answer within %.1f s" % self.timeout)
            self.sock.settimeout(remaining)
            try:
                chunk = self.sock.recv(65536)
            except TimeoutError:
                raise HelperError("ipc_error", "mpv did not answer within %.1f s" % self.timeout)
            except (ConnectionResetError, BrokenPipeError):
                return None
            except OSError as error:
                raise HelperError("ipc_error", "could not read from mpv: %s" % (error.strerror or error))
            if not chunk:
                return None
            self.buffer += chunk
        line, _, self.buffer = self.buffer.partition(b"\n")
        return line

    def request(self, command: list[Any], allow_close: bool = False) -> dict[str, Any]:
        """Send `command` and return mpv's reply object for it.

        With allow_close, mpv closing the connection after the request was
        sent counts as `{"error": "success"}` (used by `quit`).
        """
        assert self.sock is not None
        request_id = self.next_id
        self.next_id += 1
        payload = json.dumps({"command": command, "request_id": request_id}, ensure_ascii=False) + "\n"
        try:
            self.sock.sendall(payload.encode("utf-8"))
        except (ConnectionResetError, BrokenPipeError):
            if allow_close:
                return {"error": "success", "request_id": request_id}
            raise HelperError("ipc_error", "mpv closed the connection")
        except OSError as error:
            raise HelperError("ipc_error", "could not write to mpv: %s" % (error.strerror or error))
        deadline = time.monotonic() + self.timeout
        while True:
            line = self.read_line(deadline)
            if line is None:
                if allow_close:
                    return {"error": "success", "request_id": request_id}
                raise HelperError("ipc_error", "mpv closed the connection")
            try:
                message = json.loads(line)
            except ValueError:
                continue
            if not isinstance(message, dict):
                continue
            if message.get("request_id") == request_id:
                return message
            if "request_id" not in message:
                self.events.append(message)

    def drain_events(self, deadline: float) -> list[dict[str, Any]] | None:
        """Event lines mpv sent unasked, waiting until `deadline` (an absolute
        time.monotonic value) for one. `[]` means nothing arrived in time,
        `None` means mpv closed the connection - which under `--idle=once` is
        itself the death signal."""
        if self.events:
            drained, self.events = self.events, []
            return drained
        if self.sock is None or self.closed:
            return None
        try:
            line = self.read_line(deadline)
        except HelperError:
            return []
        if line is None:
            self.closed = True
            return None
        try:
            message = json.loads(line)
        except ValueError:
            return []
        if isinstance(message, dict) and "request_id" not in message:
            return [message]
        return []

    def command(self, *args: Any) -> Any:
        """Run a command; an mpv-side error becomes HelperError(ipc_error)."""
        reply = self.request(list(args))
        if reply.get("error") != "success":
            # Property names are safe to print; values (URLs) never are.
            what = " ".join(str(part) for part in args[:2]) if args[0] in ("set_property", "get_property") else str(args[0])
            raise HelperError("ipc_error", "mpv refused %s: %s" % (what, reply.get("error") or "unknown error"))
        return reply.get("data")

    def try_command(self, *args: Any) -> tuple[bool, Any]:
        """Like command(), but an mpv-side error yields (False, None)."""
        reply = self.request(list(args))
        if reply.get("error") != "success":
            return False, None
        return True, reply.get("data")


# ---- M2-04 logos: the survey that contacts nothing -------------------------
#
# Ruling rule 6 (the logo privacy ruling, dev branch): a generic "logos may contact
# third parties" is not informed consent when the real answer is countable. On
# the list this was measured against, turning logos on would contact 63 hosts
# and hand i.imgur.com alone a request pattern covering two thirds of the
# channels. So the number is produced BEFORE the choice, by reading the cache
# and making no request at all.
#
# Output carries HOSTS and never URLs (engineering rule 5, dev branch). A logo URL can carry a
# provider path and, on a provider whose logos sit beside its playlist, a query
# string; the host is the whole of what a user needs to judge the disclosure.
LOGO_SCHEMES = ("https",)
LOGO_TYPES = ("image/png", "image/jpeg", "image/webp", "image/gif")


def logo_host(netloc: str) -> str:
    """The host a logo URL would disclose to, or "" when it discloses to none.

    The PORT is not part of the answer. The question the survey exists to
    answer is how many parties learn which channels this user has, and
    `cdn.test` and `cdn.test:8443` are one party; counting them separately
    inflates the only number in the consent sentence.

    Userinfo makes the answer "": fetch_logo refuses such a URL outright, so
    the host is never contacted, and naming it would print the credentials in
    the consent text. Mirrored by Model.splitLogoUrl.
    """
    text = (netloc or "").strip().lower()
    if "@" in text:
        return ""
    if text.startswith("["):
        # IPv6 literal: the bracketed half is the host, any :port follows it.
        close = text.find("]")
        return text[: close + 1] if close != -1 else ""
    return text.split(":", 1)[0]


def logo_survey(channels: Any) -> dict[str, Any]:
    """Who enabling logos would contact, counted from the cache.

    Pure: no network, no filesystem beyond what the caller already read.
    """
    rows = channels if isinstance(channels, list) else []
    hosts: dict[str, int] = {}
    schemes: dict[str, int] = {}
    with_logo = 0
    refused = 0
    for channel in rows:
        if not isinstance(channel, dict):
            continue
        raw = channel.get("logo")
        if not isinstance(raw, str) or not raw:
            continue
        with_logo += 1
        parsed = urllib.parse.urlsplit(raw)
        scheme = (parsed.scheme or "").lower()
        schemes[scheme] = schemes.get(scheme, 0) + 1
        if scheme not in LOGO_SCHEMES:
            # Counted, never contacted: rule 3 of the ruling is https only.
            refused += 1
            continue
        host = logo_host(parsed.netloc or "")
        if not host:
            # No host at all, or userinfo. fetch_logo refuses a URL carrying
            # userinfo rather than stripping it, so a survey that counted one
            # as contactable would promise a fetch that cannot happen -- and
            # would print `user:pass@provider.test` into the consent text the
            # user is reading. The credential-sink rule (engineering rule 5): every sink redacts to scheme
            # and host, and the consent dialog is a sink. Caught by
            # the shared logo-survey fixture (dev branch) before it was ever drawn.
            refused += 1
            continue
        hosts[host] = hosts.get(host, 0) + 1
    ordered = sorted(hosts.items(), key=lambda pair: (-pair[1], pair[0]))
    return {
        "channels": len(rows),
        "withLogo": with_logo,
        "wouldContact": sum(hosts.values()),
        "refused": refused,
        "hostCount": len(ordered),
        "hosts": [{"host": h, "channels": n} for h, n in ordered],
        "schemes": schemes,
        "allowedSchemes": list(LOGO_SCHEMES),
        "allowedTypes": list(LOGO_TYPES),
    }


MAX_LOGO_BYTES = 256 * 1024
MAX_LOGO_FILES = 5000


def logo_filename(url: str) -> str:
    """A name derived from the URL, never FROM the URL.

    The provider's path never reaches the filesystem: it can carry a channel
    name, a subscriber id or a query string, and a path from an untrusted
    string is also how a traversal gets written outside the cache. fnv1a32 of
    the URL plus the extension implied by the content type at write time.
    """
    return fnv1a32(url)


def logo_opener(host: str) -> Any:
    """An opener that enforces the https rule on EVERY hop, not just the first.

    D-LOGO-1. `fetch_logo` checked the scheme of the URL it was handed and then
    called the bare `urllib.request.urlopen`, which uses the module-global
    default opener -- and urllib's default redirect handler happily follows a
    302 to `http://` or `ftp://`. So an https logo could redirect the fetch
    into cleartext, or onto an unauthenticated FTP connection, and an ftp
    target would even pass the content-type gate because urllib synthesizes
    Content-Type for an FTP response from the filename.

    That breaks two things this feature is built on: RULING-LOGOS.md (dev
    branch) rule 3, https only, which this function's own docstring claims;
    and the consent sentence, which tells the user how many hosts will be
    contacted and names the busiest.

    `make_opener` already exists for this class of bug (S-06) but is one step
    too permissive here: it allows http as well as https, which is right for a
    playlist and wrong for a logo. This is the narrower sibling.

    RESIDUAL, stated rather than rounded away: a redirect to a different HTTPS
    host is allowed, and the consent count does not cover it. Refusing every
    cross-host redirect would break ordinary CDN behaviour, and the disclosure
    is to a party the named host chose rather than one this plugin invented.
    It is transient, carries no credentials, and is reasoned about here rather
    than left implicit.
    """
    import urllib.request

    class LogoRedirectHandler(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req: Any, fp: Any, code: int, msg: str, headers: Any, newurl: str) -> Any:
            parsed = urllib.parse.urlsplit(newurl)
            if parsed.scheme.lower() not in LOGO_SCHEMES:
                try:
                    fp.close()
                except OSError:
                    pass
                raise HelperError("logo_redirect",
                                  "a logo from %s redirected to '%s', which is not https"
                                  % (host, parsed.scheme.lower() or "no scheme"))
            if "@" in parsed.netloc:
                try:
                    fp.close()
                except OSError:
                    pass
                raise HelperError("logo_redirect",
                                  "a logo from %s redirected to a URL carrying userinfo" % host)
            new = super().redirect_request(req, fp, code, msg, headers, newurl)
            if new is not None:
                # Nothing sets these on a logo request; removed anyway so a
                # future caller cannot reintroduce the leak by adding a header.
                for name in ("Authorization", "Cookie"):
                    new.remove_header(name)
            return new

    # No FTPHandler: build_opener adds the defaults, and the redirect guard
    # already refuses an ftp target, but a handler that cannot be reached is
    # one fewer thing to reason about.
    opener = urllib.request.build_opener(LogoRedirectHandler())
    opener.handlers = [h for h in opener.handlers
                       if h.__class__.__name__ not in ("FTPHandler", "CacheFTPHandler",
                                                       "FileHandler", "DataHandler")]
    return opener


def fetch_logo(url: str, timeout: float) -> tuple[bytes, str]:
    """Fetch one logo under the ruling's guards. Returns (bytes, content type).

    Deliberately NOT read_http_source. That path sends an Authorization header
    whenever the URL carries userinfo, which is right for a playlist and is the
    one thing a logo request must never do: a provider whose logos sit beside
    its playlist would receive the subscription credentials as a side effect of
    a picture. This sends no credentials, follows no userinfo, and refuses
    anything that is not https.
    """
    import urllib.error
    import urllib.request
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme.lower() not in LOGO_SCHEMES:
        raise HelperError("logo_scheme", "refused a non-https logo host")
    if "@" in parsed.netloc:
        raise HelperError("logo_userinfo", "refused a logo URL carrying userinfo")
    host = parsed.netloc.lower()
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Accept": "image/*"})
    try:
        with logo_opener(host).open(request, timeout=timeout) as response:
            ctype = (response.headers.get("Content-Type") or "").split(";")[0].strip().lower()
            if ctype not in LOGO_TYPES:
                raise HelperError("logo_type", "refused %s from %s" % (ctype or "an unnamed type", host))
            data = response.read(MAX_LOGO_BYTES + 1)
    except HelperError:
        raise
    except (urllib.error.URLError, OSError, ValueError) as error:
        raise HelperError("logo_fetch", "could not fetch a logo from %s: %s" % (host, error.__class__.__name__))
    if len(data) > MAX_LOGO_BYTES:
        raise HelperError("logo_too_large", "a logo from %s exceeds %d KB" % (host, MAX_LOGO_BYTES // 1024))
    return data, ctype


# The first bytes each allowed type must begin with. The content type is the
# SERVER's claim about bytes we are about to store and hand to an image
# decoder, and nothing so far has checked the claim against the payload.
#
# Measured on Qt 6.11.2 before this was written: QML's Image loads a local
# file by CONTENT, not by name. An extension-less PNG, GIF and JPEG all reach
# Image.Ready at their true size, and so does a PNG named `.txt`. So the
# extension the cache used to append was never a gate -- a file whose bytes
# are SVG renders as SVG whatever it is called, and Qt's SVG renderer is a
# larger surface than a bitmap decoder.
#
# Checking the magic is the gate the extension only looked like. It is done
# here rather than at write time so a mismatch is refused BEFORE anything
# touches the disk.
LOGO_MAGIC = {
    "image/png": (b"\x89PNG\r\n\x1a\n",),
    "image/jpeg": (b"\xff\xd8\xff",),
    "image/gif": (b"GIF87a", b"GIF89a"),
    # RIFF....WEBP: the size sits between the two, so both halves are checked.
    "image/webp": (b"RIFF",),
}


def logo_bytes_match_type(data: bytes, ctype: str) -> bool:
    """Do these bytes actually begin the way `ctype` says they do?"""
    prefixes = LOGO_MAGIC.get(ctype)
    if not prefixes:
        return False
    if ctype == "image/webp":
        return data[:4] == b"RIFF" and data[8:12] == b"WEBP"
    return any(data.startswith(prefix) for prefix in prefixes)


def write_logo(logo_dir: str, url: str, data: bytes, ctype: str) -> str:
    """Write one logo 0600 into a 0700 directory. Returns the file name.

    The name is the fnv1a32 of the URL and NOTHING else. It used to carry an
    extension implied by the content type, which cost a second source of
    truth: the guide would have had to read an index to turn a channel's logo
    URL into a file name, and that index is a parse inside the 150 ms open
    budget. Qt names nothing from the extension anyway (see LOGO_MAGIC), so
    dropping it removes a file the guide would have had to read and takes
    nothing away.
    """
    if ctype not in LOGO_TYPES:
        raise HelperError("logo_type", "refused an unlisted content type")
    if not logo_bytes_match_type(data, ctype):
        raise HelperError("logo_bytes", "refused bytes that are not %s" % ctype)
    ensure_private_dir(logo_dir)
    name = logo_filename(url)
    path = os.path.join(logo_dir, name)
    write_bytes_atomic(path, data)
    return name


# ---- dead-channel memory (PO 2026-09-24, amending R8 / R11 / UX ruling 9)
#
# Mirror of Model.normalizeFailed / prunedFailed. Must match Model.js.
# The marks live in the SOURCE CACHE, never in state.json: channel ids are
# global across sources, so a state-level map would mark another provider's
# working channel, and it would fall inside D-ID-1's id-rotation blast radius
# which that defect records as excluded precisely because this was
# session-only. Per source, it stays excluded.
MAX_FAILED = 300
FAILED_TTL_SEC = 14 * 24 * 3600


def normalize_failed(rows: Any) -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []
    seen: set[str] = set()
    for row in rows if isinstance(rows, list) else []:
        if not isinstance(row, dict):
            continue
        cid = row.get("id")
        at = coerce_int(row.get("at"))
        if not isinstance(cid, str) or not cid or at is None or at <= 0:
            continue
        if cid in seen:
            continue
        seen.add(cid)
        out.append({"id": cid, "at": at})
        if len(out) >= MAX_FAILED:
            break
    return out


def prune_failed(rows: Any, now: int, known: set[str] | None) -> list[dict[str, Any]]:
    """Drop what aged out and what the playlist no longer has.

    The second half is what makes this self-healing: an id rotation, a
    provider reshuffle and a removed channel all leave marks naming nothing,
    and all three are cleaned up here instead of by a migration. `known` of
    None skips it, so a caller without channels cannot wipe the file.
    """
    out = []
    for row in normalize_failed(rows):
        if now > 0 and row["at"] < now - FAILED_TTL_SEC:
            continue
        if known is not None and row["id"] not in known:
            continue
        out.append(row)
    return out


def read_failed(directory: str) -> list[dict[str, Any]]:
    doc = read_json(os.path.join(directory, FAILED_FILE))
    return normalize_failed(doc.get("failed") if isinstance(doc, dict) else None)


def known_channel_ids(directory: str) -> set[str] | None:
    """The current playlist's ids, or None when there is no cache to ask."""
    doc = read_json(os.path.join(directory, CHANNELS_FILE))
    if not isinstance(doc, dict) or not isinstance(doc.get("channels"), list):
        return None
    return {c["id"] for c in doc["channels"] if isinstance(c, dict) and isinstance(c.get("id"), str) and c["id"]}


def cmd_failed(args: argparse.Namespace) -> int:
    """mark / clear / list the failure marks of one source's cache."""
    directory = cache_dir(args.cache_dir)
    now = int(args.now) if args.now else int(time.time())
    rows = read_failed(directory)
    if args.action == "mark":
        cid = (args.id or "").strip()
        if not cid:
            raise HelperError("bad_id", "a channel id is required")
        rows = [r for r in rows if r["id"] != cid]
        rows.insert(0, {"id": cid, "at": now})
    elif args.action == "clear":
        cid = (args.id or "").strip()
        rows = [] if not cid else [r for r in rows if r["id"] != cid]
    # `list` falls through: pruning and emitting is the whole of it.
    rows = prune_failed(rows, now, known_channel_ids(directory))
    if args.action in ("mark", "clear"):
        ensure_private_dir(directory)
        write_json_atomic(os.path.join(directory, FAILED_FILE), {"version": 1, "failed": rows})
    emit({"ok": True, "kind": "failed", "action": args.action, "count": len(rows), "failed": rows})
    return 0


def cmd_logos(args: argparse.Namespace) -> int:
    directory = cache_dir(args.cache_dir)
    channels = load_channels(directory)
    survey = logo_survey(channels)
    if not args.fetch:
        emit(dict(survey, ok=True, kind="logos", action="survey"))
        return 0
    # The fetch is opt-in twice over: the setting is off by default (the
    # ruling's first line) and this flag is off by default here, so nothing
    # contacts anyone because a command was run without reading it.
    logo_dir = os.path.join(directory, "logos")
    fetched, cached, refused, failed = 0, 0, 0, 0
    reasons: dict[str, int] = {}
    seen: set[str] = set()
    names: list[str] = []
    for channel in channels:
        if fetched >= MAX_LOGO_FILES:
            break
        url = channel.get("logo") if isinstance(channel, dict) else None
        if not isinstance(url, str) or not url or url in seen:
            continue
        seen.add(url)
        # Already on disk: no request. Without this the shell re-downloaded
        # every logo on every start, because the service runs a fetch whenever
        # the channel cache loads -- 1,445 requests to sixty-three third
        # parties per launch, which is precisely the disclosure the ruling
        # exists to bound. The file name is a pure function of the URL, so
        # "have we got this one" is a stat and not a lookup.
        name = logo_filename(url)
        if os.path.exists(os.path.join(logo_dir, name)):
            cached += 1
            names.append(name)
            continue
        try:
            data, ctype = fetch_logo(url, args.timeout)
            names.append(write_logo(logo_dir, url, data, ctype))
            fetched += 1
        except HelperError as error:
            # Hosts and codes only, never the URL (rule 5).
            reasons[error.code] = reasons.get(error.code, 0) + 1
            if error.code in ("logo_scheme", "logo_userinfo", "logo_redirect",
                              "logo_type", "logo_bytes", "logo_too_large"):
                refused += 1
            else:
                failed += 1
    # `names` is what is ON DISK now, and it is the whole reason this command
    # reports anything at all: the guide points an Image at a file only when
    # that file is in this list. Pointing at a missing one is not merely a
    # blank slot -- Qt logs "Cannot open" for every attempt, so one dead logo
    # host fills the user's journal every time the row scrolls into view.
    # Seen live 2026-09-23 before this existed.
    #
    # It carries no URLs, only their hashes, so it is safe on stdout.
    emit(dict(survey, ok=True, kind="logos", action="fetch", fetched=fetched,
              cached=cached, refusedOnPolicy=refused, failed=failed, reasons=reasons,
              names=names, cap=MAX_LOGO_FILES, maxBytes=MAX_LOGO_BYTES))
    return 0


def load_channels(directory: str) -> list[dict[str, Any]]:
    document = read_json(os.path.join(directory, CHANNELS_FILE))
    if not isinstance(document, dict) or not isinstance(document.get("channels"), list):
        raise HelperError("no_cache", "channel cache not found; refresh the playlist first")
    return document["channels"]


def find_channel(channels: list[dict[str, Any]], wanted: str) -> dict[str, Any]:
    for channel in channels:
        if isinstance(channel, dict) and channel.get("id") == wanted:
            return channel
    raise HelperError("unknown_channel", "channel %s is not in the playlist cache" % wanted)


def header_properties(headers: dict[str, Any], client: MpvIpc) -> list[tuple[str, Any]]:
    """Ordered (property, value) pairs applying the channel's HTTP headers.

    Every property is always set: a channel without headers resets
    user-agent / referrer / http-header-fields so nothing leaks from the
    previous channel.
    """
    user_agent = ""
    referrer = ""
    fields: list[str] = []
    for name, value in headers.items():
        if not isinstance(name, str) or not isinstance(value, str) or not _HEADER_NAME.match(name):
            continue
        cleaned = clean_header_value(value)
        lower = name.lower()
        if lower == "user-agent":
            user_agent = cleaned
        elif lower in ("referer", "referrer"):
            referrer = cleaned
        elif cleaned:
            fields.append("%s: %s" % (name, cleaned))
    if not user_agent:
        ok, default = client.try_command("get_property", "option-info/user-agent/default-value")
        user_agent = default if ok and isinstance(default, str) and default else MPV_DEFAULT_USER_AGENT
    return [("user-agent", user_agent), ("referrer", referrer), ("http-header-fields", fields)]


def cmd_play(args: argparse.Namespace) -> int:
    """Zap an already-running player. The wire sequence and the reply shape
    are unchanged (requirement 2); the body is `apply_channel()`, shared
    verbatim with `player start`, so first play and every later zap are one
    implementation instead of two.

    `--scope` / `--since` are additive: with either of them the zap also
    refreshes the now-playing stash inside mpv and the reply carries the new
    `entryId`, which is what makes a reattach after a shell restart name the
    channel the user actually switched to.
    """
    sock = socket_path(args.socket)
    client = MpvIpc(sock, args.ipc_timeout)
    scope = getattr(args, "scope", "") or ""
    since = int(getattr(args, "since", 0) or 0)
    session = bool(scope or since)
    try:
        target = player_target(args.id, args.url, args.cache_dir)
        client.connect()
        stash = None
        if session:
            # D-PLY-11 / the plan's step 2: the seq used to be a hardcoded 0,
            # so the two sides could only be seen to DIFFER, never compared.
            # It is read from the lock record rather than from a `--seq` of
            # this verb's own, because ruling CL4 forbids giving `play` a
            # sequence number (and the lock that would come with it) until
            # refusals are routed. The lock record is a plain file read: no
            # flock, nothing to block on, nothing that can answer `busy`.
            stash = player_stash(target["id"], target["name"], target["group"], scope,
                                 source_key_of(cache_dir(args.cache_dir)), since or int(time.time()),
                                 record_seq(read_lock_file(sock)), verb="play")
        entry_id = apply_channel(client, target, stash=stash, label="play")
        payload: dict[str, Any] = {"ok": True, "kind": "play", "id": args.id or None, "name": target["name"]}
        if session:
            # Additive, and tied to the additive flags: without --scope /
            # --since the reply is byte-identical to v0.2.1's.
            payload["entryId"] = entry_id
        emit(payload)
        return EXIT_OK
    except HelperError as error:
        log("play: %s" % error.message)
        emit(error_payload("play", error, id=args.id or None))
        return EXIT_ERROR
    finally:
        client.close()


def cmd_stop(args: argparse.Namespace) -> int:
    client = MpvIpc(socket_path(args.socket), args.ipc_timeout)
    try:
        client.connect()
        reply = client.request(["quit"], allow_close=True)
        if reply.get("error") != "success":
            raise HelperError("ipc_error", "mpv refused quit: %s" % reply.get("error"))
        emit({"ok": True, "kind": "stop"})
        return EXIT_OK
    except HelperError as error:
        log("stop: %s" % error.message)
        emit(error_payload("stop", error))
        return EXIT_ERROR
    finally:
        client.close()


def unlink_stale_socket(path: str) -> bool:
    try:
        if stat.S_ISSOCK(os.lstat(path).st_mode):
            os.unlink(path)
            return True
    except OSError:
        pass
    return False


def cmd_status(args: argparse.Namespace) -> int:
    path = socket_path(args.socket)
    client = MpvIpc(path, args.ipc_timeout)
    try:
        try:
            client.connect()
        except HelperError as error:
            if client.refused and unlink_stale_socket(path):
                log("status: removed stale socket file")
            raise
        values: dict[str, Any] = {}
        for prop in ("media-title", "path", "pause", "idle-active", "mpv-version", USER_DATA_STASH):
            ok, data = client.try_command("get_property", prop)
            values[prop] = data if ok else None
        path_value = values["path"]
        emit({
            "ok": True,
            "kind": "status",
            "running": True,
            "mediaTitle": values["media-title"] if isinstance(values["media-title"], str) else None,
            "pathHost": (url_host(path_value) or ("local file" if path_value.startswith("/") else "")) if isinstance(path_value, str) and path_value else None,
            "paused": bool(values["pause"]) if values["pause"] is not None else None,
            "idle": bool(values["idle-active"]) if values["idle-active"] is not None else None,
            "mpvVersion": values["mpv-version"] if isinstance(values["mpv-version"], str) else None,
            # The reconciliation input ARCHITECTURE-PLAYER.md (dev branch) 271-273
            # specified and the code never grew: the health tick already asks
            # the player a question every few seconds, and until now the one
            # thing it never asked was WHICH CHANNEL. Never a URL - the record
            # carries the channel id, the name and the scope and nothing else.
            "stash": values[USER_DATA_STASH] if isinstance(values[USER_DATA_STASH], dict) else None,
        })
        return EXIT_OK
    except HelperError as error:
        # `running` keeps its socket-answered meaning (Model.statusHealthy and
        # the 23 test_mpv.py (dev branch tests) cases depend on it). `process` is additive
        # and says whether the player is gone or merely wedged, so the health
        # verdict does not need a second call (4.13).
        found = find_player(path)
        log("status: %s" % error.message)
        emit(error_payload("status", error, running=False,
                           process={"found": bool(found), "pid": int(found[0]["pid"]) if found else None}))
        return EXIT_ERROR
    finally:
        client.close()


# --------------------------------------------------------------- player
# The detached player (ARCHITECTURE-PLAYER.md (dev branch)). mpv runs as a setsid'd
# grandchild of this helper, reparented to the session subreaper, so it
# outlives every shell restart and is still reaped at logout by the
# compositor's own cgroup. The shell observes it over mpv's JSON IPC socket.
#
# Nothing channel-specific is ever on mpv's command line: the URL, the headers
# and the title travel over the 0600 socket instead (S-03, requirement 9).
# Every verb is idempotent, serialised by one flock with an inode re-check,
# and ordered by the caller's --seq intent number rather than by the order the
# kernel happens to grant the lock in.

PLAYER_LOCK_FILE = "player.lock"
PLAYER_STASH_SCHEMA = 1
# Two sibling top-level user-data nodes (4.6), probe-verified on mpv 0.41: a
# second client reads back the identical object, the top level is not
# writable, and there is no delete. The record dies with the process it
# describes, which is exactly why it is not a file on disk.
USER_DATA_STASH = "user-data/omarchy-iptv"
USER_DATA_OWNER = "user-data/omarchy-iptv-owner"
PLAYER_GENERIC_FAILURE = "Playback stopped unexpectedly"   # mirrors Model.PLAYER_GENERIC_FAILURE
# The D-LIVE-17 ladder, unchanged: quit at 0, SIGTERM at 2 s, SIGKILL at 4 s.
STOP_QUIT_GRACE_MS = 2000
STOP_KILL_GRACE_MS = 2000
STOP_SETTLE_MS = 500
DEFAULT_LOCK_TIMEOUT = 6.0
DEFAULT_SPAWN_TIMEOUT = 5.0
DEFAULT_FIRST_LOAD_TIMEOUT = 3.0
DEFAULT_ORPHAN_GRACE = 6.0
LOCK_POLL_S = 0.05
LOCK_RETRIES = 5
# X1/X2: the two settle call sites that hold no lock of their own take one
# briefly. Short on purpose - a probe that cannot have it simply does not
# unlink, which is the safe half of the decision.
SETTLE_LOCK_TIMEOUT = 0.5
SPAWN_POLL_S = 0.02
STOP_POLL_S = 0.05
LAUNCH_STDERR_MAX = 4096          # PO-6: the launch window's stderr, memory only
PLAYER_UMASK = 0o077              # PO-11: 0600 files / 0700 dirs, requirement 10
# Mirror of Model.splitMpvArgs (4.12). The helper re-validates every
# --mpv-arg because bin/omarchy-iptv is a public CLI, and a parity test pins
# the two reserved sets equal.
MPV_ARG_RE = re.compile(r"^--[a-z0-9][a-z0-9-]*(=.*)?$")
MPV_RESERVED = frozenset((
    "--input-ipc-server", "--wayland-app-id", "--title", "--force-media-title",
    "--idle", "--input-ipc-client", "--script", "--scripts", "--config-dir",
    # D-SINK-4: reserved rather than merely defaulted off. `--load-scripts=no`
    # is in the base argv, but user mpv_args are concatenated AFTER it, so a
    # pasted `--load-scripts=yes` would win and put the credentialed stream
    # URL back on the session bus via mpv-mpris. Unlike --ytdl (PO-5) this one
    # guards a credential and has no legitimate counter-position.
    "--load-scripts",
    # D-SINK-2: --script is mpv's ALIAS for --scripts-append, so naming only
    # the alias reserved nothing. Matching is by base name now (see
    # filter_mpv_args), and --include loads a config that can set any of these.
    "--include",
    "--log-file", "--dump-stats", "--stream-record", "--save-position-on-quit",
    "--watch-later-dir", "--osd-msg1", "--osd-msg2", "--osd-msg3",
    "--term-status-msg", "--screenshot-template",
))
PLAYER_VERBS = ("start", "stop", "restart", "probe", "orphan-check", "pause")
# Mirror of Model.MPV_HANDOFF and friends (PO-10, D-PLY-5). These options are
# allowed - PO-5 keeps `--ytdl` as the documented escape hatch for links that
# are not direct streams - but each one puts the credentialed stream address
# on a SECOND program's command line, so the user is told at the moment the
# option is in force. Pinned to the JavaScript by the `mpvHandoff` vectors in
# the player-argv.json. fixture (dev branch)
MPV_HANDOFF = frozenset(("--ytdl-format", "--ytdl-raw-options"))
MPV_HANDOFF_SCRIPT_OPTS = frozenset(("--script-opts", "--script-opt"))
MPV_YTDL_OFF = frozenset(("no", "0", "false"))
MPV_HANDOFF_TEXT = " hands the stream address to another program"
MPV_LIST_SUFFIX_RE = re.compile(r"-(add|append|set|pre|clr|del|remove|toggle)$")


def _monotonic() -> float:
    """Indirection so tests can drive the stop ladder with a fake clock."""
    return time.monotonic()


def _sleep(seconds: float) -> None:
    if seconds > 0:
        time.sleep(seconds)


def filter_mpv_args(tokens: list[str]) -> tuple[list[str], list[str]]:
    """Mirror of Model.splitMpvArgs on already-split tokens."""
    args: list[str] = []
    rejected: list[str] = []
    for token in tokens or []:
        text = str(token)
        name = text.split("=", 1)[0]
        # D-SINK-2: the BASE name decides. `mpv_option_base` was defined
        # fifteen lines below this filter and never used by it, so
        # `--scripts-append` -- which mpv's own --list-options calls the
        # option that `--script` is an ALIAS for -- was accepted here and by
        # the JavaScript mirror.
        base = mpv_option_base(name)
        bare = "--" + name[5:] if name.startswith("--no-") else ""
        no_form = bool(bare) and (bare in MPV_RESERVED or mpv_option_base(bare) in MPV_RESERVED)
        if not MPV_ARG_RE.match(text) or name in MPV_RESERVED or base in MPV_RESERVED or no_form:
            rejected.append(text)
        else:
            args.append(text)
    return args, rejected


def mpv_option_base(name: str) -> str:
    """Mirror of Model.mpvOptionBase: `--opt-append` and `--opt-set` set the
    same option `--opt` does, so the base name is what decides."""
    return MPV_LIST_SUFFIX_RE.sub("", str(name))


def mpv_arg_hands_off_url(token: str) -> str:
    """Mirror of Model.mpvHandoffName. "" when the token is harmless, else the
    option NAME. The VALUE is never returned: it can carry a credentialed URL
    of its own (a proxy in --ytdl-raw-options) and a warning is a sink (R12).
    """
    text = str(token)
    name, _, value = text.partition("=")
    if name.startswith("--no-"):          # --no-ytdl turns the handoff OFF
        return ""
    base = mpv_option_base(name)
    if base == "--ytdl":
        return "" if value.lower() in MPV_YTDL_OFF else name
    if base in MPV_HANDOFF:
        return name
    if base in MPV_HANDOFF_SCRIPT_OPTS:
        return name if "ytdl" in value else ""
    return ""


def mpv_arg_warnings(tokens: list[str]) -> list[str]:
    """Mirror of Model.mpvArgWarnings: one line per distinct option, in the
    order the user wrote them."""
    seen: set[str] = set()
    out: list[str] = []
    for token in tokens or []:
        name = mpv_arg_hands_off_url(token)
        if not name or name in seen:
            continue
        seen.add(name)
        out.append("mpvArg " + name + MPV_HANDOFF_TEXT)
    return out


def player_dirs(sock_path: str, state_override: str | None = None) -> dict[str, str]:
    """Where the player is allowed to write (PO-11, D-PLY-7).

    mpv's own key bindings are live on its window and two of them write a
    durable file: `s` takes a screenshot and `Q` (quit-watch-later) writes a
    resume record. Both used to land wherever the shell happened to be - the
    user's home for the screenshot, mpv's own ~/.local/state/mpv tree for the
    resume record - at mode 0644, outside every list of files this plugin
    says it writes.

    - `cwd` is the runtime directory (0700, already ensured for the socket).
      It is where anything relative still lands, so a cwd-relative write we
      have not anticipated goes somewhere private and disappears at logout
      instead of accumulating in $HOME.
    - `screenshots` is durable on purpose: a screenshot is something the user
      asked for, so the runtime directory would be data loss at logout. It
      lives under the state directory this plugin already owns and documents.
    - `watchLater` is a resume position for a live stream, which is never
      worth keeping: ephemeral, private, gone at logout.
    - `shaderCache` is D-PLY-10, ruling CL2: mpv compiles its shaders into
      $XDG_CACHE_HOME/mpv/ otherwise, which is outside every list of files
      this plugin says it writes. A shader cache is content-free and
      regenerable - it is not keyed to anything that was watched - so the
      runtime directory is the right home: already 0700, already documented,
      gone at logout, and it adds NO durable path and nothing to clean up at
      uninstall. Containment here is a sensible default, not a guarantee:
      neither option is reserved, because MPV_RESERVED is a privacy
      instrument and a content-free cache does not belong on it (CL2).
    """
    runtime = os.path.dirname(sock_path)
    return {
        "cwd": runtime,
        "screenshots": os.path.join(state_dir(state_override), "screenshots"),
        "watchLater": os.path.join(runtime, "watch-later"),
        "shaderCache": os.path.join(runtime, "shader-cache"),
    }


def mpv_launch_argv(sock_path: str, mpv_args: list[str],
                    dirs: dict[str, str] | None = None) -> list[str]:
    """Mirror of Model.buildMpvArgv, pinned by the player-argv.json. fixture (dev branch)

    No URL, no "--", no header options, no per-channel title: the first
    channel arrives over IPC like every later one (S-03). `--idle=once` (PO-1)
    idles at startup and still exits when the playlist finishes, which keeps
    today's UX and the degraded status-poll fallback.

    The two output directories (PO-11) are fixed options, so a user who wants
    their screenshots elsewhere can still say so: `--screenshot-dir` is not
    reserved and user tokens land after these. `--watch-later-dir` IS
    reserved, because a resume record naming a stream path has no business
    being redirected back into $HOME.

    The two cache directories are D-PLY-10 / CL2, in the same shape and for
    the same reason: mpv's shader and ICC caches default into
    $XDG_CACHE_HOME/mpv/, outside this plugin's tree. Neither is reserved -
    both are content-free - so a user token can still point them elsewhere.
    """
    where = dirs or player_dirs(sock_path)
    return [
        "mpv",
        "--input-ipc-server=%s" % sock_path,
        "--wayland-app-id=omarchy-iptv",
        "--force-window=immediate",
        "--idle=once",
        "--keep-open=no",
        "--title=%sIPTV" % MPV_RAW_PREFIX,
        "--force-media-title=IPTV",
        "--msg-level=all=error",
        "--ytdl=no",
        # D-SINK-4. mpv autoloads every script in its system directory, which
        # here includes mpv-mpris; it publishes `xesam:url` -- the stream URL,
        # credentials and all -- on the session bus for as long as a channel
        # plays. Measured on the real bus. mpv-mpris has no configuration
        # surface, so keeping it and not leaking is not available, and this
        # plugin loads no script of its own. Cost: Omarchy's media widget
        # stops showing the channel, which the bar widget already shows.
        "--load-scripts=no",
        "--screenshot-dir=%s" % where["screenshots"],
        "--watch-later-dir=%s" % where["watchLater"],
        "--gpu-shader-cache-dir=%s" % where["shaderCache"],
        "--icc-cache-dir=%s" % where["shaderCache"],
    ] + list(mpv_args or [])


def stop_escalation(stage: str) -> dict[str, Any]:
    """Mirror of Model.stopEscalation (the reducer of record)."""
    text = stage or ""
    if text == "":
        return {"action": "quit", "signal": 0, "waitMs": STOP_QUIT_GRACE_MS}
    if text == "quit":
        return {"action": "term", "signal": 15, "waitMs": STOP_KILL_GRACE_MS}
    if text == "term":
        return {"action": "kill", "signal": 9, "waitMs": 0}
    return {"action": "kill", "signal": 0, "waitMs": 0}


def ended_verdict(end_file: dict[str, Any] | None, user_stopped: bool = False,
                  stopping: bool = False) -> dict[str, Any]:
    """Mirror of Model.endedVerdict (4.8): why the player ended.

    The entry id is deliberately not consulted - it decides which channel the
    message names, never whether there is one (F4, the gate fails open).
    """
    if user_stopped or stopping:
        return {"notify": False, "reason": "", "kind": "silent"}
    if not isinstance(end_file, dict):
        return {"notify": True, "reason": PLAYER_GENERIC_FAILURE, "kind": "failed"}
    reason = str(end_file.get("reason") or "")
    if reason == "redirect":
        # The .m3u8 master resolution IPTV uses most: never terminal.
        return {"notify": False, "reason": "", "kind": "ignored"}
    if reason in ("quit", "eof"):
        return {"notify": False, "reason": "", "kind": "silent"}
    detail = redact_urls(end_file.get("fileError") or end_file.get("file_error") or "").strip()
    return {"notify": True, "reason": detail or PLAYER_GENERIC_FAILURE, "kind": "failed"}


def player_stash(channel_id: str, name: str, group: str, scope: str, source_key: str,
                 since: int, seq: int, entry_id: int | None = None,
                 playing: bool = True, verb: str = "play") -> dict[str, Any]:
    """Mirror of Model.playerStash: the now-playing record mpv carries for us.

    `launchedFrom` is the zap-ring scope - pure UI intent no mpv property
    could ever report, which is why the shell's own value is stashed here and
    echoed back on reattach.

    `verb` says which slot wrote the record last, and it exists because `seq`
    stopped being able to say so. The zap used to hardcode `seq` to 0, which
    made "not zero" a usable stand-in for "a player verb wrote this" - the
    reading wave two's evidence leaned on. Now that both sides carry a real
    intent number the two can be COMPARED, which is the point, but the
    writer has to be named outright rather than inferred from a zero.
    """
    return {
        "schema": PLAYER_STASH_SCHEMA,
        "playing": bool(playing),
        "id": str(channel_id or ""),
        "name": str(name or ""),
        "group": str(group or ""),
        "launchedFrom": str(scope or ""),
        "sourceKey": str(source_key or ""),
        "since": int(since or 0),
        "entryId": entry_id if isinstance(entry_id, int) and entry_id > 0 else None,
        "seq": int(seq or 0),
        "verb": str(verb or ""),
    }


def source_key_of(directory: str) -> str:
    """The source key a per-source cache directory belongs to, so the stash
    can say which playlist the channel id resolves against without the URL
    or the key crossing a command line of its own."""
    parent, base = os.path.split(os.path.normpath(directory or ""))
    if os.path.basename(parent) == SOURCES_DIR and SOURCE_KEY_RE.match(base or ""):
        return base
    return ""


# ------------------------------------------------------- process discovery
# `connect()` only ever answers "responsive": it succeeds through the listen
# backlog against a wedged mpv. The authoritative existence check is a /proc
# scan for our exact --input-ipc-server token plus our uid, which is also the
# only way to obtain a pid for an mpv whose IPC is dead - the very case the
# stop ladder exists for.

def proc_cmdline(pid: int) -> list[str]:
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as handle:
            raw = handle.read()
    except OSError:
        return []
    return [part.decode("utf-8", "replace") for part in raw.split(b"\0") if part]


def proc_start_time(pid: int) -> str:
    """Field 22 of /proc/<pid>/stat, read after the last ')' so a comm
    containing spaces or parentheses cannot shift the fields."""
    try:
        with open("/proc/%d/stat" % pid, "rb") as handle:
            data = handle.read().decode("utf-8", "replace")
    except OSError:
        return ""
    close = data.rfind(")")
    if close == -1:
        return ""
    fields = data[close + 1:].split()
    return fields[19] if len(fields) > 19 else ""


def proc_is_ours(pid: int) -> bool:
    try:
        return os.stat("/proc/%d" % pid).st_uid == os.getuid()
    except OSError:
        return False


def find_player(sock_path: str) -> list[dict[str, Any]]:
    """Every live process of ours whose argv carries our exact socket token."""
    token = "--input-ipc-server=%s" % sock_path
    found: list[dict[str, Any]] = []
    try:
        entries = os.listdir("/proc")
    except OSError:
        return found
    mine = os.getpid()
    for entry in entries:
        if not entry.isdigit():
            continue
        pid = int(entry)
        if pid == mine:
            continue
        if token not in proc_cmdline(pid) or not proc_is_ours(pid):
            continue
        found.append({"pid": pid, "startTime": proc_start_time(pid)})
    found.sort(key=lambda record: record["pid"])
    return found


def still_the_player(record: dict[str, Any], sock_path: str) -> bool:
    """Re-verified immediately before every signal: pid alive, same start
    time, same socket token, same uid - so a recycled pid is never signalled."""
    pid = int(record.get("pid") or 0)
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    if not proc_is_ours(pid):
        return False
    recorded = str(record.get("startTime") or "")
    if recorded and proc_start_time(pid) != recorded:
        return False
    return ("--input-ipc-server=%s" % sock_path) in proc_cmdline(pid)


# ------------------------------------------------------------------ lock

def player_lock_path(sock_path: str) -> str:
    return os.path.join(os.path.dirname(sock_path), PLAYER_LOCK_FILE)


def acquire_lock(path: str, timeout: float) -> int:
    """flock with an inode re-check.

    A plain flock is defeated by unlinking the lock file and recreating it:
    the winner then holds a lock on an orphaned inode while a second launcher
    locks the new one. After every grant we compare fstat(fd) with stat(path)
    and start over when they differ. The kernel releases the lock on any
    death including SIGKILL, so it can never go stale.
    """
    deadline = _monotonic() + max(0.0, float(timeout))
    for _ in range(LOCK_RETRIES):
        fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            os.fchmod(fd, 0o600)
        except OSError:
            pass
        granted = False
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                granted = True
                break
            except OSError as error:
                if error.errno not in (errno.EAGAIN, errno.EACCES, errno.EWOULDBLOCK):
                    os.close(fd)
                    raise HelperError("busy", "could not lock the player: %s" % (error.strerror or error))
                if _monotonic() >= deadline:
                    break
                _sleep(LOCK_POLL_S)
        if not granted:
            os.close(fd)
            raise HelperError("busy", "another player command holds the lock")
        try:
            same_inode = os.fstat(fd).st_ino == os.stat(path).st_ino
        except OSError:
            same_inode = False
        if same_inode:
            return fd
        os.close(fd)
        if _monotonic() >= deadline:
            break
    raise HelperError("busy", "the player lock file kept being replaced")


def release_lock(fd: int) -> None:
    try:
        os.close(fd)
    except OSError:
        pass


def read_lock_record(fd: int) -> dict[str, Any]:
    try:
        os.lseek(fd, 0, os.SEEK_SET)
        raw = os.read(fd, 4096)
    except OSError:
        return {}
    try:
        document = json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError):
        return {}
    return document if isinstance(document, dict) else {}


def read_lock_file(sock_path: str) -> dict[str, Any]:
    """The record without taking the lock (probe is lock-free)."""
    try:
        with open(player_lock_path(sock_path), "rb") as handle:
            document = json.loads(handle.read().decode("utf-8"))
    except (OSError, ValueError, UnicodeDecodeError):
        return {}
    return document if isinstance(document, dict) else {}


def record_seq(record: dict[str, Any]) -> int:
    value = record.get("seq")
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        return 0
    return value


def write_lock_record(fd: int, seq: int, verb: str) -> None:
    payload = json.dumps({"schema": 1, "seq": int(seq), "verb": verb, "at": int(time.time())})
    try:
        os.lseek(fd, 0, os.SEEK_SET)
        os.truncate(fd, 0)
        os.write(fd, payload.encode("utf-8"))
    except OSError:
        pass


def check_seq(record: dict[str, Any], seq: int, verb: str) -> None:
    """Ordering by issue time, not by lock-grant order (4.10): a verb whose
    intent number is older than the recorded one does nothing at all."""
    if seq > 0 and record_seq(record) > seq:
        raise HelperError("superseded", "intent %d is older than the recorded %d" % (seq, record_seq(record)))


# ----------------------------------------------------------------- spawn

def _read_pipe(fd: int, timeout: float) -> bytes:
    chunks: list[bytes] = []
    deadline = time.monotonic() + timeout
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        try:
            ready, _, _ = select.select([fd], [], [], remaining)
        except OSError:
            break
        if not ready:
            break
        try:
            chunk = os.read(fd, 4096)
        except OSError:
            break
        if not chunk:
            break
        chunks.append(chunk)
    return b"".join(chunks)


def spawn_detached(argv: list[str], cwd: str = "/") -> dict[str, Any]:
    """setsid + double fork, and the fd hygiene that makes it survivable.

    The grandchild reports its own pid over a pipe (so a spawn that never
    binds a socket is still reapable by the helper that created it), reports
    an exec failure over a CLOEXEC pipe (restoring the error
    Quickshell.execDetached throws away - it returns void), keeps its stderr
    on a pipe for the launch window only (PO-6), puts /dev/null on stdin and
    stdout and closes every other inherited descriptor before execvp - which
    is what guarantees mpv never holds a Quickshell StdioCollector pipe for
    hours and dies of BrokenPipeError at the restart it exists to survive.

    argv[0] is the literal "mpv", never caller-supplied, so `player start` is
    not an arbitrary-exec verb.

    PO-11: the working directory is explicit, never inherited. A process that
    inherits the shell's cwd is running in the user's home, and mpv's own key
    bindings write files relative to it. The umask is explicit for the same
    reason: mpv creates whatever it writes with the process umask, which is
    0022 under the shell and gave D-PLY-7 its world-readable 0644 screenshot.
    0o077 puts every file the player creates at 0600 and every directory it
    creates at 0700, matching requirement 10. `chdir` failing must never
    leave us in the inherited directory, so "/" is the fallback.
    """
    pid_r, pid_w = os.pipe()
    err_r, err_w = os.pipe2(os.O_CLOEXEC)
    log_r, log_w = os.pipe()
    child = os.fork()
    if child == 0:                                        # pragma: no cover
        try:
            os.setsid()
            if os.fork() > 0:
                os._exit(0)
            os.write(pid_w, str(os.getpid()).encode("ascii"))
            os.close(pid_w)
            os.umask(PLAYER_UMASK)
            try:
                os.chdir(cwd or "/")
            except OSError:
                os.chdir("/")
            devnull = os.open(os.devnull, os.O_RDWR)
            os.dup2(devnull, 0)
            os.dup2(devnull, 1)
            os.dup2(log_w, 2)
            # Once this helper exits nobody reads that pipe; an ignored
            # SIGPIPE (inherited through execve) keeps a failed diagnostic
            # write from ever killing the player.
            signal.signal(signal.SIGPIPE, signal.SIG_IGN)
            try:
                limit = int(os.sysconf("SC_OPEN_MAX"))
            except (ValueError, OSError):
                limit = 4096
            for fd in range(3, min(limit, 4096)):
                if fd == err_w:
                    continue
                try:
                    os.close(fd)
                except OSError:
                    pass
            os.execvp("mpv", argv)
        except BaseException as error:                    # noqa: BLE001 - reported over the pipe
            number = getattr(error, "errno", 0) or 0
            try:
                os.write(err_w, str(int(number)).encode("ascii"))
            except OSError:
                pass
        os._exit(127)
    os.close(pid_w)
    os.close(err_w)
    os.close(log_w)
    try:
        os.waitpid(child, 0)                              # the intermediate child, never a zombie
    except OSError:
        pass
    pid_text = _read_pipe(pid_r, 2.0).decode("ascii", "replace").strip()
    os.close(pid_r)
    failure = _read_pipe(err_r, DEFAULT_SPAWN_TIMEOUT).decode("ascii", "replace").strip()
    os.close(err_r)
    pid = int(pid_text) if pid_text.isdigit() else 0
    if failure:
        os.close(log_r)
        number = int(failure) if failure.isdigit() else 0
        if number == errno.ENOENT:
            raise HelperError("mpv_missing", "mpv is not installed")
        raise HelperError("spawn_failed", "could not start mpv: %s" % (os.strerror(number) if number else "exec failed"))
    if pid <= 0:
        os.close(log_r)
        raise HelperError("spawn_failed", "the player did not report a pid")
    os.set_blocking(log_r, False)
    return {"pid": pid, "stderrFd": log_r}


def drain_launch_stderr(fd: int, buffer: list[str]) -> None:
    """PO-6: whatever mpv said while starting, redacted, memory only, capped.
    Kept drained so a chatty mpv can never block on a full pipe."""
    while True:
        try:
            chunk = os.read(fd, 4096)
        except (BlockingIOError, OSError):
            return
        if not chunk:
            return
        text = redact_urls(chunk.decode("utf-8", "replace"))
        room = LAUNCH_STDERR_MAX - sum(len(part) for part in buffer)
        if room > 0:
            buffer.append(text[:room])


def launch_reason(buffer: list[str]) -> str:
    lines = [line.strip() for line in "".join(buffer).splitlines() if line.strip()]
    return lines[-1] if lines else ""


# ------------------------------------------------------------ connection

def probe_client(sock_path: str, ipc_timeout: float) -> MpvIpc | None:
    """A connected client that actually answered, or None."""
    client = MpvIpc(sock_path, ipc_timeout)
    try:
        client.connect()
        ok, _ = client.try_command("get_property", "mpv-version")
        if ok:
            return client
    except HelperError:
        pass
    client.close()
    return None


def wait_for_socket(sock_path: str, timeout: float, ipc_timeout: float,
                    stderr_fd: int = -1, stderr_buffer: list[str] | None = None) -> MpvIpc | None:
    deadline = time.monotonic() + max(0.0, timeout)
    while True:
        if stderr_fd >= 0 and stderr_buffer is not None:
            drain_launch_stderr(stderr_fd, stderr_buffer)
        client = probe_client(sock_path, ipc_timeout)
        if client is not None:
            return client
        if time.monotonic() >= deadline:
            return None
        time.sleep(SPAWN_POLL_S)


def quit_over_ipc(sock_path: str, ipc_timeout: float) -> bool:
    client = MpvIpc(sock_path, ipc_timeout)
    try:
        client.connect()
        client.request(["quit"], allow_close=True)
        return True
    except HelperError:
        return False
    finally:
        client.close()


def socket_is_dead(sock_path: str) -> bool:
    client = MpvIpc(sock_path, 0.2)
    try:
        client.connect()
    except HelperError:
        return client.refused or not os.path.exists(sock_path)
    finally:
        client.close()
    return False


def settle_socket(sock_path: str, deadline: float | None = None) -> bool:
    """Unlink the socket only once nothing is listening and nothing of ours
    is running (S_ISSOCK-guarded), so a racing start's fresh socket is never
    deleted. mpv never unlinks its own socket on any exit path.

    D-PLY-8: after a SIGKILL those two facts do not become true at the same
    instant. A killed process runs exit_mm first, so its command line is
    already empty at the first sample - 0.13-0.31 ms, 8/8 on real headless
    mpv 0.41 here - while its listening socket stays bound for another
    2.7-4.9 ms (and far longer for a windowed player, which tears down a GPU
    context, a Wayland connection and decoder buffers as well). The stop path
    asks both questions 4.5-7.5 ms after the kill: one /proc scan (3.7-4.9 ms
    for 225 pids on this box) after wait_for_exit wins on its first check.
    Ask once and the answer can be "not yet", after which nothing asks again
    and the socket file is left on disk until the next helper call.

    So with a `deadline` both guards are re-checked until they agree or the
    time is up. This NEVER widens the conditions - a racing spawn seen by
    find_player, a successful connect (a wedged player answering through its
    backlog) and a timed-out connect all still block the unlink, every
    iteration - it only stops giving up after one look.

    With `deadline=None` the behaviour is byte-identical to before: one check
    of each guard, no sleep. That is what every call site outside the stop
    ladder gets.

    The deadline is absolute and comes from the rung that is already waiting
    (4.9), so the settle spends time the ladder had reserved and never adds
    any. Worst case it overruns by one refused-connect timeout, the 0.2 s
    inside socket_is_dead, which is bounded and cannot repeat.
    """
    while True:
        if find_player(sock_path):
            return False
        if socket_is_dead(sock_path):
            return unlink_stale_socket(sock_path)
        if deadline is None or _monotonic() >= deadline:
            return False
        _sleep(min(STOP_POLL_S, max(0.0, deadline - _monotonic())))


def settle_under_lock(sock_path: str, deadline: float | None = None,
                      lock_timeout: float = SETTLE_LOCK_TIMEOUT) -> bool:
    """The settle for the two call sites that hold no lock of their own
    (X1/X2, ruling CL8).

    The unlink is only safe with the player lock held across the check AND
    the unlink: a `player start` that binds a fresh socket between this
    settle's refused connect and its os.unlink would have the NEW socket
    deleted. player_stop has always been safe that way (it settles inside its
    own lock); player_probe and player_orphan_check were not.

    A call site that cannot take the lock does not unlink. Another verb owns
    the socket at this instant and will settle it itself, and neither of
    these two verbs is worth failing over a leftover file.
    """
    try:
        lock_fd = acquire_lock(player_lock_path(sock_path), lock_timeout)
    except (HelperError, OSError):
        return False
    try:
        return settle_socket(sock_path, deadline)
    finally:
        release_lock(lock_fd)


def wait_for_exit(targets: list[dict[str, Any]], sock_path: str, wait_ms: int) -> bool:
    deadline = _monotonic() + max(0, int(wait_ms)) / 1000.0
    while True:
        if not any(still_the_player(record, sock_path) for record in targets):
            return True
        if _monotonic() >= deadline:
            return False
        _sleep(STOP_POLL_S)


def signal_targets(targets: list[dict[str, Any]], sock_path: str, number: int) -> bool:
    sent = False
    for record in targets:
        if not still_the_player(record, sock_path):
            continue
        try:
            os.kill(int(record["pid"]), number)
            sent = True
        except OSError:
            continue
    return sent


STOP_STAGE_BEFORE = {"": "", "quit": "", "term": "quit", "kill": "term"}


def stop_ladder(sock_path: str, targets: list[dict[str, Any]], from_rung: str = "",
                ipc_timeout: float = DEFAULT_IPC_TIMEOUT) -> dict[str, Any]:
    """The whole D-LIVE-17 ladder inside one process (4.9).

    quit at 0, SIGTERM at 2 s, SIGKILL at 4 s - the same timeline as today,
    but no rung can be starved by a busy control channel, the ladder finishes
    even if the shell dies one millisecond after issuing it, and the pid comes
    from /proc rather than from `get_property pid`, so a wedged mpv (the case
    the ladder exists for, where IPC is by definition dead) is reachable.
    `stop_escalation()` drives the rungs so the shared vectors really govern.

    `deadline` in the reply is the absolute monotonic instant the rung that
    actually ran would have kept waiting until. The kill rung reserves 500 ms
    (`stop_escalation("term")` gives waitMs 0, so `grace` falls back to
    STOP_SETTLE_MS) and spends about 0.3 ms of it, because wait_for_exit
    checks before it sleeps and a killed process is gone at once. Handing
    that instant to the settle (D-PLY-8) spends time the ladder had already
    reserved rather than adding any, so the stop cannot run longer than the
    published timeline whatever the teardown does.
    """
    result: dict[str, Any] = {"rung": "", "running": True, "deadline": None}
    stage = STOP_STAGE_BEFORE.get(from_rung or "", "")
    for _ in range(3):
        step = stop_escalation(stage)
        action = str(step["action"])
        # Each rung's grace is measured from the rung's OWN start, so the
        # next one lands where the timeline says it does. The quit rung is
        # the reason: against an unresponsive player `request(["quit"])`
        # spends the whole --ipc-timeout before anything is waited for, and
        # that cost sat OUTSIDE the 2 s grace - so SIGTERM arrived at 4 s,
        # SIGKILL at 6 s, and a wedged player took ~6.27 s to reap against a
        # 4.5 s budget. Counting it inside costs a responsive player nothing
        # (it answers `quit` at once and exits in about a third of a second,
        # with the full grace still ahead of it) and keeps the guarantee
        # that it is asked politely first.
        rung_started = _monotonic()
        grace = int(step["waitMs"]) or STOP_SETTLE_MS
        # Recorded before the rung acts, so every exit below reports the
        # window this rung owned - including the one where there was nothing
        # left to signal, which is precisely when a socket can still be bound
        # by a process the finder can no longer see.
        result["deadline"] = rung_started + grace / 1000.0
        if action == "quit":
            quit_over_ipc(sock_path, ipc_timeout)
            result["rung"] = "quit"
        elif step["signal"]:
            if not signal_targets(targets, sock_path, int(step["signal"])):
                result["running"] = False
                return result
            result["rung"] = action
        else:
            break
        spent = int((_monotonic() - rung_started) * 1000.0)
        if wait_for_exit(targets, sock_path, max(0, grace - spent)):
            result["running"] = False
            return result
        stage = action
    result["deadline"] = _monotonic() + STOP_SETTLE_MS / 1000.0
    result["running"] = not wait_for_exit(targets, sock_path, STOP_SETTLE_MS)
    return result


# ------------------------------------------------------------- the channel

def player_target(channel_id: str, raw_url: str, directory: str) -> dict[str, Any]:
    """Resolve the channel the helper will play. The URL is read from the
    0600 cache by the helper itself and never crosses a process boundary."""
    if channel_id:
        channel = find_channel(load_channels(cache_dir(directory)), channel_id)
        url = str(channel.get("url") or "")
        name = str(channel.get("name") or "") or url_host(url) or "channel"
        headers = channel.get("headers") if isinstance(channel.get("headers"), dict) else {}
        group = str(channel.get("group") or "")
    else:
        url = (raw_url or "").strip()
        name = url_host(url) or "stream"
        headers = {}
        group = ""
    if not is_stream_url(url):
        raise HelperError("unsupported_scheme", "unsupported stream URL scheme '%s'" % (stream_scheme(url) or "none"))
    return {"id": channel_id or "", "url": url, "name": name, "headers": headers, "group": group}


def apply_channel(client: MpvIpc, target: dict[str, Any], stash: dict[str, Any] | None = None,
                  owner: dict[str, Any] | None = None, label: str = "play") -> int | None:
    """The wire sequence of a zap, shared verbatim by `play` and
    `player start` so first play and every later zap are one implementation.

    title -> force-media-title -> the three header properties (always all
    three, so a channel without headers actively resets the previous one's,
    which is requirement 7's clearing mechanism) -> the stash -> loadfile ->
    the stash again with the entry id -> the owner claim.
    """
    for prop, value in (("title", MPV_RAW_PREFIX + target["name"]), ("force-media-title", target["name"])):
        ok, _ = client.try_command("set_property", prop, value)
        if not ok:
            log("%s: mpv refused to set %s" % (label, prop))
    for prop, value in header_properties(target["headers"], client):
        client.command("set_property", prop, value)
    if stash is not None:
        client.try_command("set_property", USER_DATA_STASH, dict(stash, entryId=None))
    data = client.command("loadfile", target["url"], "replace")
    entry_id = data.get("playlist_entry_id") if isinstance(data, dict) else None
    if not isinstance(entry_id, int) or isinstance(entry_id, bool) or entry_id <= 0:
        entry_id = None
    # Everything after the loadfile is bookkeeping, and under `--idle=once` a
    # channel that fails instantly can take the process (and the connection)
    # down before these land. A dead connection here means the load failed,
    # which is the first-load window's verdict to report - not an error that
    # should sink the whole verb.
    for prop, value in ((USER_DATA_STASH, dict(stash, entryId=entry_id) if stash is not None else None),
                        (USER_DATA_OWNER, owner)):
        if value is None:
            continue
        try:
            client.try_command("set_property", prop, value)
        except HelperError:
            log("%s: the player closed while recording %s" % (label, prop))
            break
    return entry_id


def applied_by_another_client(client: MpvIpc) -> dict[str, Any] | None:
    """What some other client has already applied to a player this helper has
    just SPAWNED, or None if the player is still as it was born.

    Only ever asked of a spawned player, and that restriction is the whole of
    why the answer is safe to act on. A newborn mpv is idle with
    `playlist-count` 0 and no `user-data/omarchy-iptv` node at all - confirmed
    against real mpv 0.41, headless: the node answers `property not found`
    until something writes it, and the count answers 0 until something loads.
    Nothing on the launch argv can put a file there either (`filter_mpv_args`
    keeps bare tokens off it, and `--idle=once` idles). So a channel sitting
    there NOW was applied by a client that connected after the spawn, and
    every such client is carrying an intent this start was issued BEFORE.

    That ordering is established by the spawn, not by a sequence number,
    which is what makes the check legal while ruling CL4 stands: `play` gains
    no `--seq` and takes no lock, so no channel change during a cold start
    can be delayed or refused.

    An adopted player is never asked: there, a stash is evidence of nothing
    at all - it may be the last thing the user chose or it may be minutes
    old, and ordering it would need exactly the sequence number CL4 withholds.
    """
    ok, count = client.try_command("get_property", "playlist-count")
    loaded = bool(ok and isinstance(count, int) and not isinstance(count, bool) and count > 0)
    ok, data = client.try_command("get_property", USER_DATA_STASH)
    stash = data if ok and isinstance(data, dict) else None
    if not loaded and stash is None:
        return None
    entry = (stash or {}).get("entryId")
    return {
        "id": str((stash or {}).get("id") or ""),
        "name": str((stash or {}).get("name") or ""),
        "entryId": entry if isinstance(entry, int) and not isinstance(entry, bool) and entry > 0 else None,
        # No `seq` here on purpose (D-CL-1). The number on that stash is this
        # start's own, read back out of the lock record the zap borrowed it
        # from, so it can only ever equal ours - a field that looks like
        # evidence of ordering and is not. The spawn is what orders these two.
        #
        # Which slot wrote that stash. Unlike a seq this really does vary
        # between the two sides of a stand-down (D-CL-1): the record on the
        # player reads "play", the one this verb was about to write reads
        # "start" - and a stash with no verb at all is an older schema or
        # something that is not ours, which is itself worth seeing.
        "verb": str((stash or {}).get("verb") or ""),
        "loaded": loaded,
    }


def stand_down_note(seq: int, target: dict[str, Any], newer: dict[str, Any]) -> str:
    """The journal line a start writes when it stands down (D-CL-1).

    It used to end `(intent %d over %d)`, and those two numbers are EQUAL by
    construction on the only path that reaches this line. The start holds the
    player lock across its whole spawn and stamps the lock record with its own
    seq before taking it; ruling CL4 withholds `--seq` from `play`, so the zap
    that beats it here stamps the stash with `record_seq(read_lock_file())` -
    which, inside that window, can only be the start's own number read back.
    Five live stand-downs printed `(intent 662 over 662)`, `(654 over 654)`
    and so on, 5/5. There is no second intent number to print, and a
    diagnostic that cannot vary is an assertion that cannot fail.

    What a person reading a journal after a user complains actually needs is
    the pair that DOES vary: the channel this start gave up on and the channel
    the user is left watching, plus who put it there. Those two are the
    complaint ("I pressed one thing and got another") in the two fields the
    shell's own repair compares. The one intent number is kept, named once, as
    the handle that ties the line to the shell's `player.seq`.
    """
    mine = str(target.get("id") or "") or "an unnamed stream"
    theirs = str(newer.get("id") or "")
    entry = newer.get("entryId")
    entry = entry if isinstance(entry, int) and not isinstance(entry, bool) and entry > 0 else None
    writer = str(newer.get("verb") or "")
    if theirs and theirs == mine:
        where = "the player is on that same channel"
    elif theirs:
        where = "the player is on %s" % theirs
    elif writer:
        where = "the player is on an unnamed stream"
    else:
        # Loaded, but nothing wrote a stash: not one of ours, or one that
        # died between the loadfile and the stash. Say which it is rather
        # than printing an id and a writer that are only empty strings.
        where = "the player is on a load this helper did not label"
    if writer and entry is not None:
        where += ", written by %s as entry %d" % (writer, entry)
    elif writer:
        where += ", written by %s" % writer
    elif entry is not None:
        where += ", entry %d" % entry
    intent = "intent %d would have applied %s" % (seq, mine) if seq > 0 else "it would have applied %s" % mine
    return ("a newer channel change reached the player first (%s; %s); left it playing"
            % (intent, where))


def owner_claim(owner_pid: int) -> dict[str, Any] | None:
    """The claim that tells a successor shell the player is already adopted
    (4.14). Keyed by pid AND start time so a recycled pid cannot inherit it."""
    if not owner_pid or owner_pid <= 0:
        return None
    return {"schema": PLAYER_STASH_SCHEMA, "pid": int(owner_pid),
            "startTime": proc_start_time(int(owner_pid)), "at": int(time.time())}


def observe_first_load(client: MpvIpc, entry_id: int | None, timeout: float,
                       launch_errors: list[str] | None = None) -> dict[str, Any]:
    """F3: `player start` watches its own first load on the connection it
    already holds, so a first channel that dies before any QML subscriber
    could exist - an expired subscription, the commonest real failure - is
    never silent. Log text is redacted here, inside python, before it can
    cross into QML.
    """
    deadline = time.monotonic() + max(0.0, timeout)
    state = "unknown"
    reason = ""
    last_error = launch_reason(launch_errors or [])
    while time.monotonic() < deadline:
        events = client.drain_events(deadline)
        if events is None:                       # mpv closed the connection
            state = "failed"
            break
        for message in events:
            event = str(message.get("event") or "")
            mine = entry_id is None or message.get("playlist_entry_id") == entry_id
            if event == "log-message" and str(message.get("level") or "") in ("error", "fatal"):
                last_error = redact_urls(str(message.get("text") or "")).strip() or last_error
            elif event == "file-loaded":
                return {"state": "playing", "reason": ""}
            elif event == "end-file" and mine:
                verdict = ended_verdict(message)
                why = str(message.get("reason") or "")
                # `ended_verdict` is the POST-MORTEM reducer (4.8): it answers
                # "why did the player end", for a player that has ended. Here
                # the connection is still open and mpv is still running, so two
                # of its answers mean something different and must not be taken
                # at face value.
                if verdict["kind"] == "ignored":
                    # D-PLY-13. "redirect" is mpv resolving an .m3u8 master,
                    # which is the commonest shape in IPTV. The load has NOT
                    # ended, so returning here stopped the watch before the
                    # resolved stream could fail -- and an expired subscription
                    # failing at exactly that moment is what this watch exists
                    # for. Keep draining.
                    continue
                if verdict["kind"] == "failed" and why == "stop":
                    # D-PLY-12. After the fact, "stop" can only mean "a load we
                    # issued was replaced AND THEN the process died", so the
                    # reducer calls it a failure. On a LIVE connection it cannot
                    # mean that: it means another IPC client replaced our entry,
                    # which is a zap. Reporting failure here put a "did not
                    # play" notification on screen for a channel the user had
                    # deliberately just left, and marked it failed in the guide.
                    return {"state": "unknown", "reason": ""}
                if verdict["kind"] == "failed":
                    # The log line says what actually went wrong; mpv's own
                    # file_error is a generic "loading failed". Both are
                    # already redacted, here, inside python (section 6).
                    return {"state": "failed", "reason": last_error or verdict["reason"]}
                return {"state": "unknown", "reason": ""}
    if state == "failed" and not reason:
        reason = last_error or PLAYER_GENERIC_FAILURE
    return {"state": state, "reason": reason}


# -------------------------------------------------------------- the verbs

def player_runtime(sock_path: str) -> str:
    directory = os.path.dirname(sock_path)
    ensure_private_dir(directory)
    return directory


def check_socket_path(sock_path: str) -> None:
    """A regular file at the socket path is never unlinked and never spawned
    over (it is the user's, or a sign something else owns the path)."""
    try:
        mode = os.lstat(sock_path).st_mode
    except OSError:
        return
    if not stat.S_ISSOCK(mode):
        raise HelperError("socket_path_blocked", "the socket path is not a socket")


def ensure_player_dirs(dirs: dict[str, str], warnings: list[str]) -> None:
    """PO-11: pre-create what the player writes into, at 0700.

    mpv does create a missing --screenshot-dir / --watch-later-dir - verified
    on 0.41 - but it creates it 0755, which is exactly the exposure being
    closed. Creating it here first settles the mode. A failure is not worth
    refusing a play over: the option still goes on argv, mpv reports its own
    error into the launch window, and the user is told which directory the
    plugin could not make. `shaderCache` (D-PLY-10) joins them for the same
    reason: mpv would otherwise create it itself, at its own mode.
    """
    for key in ("screenshots", "watchLater", "shaderCache"):
        try:
            ensure_private_dir(dirs[key])
        except OSError as error:
            warnings.append("could not create %s (%s)" % (dirs[key], error.strerror or "error"))


def adopt_or_spawn(sock_path: str, mpv_args: list[str], spawn_timeout: float,
                   ipc_timeout: float, warnings: list[str],
                   dirs: dict[str, str] | None = None) -> dict[str, Any]:
    """Requirement 1, all three layers: the /proc scan is the existence check,
    a live answering player is adopted rather than duplicated, several
    matches collapse to the one that answers, and a spawn whose socket never
    binds is reaped by the helper that created it - so an uncontrollable
    window can neither exist nor multiply.
    """
    found = find_player(sock_path)
    if found:
        client = probe_client(sock_path, ipc_timeout)
        if client is not None:
            keep = _connected_pid(client, found)
            others = [record for record in found if record["pid"] != keep]
            if others:
                # Never rung 1 here: `quit` travels over the shared socket and
                # would hit the player we are keeping. Signal the rest by pid.
                warnings.append("stopped %d other player process(es) on this socket" % len(others))
                stop_ladder(sock_path, others, "term", ipc_timeout)
            return {"spawned": False, "client": client, "pid": keep}
        # Matches found, none answers: wedged. Ladder them down and respawn.
        warnings.append("stopped an unresponsive player")
        stop_ladder(sock_path, found, "", ipc_timeout)
    settle_socket(sock_path)
    where = dirs or player_dirs(sock_path)
    ensure_player_dirs(where, warnings)
    launched = spawn_detached(mpv_launch_argv(sock_path, mpv_args, where), where["cwd"])
    errors: list[str] = []
    client = wait_for_socket(sock_path, spawn_timeout, ipc_timeout, launched["stderrFd"], errors)
    if client is None:
        drain_launch_stderr(launched["stderrFd"], errors)
        os.close(launched["stderrFd"])
        stop_ladder(sock_path, [{"pid": launched["pid"], "startTime": proc_start_time(launched["pid"])}], "term", ipc_timeout)
        settle_socket(sock_path)
        detail = launch_reason(errors)
        raise HelperError("no_socket", "the player did not open its socket" + (": %s" % detail if detail else ""))
    drain_launch_stderr(launched["stderrFd"], errors)
    os.close(launched["stderrFd"])
    return {"spawned": True, "client": client, "pid": launched["pid"], "launchErrors": errors}


def _connected_pid(client: MpvIpc, found: list[dict[str, Any]]) -> int:
    """Which of the scanned processes is the one answering the socket. With a
    single match that is settled; with several, mpv's own `pid` property
    decides, and the scan is still the authority on existence."""
    if len(found) == 1:
        return int(found[0]["pid"])
    ok, data = client.try_command("get_property", "pid")
    if ok and isinstance(data, int) and any(record["pid"] == data for record in found):
        return int(data)
    return int(found[0]["pid"]) if found else 0


def player_start(args: argparse.Namespace, verb: str = "start") -> int:
    kind = "player.%s" % verb
    sock = socket_path(args.socket)
    seq = max(0, int(args.seq or 0))
    warnings: list[str] = []
    mpv_args, rejected = filter_mpv_args(list(args.mpv_arg or []))
    for token in rejected:
        warnings.append("dropped mpvArg %s" % token.split("=", 1)[0])
    # PO-10: kept, not dropped - and said out loud. The service shows the
    # same line the guide already has; this one is for the CLI and the log.
    warnings.extend(mpv_arg_warnings(mpv_args))
    lock_fd = -1
    client = None
    newer: dict[str, Any] | None = None
    try:
        target = player_target(args.id, "", args.cache_dir)
        player_runtime(sock)
        check_socket_path(sock)
        lock_fd = acquire_lock(player_lock_path(sock), args.lock_timeout)
        check_seq(read_lock_record(lock_fd), seq, verb)
        write_lock_record(lock_fd, seq, verb)
        if verb == "restart":
            stop_ladder(sock, find_player(sock), args.__dict__.get("from_rung") or "term", args.ipc_timeout)
            settle_socket(sock)
        outcome = adopt_or_spawn(sock, mpv_args, args.spawn_timeout, args.ipc_timeout, warnings)
        client = outcome["client"]
        # Subscribe BEFORE any load, so the first channel's failure text is
        # captured on the connection we already hold (F3).
        client.try_command("request_log_messages", "error")
        stash = player_stash(target["id"], target["name"], target["group"], args.scope,
                             source_key_of(cache_dir(args.cache_dir)), args.since or int(time.time()), seq,
                             verb=verb)
        # D-PLY-11. The measured mechanism (QA-RESULTS.md (dev branch) D1, ruling CL9):
        # during a cold start a channel change reaches the socket the instant
        # mpv binds it, while this verb is still inside `wait_for_socket`'s
        # handshake - and then this line put the burst's FIRST intent back
        # over it, unconditionally, because nothing here ever looked. Ten
        # user-visible divergences in twenty cold concurrent bursts.
        #
        # So look. A start that discovers it is no longer the newest intent
        # stands down: it leaves the newer channel playing and says so in its
        # reply. It does not relabel anything and it does not decide what the
        # user wanted - the shell is authoritative for that under ruling CL5,
        # and re-applies its own intent when this reply disagrees with it.
        newer = applied_by_another_client(client) if outcome["spawned"] else None
        if newer is None:
            entry_id = apply_channel(client, target, stash=stash, owner=owner_claim(args.owner_pid),
                                     label="player %s" % verb)
        else:
            entry_id = newer["entryId"]
            claim = owner_claim(args.owner_pid)
            if claim is not None:
                # The claim is about which shell owns the player, not about
                # which channel is on it, so it is still ours to write.
                client.try_command("set_property", USER_DATA_OWNER, claim)
            log("player %s: %s" % (verb, stand_down_note(seq, target, newer)))
            warnings.append("a newer channel change reached the player first")
    except HelperError as error:
        if lock_fd >= 0:
            release_lock(lock_fd)
        if client is not None:
            client.close()
        log("player %s: %s" % (verb, error.message))
        emit(error_payload(kind, error, id=args.id or None, seq=seq))
        return EXIT_ERROR
    # The lock is deliberately not held across the first-load window, so a
    # `player stop` can interleave (4.4 step 10).
    release_lock(lock_fd)
    try:
        # Nothing of ours is loading when we stood down: the load being
        # watched for would be someone else's, and waiting out the whole
        # first-load window for an event that already happened would only
        # delay the reply. "unknown" is the honest verdict and the one the
        # observer already handles.
        first_load = ({"state": "unknown", "reason": ""} if newer is not None
                      else observe_first_load(client, entry_id, args.first_load_timeout, outcome.get("launchErrors")))
    finally:
        client.close()
    emit({"ok": True, "kind": kind, "spawned": bool(outcome["spawned"]), "pid": int(outcome["pid"]),
          "id": target["id"] or None, "name": target["name"], "entryId": entry_id, "seq": seq,
          "firstLoad": first_load, "warnings": warnings,
          # Additive, and the two fields the shell's repair reads: whether
          # this verb's own channel is what the player ended up on, and what
          # it is on instead when it is not.
          "applied": newer is None,
          "playing": None if newer is None else {"id": newer["id"], "name": newer["name"]}})
    return EXIT_OK


def player_stop(args: argparse.Namespace) -> int:
    sock = socket_path(args.socket)
    seq = max(0, int(args.seq or 0))
    lock_fd = -1
    try:
        player_runtime(sock)
        lock_fd = acquire_lock(player_lock_path(sock), args.lock_timeout)
        check_seq(read_lock_record(lock_fd), seq, "stop")
        write_lock_record(lock_fd, seq, "stop")
        found = find_player(sock)
        if not found:
            settle_socket(sock)
            emit({"ok": True, "kind": "player.stop", "running": False, "rung": "", "pid": None})
            return EXIT_OK
        result = stop_ladder(sock, found, args.from_rung, args.ipc_timeout)
        # D-PLY-8. The only settle in the file that gets a deadline, and the
        # only one already inside the player lock - which is what makes an
        # unlink safe across the wait. The deadline is the ladder's own,
        # nearly all of it unspent.
        settle_socket(sock, result.get("deadline"))
        emit({"ok": True, "kind": "player.stop", "running": bool(result["running"]),
              "rung": result["rung"], "pid": int(found[0]["pid"])})
        return EXIT_OK
    except HelperError as error:
        log("player stop: %s" % error.message)
        emit(error_payload("player.stop", error, seq=seq))
        return EXIT_ERROR
    finally:
        if lock_fd >= 0:
            release_lock(lock_fd)


def player_probe(args: argparse.Namespace) -> int:
    """Lock-free and side-effect-free but for one stale-socket unlink and the
    owner claim. `path` and `media-title` are never read into the shell: one
    is a credentialed URL, the other is verified stale after playback ends."""
    sock = socket_path(args.socket)
    try:
        found = find_player(sock)
        payload: dict[str, Any] = {
            "ok": True, "kind": "player.probe", "running": bool(found), "responsive": False,
            "pid": int(found[0]["pid"]) if found else None, "idle": None, "mpvVersion": None,
            "stash": None, "owner": None, "seq": record_seq(read_lock_file(sock)), "claimed": False,
        }
        client = probe_client(sock, args.ipc_timeout) if found else None
        if client is None:
            if not found:
                # X2 / CL8: under the lock, because check-then-unlink without
                # it can delete a racing start's FRESH socket. Never with a
                # deadline - the probe is a read, and a waiting unlink at an
                # unlocked-by-nature call site would lengthen the very
                # exposure being closed.
                settle_under_lock(sock)
            emit(payload)
            return EXIT_OK
        try:
            payload["responsive"] = True
            payload["pid"] = _connected_pid(client, found)
            ok, idle = client.try_command("get_property", "idle-active")
            payload["idle"] = bool(idle) if ok and idle is not None else None
            ok, version = client.try_command("get_property", "mpv-version")
            payload["mpvVersion"] = version if ok and isinstance(version, str) else None
            ok, stash = client.try_command("get_property", USER_DATA_STASH)
            payload["stash"] = stash if ok and isinstance(stash, dict) and stash.get("id") else None
            ok, owner = client.try_command("get_property", USER_DATA_OWNER)
            payload["owner"] = owner if ok and isinstance(owner, dict) else None
            claim = owner_claim(args.owner_pid)
            if claim is not None:
                written, _ = client.try_command("set_property", USER_DATA_OWNER, claim)
                payload["claimed"] = bool(written)
                if written:
                    payload["owner"] = claim
        finally:
            client.close()
        emit(payload)
        return EXIT_OK
    except HelperError as error:
        log("player probe: %s" % error.message)
        emit(error_payload("player.probe", error, running=False))
        return EXIT_ERROR


def player_orphan_check(args: argparse.Namespace) -> int:
    """PO-2: the service object being destroyed cannot tell a shell restart
    from a plugin removal, so the claim decides, not the destruction event.
    A successor shell overwrites the claim well inside the grace."""
    sock = socket_path(args.socket)
    owner_pid = int(args.owner_pid or 0)
    _sleep(max(0.0, float(args.grace)))
    try:
        found = find_player(sock)
        if not found:
            emit({"ok": True, "kind": "player.orphan-check", "stopped": False, "reason": "no_player"})
            return EXIT_OK
        client = probe_client(sock, args.ipc_timeout)
        claim = None
        if client is not None:
            try:
                ok, data = client.try_command("get_property", USER_DATA_OWNER)
                claim = data if ok and isinstance(data, dict) else None
            finally:
                client.close()
        if not isinstance(claim, dict) or int(claim.get("pid") or 0) != owner_pid or owner_pid <= 0:
            emit({"ok": True, "kind": "player.orphan-check", "stopped": False, "reason": "reassigned"})
            return EXIT_OK
        alive = False
        try:
            os.kill(owner_pid, 0)
            alive = proc_is_ours(owner_pid) and (not claim.get("startTime") or proc_start_time(owner_pid) == str(claim.get("startTime")))
        except OSError:
            alive = False
        if not alive:
            # The shell exited and nothing claimed the player: a slow restart
            # must not kill playback.
            emit({"ok": True, "kind": "player.orphan-check", "stopped": False, "reason": "owner_dead"})
            return EXIT_OK
        result = stop_ladder(sock, found, "", args.ipc_timeout)
        # X1 / CL8: same reasoning as the probe. This one runs the ladder
        # first, so the socket it is about to unlink belonged to a player it
        # just reaped - and a start racing it is exactly the case the lock
        # exists for. No deadline here either.
        settle_under_lock(sock)
        emit({"ok": True, "kind": "player.orphan-check", "stopped": not result["running"],
              "reason": "owner_alive", "rung": result["rung"]})
        return EXIT_OK
    except HelperError as error:
        log("player orphan-check: %s" % error.message)
        emit(error_payload("player.orphan-check", error, stopped=False))
        return EXIT_ERROR


def player_pause(args: argparse.Namespace) -> int:
    """Pause, resume, or toggle the live stream.

    WHAT THIS IS AND IS NOT. mpv keeps filling its demuxer cache while paused,
    so resuming continues from the moment you pressed it -- you are then
    watching behind live, which is the point. It is NOT rewind: measured
    across 22 live channels from 21 providers, 21 paused and resumed
    correctly and exactly ONE reported itself seekable, so there is no going
    back to before you pressed pause. Never call this feature DVR.

    The bound is mpv's default demuxer-max-bytes, 150 MiB, which on a
    ~3.8 Mbps stream measured 315 s of pause before the buffer stopped
    growing. A higher bitrate caps sooner.

    Side-effect-free when the player is not there: no spawn, no lock, no
    stale-socket unlink. Pausing something that is not playing is a no-op and
    says so, rather than starting a player to pause it.
    """
    sock = socket_path(args.socket)
    payload: dict[str, Any] = {"ok": True, "kind": "player.pause", "running": False,
                               "paused": None, "changed": False}
    if not find_player(sock):
        emit(payload)
        return EXIT_OK
    client = probe_client(sock, args.ipc_timeout)
    if client is None:
        emit(payload)
        return EXIT_OK
    try:
        payload["running"] = True
        ok, current = client.try_command("get_property", "pause")
        was = bool(current) if ok and current is not None else None
        if args.state == "toggle":
            want = (not was) if was is not None else True
        else:
            want = args.state == "on"
        if was is not None and was == want:
            payload["paused"] = was
            emit(payload)
            return EXIT_OK
        set_ok, _ = client.try_command("set_property", "pause", want)
        if not set_ok:
            raise HelperError("pause_refused", "the player refused to change pause state")
        payload["paused"] = want
        payload["changed"] = True
        emit(payload)
        return EXIT_OK
    finally:
        client.close()


def cmd_player(args: argparse.Namespace) -> int:
    action = args.action
    if action == "start":
        return player_start(args, "start")
    if action == "restart":
        return player_start(args, "restart")
    if action == "stop":
        return player_stop(args)
    if action == "probe":
        return player_probe(args)
    if action == "pause":
        return player_pause(args)
    return player_orphan_check(args)


# --------------------------------------------------------------- cache
# Per-source cache directories (ARCHITECTURE-SOURCES.md section 2.3). QML
# never composes a delete: the service asks for `cache migrate | remove |
# prune` with keys only. Every key is validated against SOURCE_KEY_RE, the
# target is realpath-checked to stay under <cache-dir>/sources/, symlinked
# directories are refused, and only the five known file names plus .tmp-*
# leftovers are ever unlinked (an unknown file keeps its directory). Output
# names keys and base names only, never a path (R12).

def sources_root(directory: str) -> str:
    return os.path.join(directory, SOURCES_DIR)


def check_source_key(key: Any) -> str:
    if not isinstance(key, str) or not SOURCE_KEY_RE.match(key):
        raise HelperError("bad_key", "invalid cache key")
    return key


def source_dir(directory: str, key: Any) -> str:
    """Validated <cache-dir>/sources/<key>; raises bad_key for anything that
    is not a key, escapes the sources directory, or is a symlink."""
    key = check_source_key(key)
    root = sources_root(directory)
    target = os.path.join(root, key)
    if not os.path.realpath(target).startswith(os.path.realpath(root) + os.sep):
        raise HelperError("bad_key", "cache key escapes the sources directory")
    if os.path.islink(target):
        raise HelperError("bad_key", "cache key is a symbolic link")
    return target


def is_temp_name(name: str) -> bool:
    return name.startswith(TEMP_PREFIX)


def remove_regular(path: str) -> bool:
    """Unlink a regular file or a symlink (never following it); False when
    the name is a directory or missing."""
    try:
        mode = os.lstat(path).st_mode
    except FileNotFoundError:
        return False
    if stat.S_ISDIR(mode):
        return False
    os.unlink(path)
    return True


# Subdirectories this plugin creates inside sources/<key>/ and is therefore
# responsible for deleting. M2-04's `logos/` is the first one that has ever
# existed, and it exposed that clear_source_dir could not remove a directory
# at all: remove_regular returns False for one, so it always landed in `kept`,
# the `if not kept` rmdir never fired, and `cache prune` classified the whole
# source key as kept rather than removed. A removed source left up to
# MAX_LOGO_FILES * MAX_LOGO_BYTES on disk permanently, and no later prune
# could ever collect it -- with filenames that are fnv1a32 of the logo URLs,
# so the leftovers identify the channels that source carried (D-LOGO-4).
CACHE_SUBDIRS = ("logos",)


def remove_cache_subdir(path: str) -> bool:
    """Delete one of OUR cache subdirectories. False when it is not there.

    Deliberately not shutil.rmtree and deliberately not recursive: this
    removes regular files one level down and then the directory itself, so a
    nested directory, a symlink to somewhere else, or anything unexpected is
    LEFT and reported rather than followed. A cache cleaner that recurses is
    one bug away from deleting something it does not own.
    """
    try:
        names = sorted(os.listdir(path))
    except FileNotFoundError:
        return False
    except NotADirectoryError:
        return False
    for name in names:
        remove_regular(os.path.join(path, name))
    try:
        os.rmdir(path)
    except OSError:
        return False
    return True


def clear_source_dir(path: str) -> tuple[list[str], list[str]]:
    """Delete the known cache files inside `path` and rmdir it when nothing
    else is left. -> (removed names, kept names)."""
    removed: list[str] = []
    kept: list[str] = []
    try:
        names = sorted(os.listdir(path))
    except FileNotFoundError:
        return removed, kept
    for name in names:
        full = os.path.join(path, name)
        if name in CACHE_SUBDIRS and remove_cache_subdir(full):
            removed.append(name)
        elif (name in CACHE_FILES or is_temp_name(name)) and remove_regular(full):
            removed.append(name)
        else:
            kept.append(name)
    if not kept:
        os.rmdir(path)
    return removed, kept


def cache_migrate(directory: str, key: str | None) -> dict[str, Any]:
    """Move the 0.1 single-cache files into sources/<key>/ (os.replace, same
    filesystem, atomic); without a key they are deleted. Idempotent."""
    ensure_private_dir(directory)
    ensure_private_dir(sources_root(directory))
    target = source_dir(directory, key) if key else None
    if target is not None:
        ensure_private_dir(target)
    moved: list[str] = []
    removed: list[str] = []
    for name in CACHE_FILES:
        legacy = os.path.join(directory, name)
        try:
            mode = os.lstat(legacy).st_mode
        except FileNotFoundError:
            continue
        if stat.S_ISDIR(mode):
            continue
        if target is None or os.path.lexists(os.path.join(target, name)):
            os.unlink(legacy)
            removed.append(name)
        else:
            os.replace(legacy, os.path.join(target, name))
            moved.append(name)
    for name in sorted(os.listdir(directory)):
        if is_temp_name(name) and remove_regular(os.path.join(directory, name)):
            removed.append(name)
    return {"key": key or "", "moved": moved, "removed": removed}


def cache_remove(directory: str, key: str) -> dict[str, Any]:
    removed, kept = clear_source_dir(source_dir(directory, key))
    return {"key": key, "removed": removed, "kept": kept}


def cache_epg_clear(directory: str, key: str) -> dict[str, Any]:
    """Delete one source's EPG files, keeping the source itself (M2-09 GS11).

    Removing a source deletes its whole cache directory; clearing that
    source's guide URL has to do the same for the part of the cache the URL
    produced, or the warnings it raised come back after the next restart for
    a guide source the user has removed. The playlist half of the cache is
    untouched -- the source is still there, only its guide data is gone -- and
    so is the directory, which the source still owns. Idempotent: clearing a
    URL that was never set removes nothing and still succeeds."""
    path = source_dir(directory, key)
    removed: list[str] = []
    for name in EPG_CACHE_FILES:
        if remove_regular(os.path.join(path, name)):
            removed.append(name)
    return {"key": key, "removed": sorted(removed)}


def cache_prune(directory: str, keep: list[str], active: str | None, epg_max_age: float) -> dict[str, Any]:
    """Delete every sources/<key> not in `keep`; age the EPG files of kept,
    non-active keys older than `epg_max_age` seconds. The `active` key is
    implicitly kept (D-SRC-07): the active source's directory is never
    removed, listed under `keep` or not. Names that are not keys (and
    symlinks) are skipped, never touched."""
    keep_set = {check_source_key(item) for item in keep}
    if active:
        keep_set.add(check_source_key(active))
    root = sources_root(directory)
    ensure_private_dir(root)
    removed: list[str] = []
    aged: list[str] = []
    skipped: list[str] = []
    kept_dirs: list[str] = []
    now = time.time()
    for entry in sorted(os.scandir(root), key=lambda item: item.name):
        name = entry.name
        if not SOURCE_KEY_RE.match(name) or entry.is_symlink() or not entry.is_dir(follow_symlinks=False):
            skipped.append(name)
            continue
        if name not in keep_set:
            _, kept = clear_source_dir(entry.path)
            (kept_dirs if kept else removed).append(name)
            continue
        if name == active:
            continue
        touched = False
        for file_name in EPG_CACHE_FILES:
            path = os.path.join(entry.path, file_name)
            try:
                st = os.lstat(path)
            except FileNotFoundError:
                continue
            if stat.S_ISREG(st.st_mode) and now - st.st_mtime >= epg_max_age:
                os.unlink(path)
                touched = True
        if touched:
            aged.append(name)
    return {"removed": removed, "agedEpg": aged, "skipped": skipped, "kept": kept_dirs}


def cmd_cache(args: argparse.Namespace) -> int:
    directory = cache_dir(args.cache_dir)
    action = args.action
    try:
        if action == "migrate":
            payload = cache_migrate(directory, args.key or None)
        elif action == "remove":
            payload = cache_remove(directory, args.key)
        elif action == "epg-clear":
            payload = cache_epg_clear(directory, args.key)
        else:
            payload = cache_prune(directory, list(args.keep or []), args.active or None, args.epg_max_age)
        result: dict[str, Any] = {"ok": True, "kind": "cache", "action": action}
        result.update(payload)
        emit(result)
        return EXIT_OK
    except HelperError as error:
        log("cache %s: %s" % (action, error.message))
        emit(error_payload("cache", error, action=action))
        return EXIT_ERROR


# --------------------------------------------------------------- state
# state.json version 2 (ARCHITECTURE-SOURCES.md section 2): the 0.1 keys
# unchanged plus `cacheLayout` and the `sources` history. A version-1 file
# reads as version 2 with an empty history; the first write upgrades it.
# v0.3.0 adds one optional nullable key, `session`, with NO version bump
# (ARCHITECTURE-PLAYER.md section 8), handled exactly the way the version-1
# keys are: normalize_state whitelists what it knows, so a file that predates
# the key reads it as None and an older build simply drops it. The key is the
# service's, but every `state` action rewrites the whole document, so the CLI
# has to carry it through or a `favorite add` would silently erase the record
# a running player depends on (ruling PO-3).
# Every `state` action prints the state through public_state(), which
# replaces `url` / `epgUrl` by their hosts: stdout must never carry a URL.

def default_state() -> dict[str, Any]:
    return {"version": STATE_VERSION, "cacheLayout": 0, "favorites": [], "recents": [], "lastPlayed": None,
            "session": None, "sources": [], "savedSearches": []}


# Must match Model.js MAX_SAVED_SEARCHES / MAX_SAVED_TERMS / MAX_SAVED_QUERY and
# savedSearchTerms / savedSearchRecord. One shared fixture runs both.
MAX_SAVED_SEARCHES = 20
MAX_SAVED_TERMS = 8
MAX_SAVED_QUERY = 64


def saved_search_terms(query: Any) -> list[str]:
    text = normalize_text(str(query or "")[:MAX_SAVED_QUERY])
    if not text:
        return []
    return text.split(" ")[:MAX_SAVED_TERMS]


def normalize_saved_search(entry: Any) -> dict[str, Any] | None:
    if not isinstance(entry, dict):
        return None
    query = str(entry.get("query") or "")[:MAX_SAVED_QUERY]
    if not saved_search_terms(query):
        return None
    # float() then int(), NOT int() alone, and the shared fixture is what
    # forced it: Model.js does Math.trunc(Number(x)), which reads "12.9" as 12,
    # while int("12.9") raises and this reader would have stored 0. The vector
    # is in the fixture precisely so the two cannot drift apart again.
    #
    # normalize_played above still has the int()-alone form and therefore still
    # disagrees with playedRecord on that input. Filed as D-STATE-1 rather than
    # changed here: it is a pre-existing divergence on a different key and it
    # is not this feature's to move.
    return {"query": query, "at": coerce_int(entry.get("at"))}


def normalize_played(entry: Any) -> dict[str, Any] | None:
    if not isinstance(entry, dict) or not entry.get("id"):
        return None
    return {"id": str(entry["id"]), "name": str(entry.get("name") or ""),
            "at": coerce_int(entry.get("at"))}


def coerce_int(value: Any) -> int:
    """D-STATE-1. Mirror Model.js's `Math.trunc(Number(x)) || 0` exactly.

    This used to be `int(x)`, which accepts only a plain integer literal and
    RAISES on everything else -- so `"12.9"` stored 0 where the guide read 12,
    and `"1e3"` stored 0 where the guide read 1000. Same bytes, two answers, on
    `recents[].at`, `lastPlayed.at` and `session.at`.

    float() first is what buys the whole JavaScript numeric grammar: decimals,
    exponents and surrounding whitespace all parse, a trailing tail does not
    (`"7abc"` is 0 in both), and int() then truncates TOWARD ZERO rather than
    down, which is what Math.trunc does and why `-3.7` is -3 and not -4.

    Found by the saved-search fixture, which carried `at: "12.9"` for its own
    key and went red on a key it was not written for.
    """
    try:
        return int(float(value or 0))
    except (TypeError, ValueError):
        return 0


def non_negative_int(value: Any) -> int:
    """The same coercion, then clamped at zero.

    D-STATE-1 was filed against normalize_played alone. It was never only
    there: this function had the identical `int(x)` and therefore the identical
    disagreement, on five more keys -- `addedAt`, `lastUsed`, `fetchedAt`,
    `channelCount` and `groupCount` on every source record. Model.js reads
    "12.9" as 12 and "1e3" as 1000 for all of them; this read 0.

    One coercion with two callers, so a third caller cannot reintroduce the
    split by writing `int()` again out of habit.
    """
    number = coerce_int(value)
    return number if number > 0 else 0


def normalize_source(raw: Any) -> dict[str, Any] | None:
    """One history record per the section 2.1 field rules; None drops it.
    A `url` with a control character (NUL, CR, ...) drops the record with a
    log line naming the key only (D-SRC-09, mirrors Model.parseState); the
    validator would otherwise strip the character and keep a record whose
    key no longer matches its URL. The same character in `epgUrl` clears
    that field only."""
    if not isinstance(raw, dict):
        return None
    key = raw.get("key")
    if not isinstance(key, str) or not SOURCE_KEY_RE.match(key):
        return None
    url = raw.get("url")
    if not isinstance(url, str):
        return None
    if _CONTROL_CHARS.search(url):
        log("state: dropped source %s (control characters in url)" % key)
        return None
    playlist = validate_source_url(url, origin="cli")
    if not playlist["ok"]:
        log("state: dropped source %s (invalid url: %s)" % (key, playlist["code"]))
        return None
    raw_epg = raw.get("epgUrl")
    if isinstance(raw_epg, str) and _CONTROL_CHARS.search(raw_epg):
        log("state: cleared the epgUrl of source %s (control characters)" % key)
        raw_epg = ""
    epg = validate_source_url(raw_epg, origin="cli") if isinstance(raw_epg, str) else None
    # SR22: the helper truncates an over-cap label on read, never errors.
    label = cap_code_points(sanitize_input(raw.get("label"), MAX_SOURCE_URL), MAX_LABEL) or derive_label(playlist["url"], playlist["kind"])
    origin = raw.get("origin")
    return {
        "key": key,
        "url": playlist["url"],
        "epgUrl": epg["url"] if epg is not None and epg["ok"] else "",
        "kind": playlist["kind"],
        "label": label,
        "labelCustom": raw.get("labelCustom") is True,
        "origin": origin if origin in SOURCE_ORIGINS else "guide",
        "addedAt": non_negative_int(raw.get("addedAt")),
        "lastUsed": non_negative_int(raw.get("lastUsed")),
        "fetchedAt": non_negative_int(raw.get("fetchedAt")),
        "channelCount": non_negative_int(raw.get("channelCount")),
        "groupCount": non_negative_int(raw.get("groupCount")),
    }


def normalize_state(raw: Any) -> dict[str, Any]:
    """Tolerant reader mirroring Model.parseState: unknown shapes fall back
    to an empty state, entries are de-duplicated and coerced. A version-1
    file (0.1.0) yields `sources: []`, `cacheLayout: 0`; a file from before
    the detached player yields `session: None`; records that fail the field
    rules are dropped, a repeated url or key keeps the first."""
    state = default_state()
    if not isinstance(raw, dict):
        return state
    favorites = raw.get("favorites")
    if isinstance(favorites, list):
        for item in favorites:
            key = str(item or "")
            if key and key not in state["favorites"]:
                state["favorites"].append(key)
    recents = raw.get("recents")
    if isinstance(recents, list):
        for item in recents:
            entry = normalize_played(item)
            if entry is not None:
                state["recents"].append(entry)
    # Saved searches. This writer rebuilds from default_state() and copies only
    # keys it knows, so an un-taught copy ERASES the key -- proven live before
    # this was added: one `state favorite add` through the real CLI dropped it,
    # exit 0, "ok": true, no warning. Mirrors Model.parseState, including the
    # de-duplication on the FOLDED terms rather than the raw string.
    saved = raw.get("savedSearches")
    if isinstance(saved, list):
        seen_terms = set()
        for item in saved:
            if len(state["savedSearches"]) >= MAX_SAVED_SEARCHES:
                break
            record = normalize_saved_search(item)
            if record is None:
                continue
            sig = " ".join(saved_search_terms(record["query"]))
            if sig in seen_terms:
                continue
            seen_terms.add(sig)
            state["savedSearches"].append(record)
    state["lastPlayed"] = normalize_played(raw.get("lastPlayed"))
    # What the player was last asked to play (4.6, section 8). Same record as
    # lastPlayed, different lifetime: the service clears it when the player
    # stops or ends cleanly, so one left behind means the player died with no
    # shell attached and the channel is marked failed in the guide on reattach
    # instead of raising a toast minutes late. Never URL-bearing: a channel id
    # and a display name, which is never a URL.
    state["session"] = normalize_played(raw.get("session"))
    state["cacheLayout"] = CACHE_LAYOUT if raw.get("cacheLayout") == CACHE_LAYOUT else 0
    sources = raw.get("sources")
    if isinstance(sources, list):
        for item in sources:
            record = normalize_source(item)
            if record is None or len(state["sources"]) >= MAX_SOURCES:
                continue
            if find_source(state["sources"], record["key"]) or find_source_by_url(state["sources"], record["url"]):
                continue
            state["sources"].append(record)
    return state


def public_source(record: dict[str, Any]) -> dict[str, Any]:
    """The record with `url` / `epgUrl` replaced by `host` / `epgHost`."""
    out: dict[str, Any] = {}
    for name, value in record.items():
        if name == "url":
            out["host"] = source_host(value) if record.get("kind") == "http" else "local file"
        elif name == "epgUrl":
            out["epgHost"] = "" if not value else (source_host(value) if not value.startswith("/") else "local file")
        else:
            out[name] = value
    return out


def public_state(state: dict[str, Any]) -> dict[str, Any]:
    out = dict(state)
    out["sources"] = [public_source(record) for record in state.get("sources", [])]
    return out


def check_custom_label(cleaned: str, others: list[str]) -> str:
    """A label the user typed (Model.validateLabel): refused over MAX_LABEL
    code points (label_too_long, never cut, SR22) and when another source
    has it case-insensitively (label_taken); never rewritten (UX 5.6)."""
    custom = sanitize_input(cleaned, MAX_SOURCE_URL)
    if len(custom) > MAX_LABEL:
        raise HelperError("label_too_long", "label longer than %d characters" % MAX_LABEL, field="label")
    if custom.lower() in {label_key(item) for item in others}:
        raise HelperError("label_taken", "a source named '%s' already exists" % custom, field="label")
    return custom


def add_source_record(state: dict[str, Any], url: Any, epg_url: Any, label: Any, origin: str, now: int) -> str:
    """Append a history record (the CLI counterpart of Model.addSource);
    raises the UX-SOURCES.md 5.4 codes plus duplicate / too_many /
    label_taken / label_too_long. Returns the new key."""
    playlist = validate_source_url(url)
    if not playlist["ok"]:
        raise HelperError(playlist["code"], "playlist %s" % playlist["message"])
    epg = ""
    if epg_url is not None and sanitize_input(epg_url, MAX_SOURCE_URL + 1) != "":
        checked = validate_source_url(epg_url)
        if not checked["ok"]:
            raise HelperError(checked["code"], "EPG %s" % checked["message"], field="epgUrl")
        epg = checked["url"]
    sources = state["sources"]
    existing = find_source_by_url(sources, playlist["url"])
    if existing is not None:
        raise HelperError("duplicate", "already in the source history as '%s'" % existing["label"], key=existing["key"])
    if len(sources) >= MAX_SOURCES:
        raise HelperError("too_many", "the source history holds at most %d sources" % MAX_SOURCES)
    labels = [record["label"] for record in sources]
    cleaned = _CONTROL_CHARS.sub("", "" if label is None else str(label)).strip(" \u00a0")
    if cleaned != "":
        final_label, label_custom = check_custom_label(cleaned, labels), True
    else:
        final_label, label_custom = unique_label(derive_label(playlist["url"], playlist["kind"]), labels), False
    key = allocate_source_key(sources, playlist["url"])
    sources.append({
        "key": key,
        "url": playlist["url"],
        "epgUrl": epg,
        "kind": playlist["kind"],
        "label": final_label,
        "labelCustom": label_custom,
        "origin": origin if origin in SOURCE_ORIGINS else "cli",
        "addedAt": now,
        "lastUsed": now,
        "fetchedAt": 0,
        "channelCount": 0,
        "groupCount": 0,
    })
    return key


def update_source_record(state: dict[str, Any], key: str, url: Any, epg_url: Any, label: Any, now: int) -> tuple[str, str]:
    """Edit a record in place. A changed playlist URL re-keys it (fetchedAt
    and the counts reset; the caller moves or removes the cache directory).
    -> (key, replaced key or "")."""
    sources = state["sources"]
    record = find_source(sources, check_source_key(key))
    if record is None:
        raise HelperError("unknown_source", "no source with that key")
    replaced = ""
    if url is not None:
        playlist = validate_source_url(url)
        if not playlist["ok"]:
            raise HelperError(playlist["code"], "playlist %s" % playlist["message"])
        if playlist["url"] != record["url"]:
            other = find_source_by_url(sources, playlist["url"])
            if other is not None:
                raise HelperError("duplicate", "already in the source history as '%s'" % other["label"], key=other["key"])
            replaced = record["key"]
            record["url"] = playlist["url"]
            record["kind"] = playlist["kind"]
            record["key"] = allocate_source_key([item for item in sources if item is not record], playlist["url"])
            record["fetchedAt"] = 0
            record["channelCount"] = 0
            record["groupCount"] = 0
            if not record["labelCustom"]:
                record["label"] = unique_label(derive_label(playlist["url"], playlist["kind"]),
                                               [item["label"] for item in sources if item is not record])
    if epg_url is not None:
        if sanitize_input(epg_url, MAX_SOURCE_URL + 1) == "":
            record["epgUrl"] = ""
        else:
            checked = validate_source_url(epg_url)
            if not checked["ok"]:
                raise HelperError(checked["code"], "EPG %s" % checked["message"], field="epgUrl")
            record["epgUrl"] = checked["url"]
    if label is not None:
        cleaned = _CONTROL_CHARS.sub("", str(label)).strip(" \u00a0")
        others = [item["label"] for item in sources if item is not record]
        if cleaned == "":
            record["label"] = unique_label(derive_label(record["url"], record["kind"]), others)
            record["labelCustom"] = False
        else:
            record["label"] = check_custom_label(cleaned, others)
            record["labelCustom"] = True
    return record["key"], replaced


def remove_source_record(state: dict[str, Any], key: str) -> dict[str, Any]:
    record = find_source(state["sources"], check_source_key(key))
    if record is None:
        raise HelperError("unknown_source", "no source with that key")
    state["sources"] = [item for item in state["sources"] if item is not record]
    return record


def init_state_file(path: str, state: dict[str, Any]) -> bool:
    """Create `path` with mode 0600 when missing (S-02). Quickshell's FileView,
    which the service uses to write state.json, creates a missing file 0644
    and keeps the mode of an existing one, so the service runs `state init`
    once at startup before its first write. O_EXCL makes the check-and-create
    atomic: a file that appears in between is left alone. An existing file
    is not rewritten; only its mode is tightened. Returns True when created."""
    ensure_private_dir(os.path.dirname(path))
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        try:
            os.chmod(path, 0o600)
        except OSError:
            pass
        return False
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(json.dumps(state, ensure_ascii=False, separators=(",", ":")) + "\n")
    os.chmod(path, 0o600)
    return True


def cmd_state(args: argparse.Namespace) -> int:
    directory = state_dir(args.state_dir)
    path = os.path.join(directory, STATE_FILE)
    state = normalize_state(read_json(path))
    action = args.action
    extra: dict[str, Any] = {}
    try:
        if action == "init":
            created = init_state_file(path, state)
            emit({"ok": True, "kind": "state", "action": action, "created": created, "state": public_state(state)})
            return EXIT_OK
        if action == "favorite":
            key = str(args.id or "").strip()
            if not key:
                raise HelperError("usage", "favorite needs a channel id")
            if args.op == "add":
                if key not in state["favorites"]:
                    state["favorites"].append(key)
            else:
                state["favorites"] = [item for item in state["favorites"] if item != key]
            write_json_atomic(path, state)
        elif action == "clear-recents":
            state["recents"] = []
            write_json_atomic(path, state)
        elif action == "source":
            extra["op"] = args.op
            now = int(args.now) if getattr(args, "now", 0) else int(time.time())
            if args.op == "add":
                extra["key"] = add_source_record(state, args.url, args.epg_url, args.label, args.origin, now)
                write_json_atomic(path, state)
            elif args.op == "update":
                extra["key"], extra["replacedKey"] = update_source_record(state, args.key, args.url, args.epg_url, args.label, now)
                write_json_atomic(path, state)
            elif args.op == "remove":
                extra["removed"] = remove_source_record(state, args.key)["key"]
                write_json_atomic(path, state)
        payload: dict[str, Any] = {"ok": True, "kind": "state", "action": action}
        payload.update(extra)
        payload["state"] = public_state(state)
        emit(payload)
        return EXIT_OK
    except HelperError as error:
        log("state: %s" % error.message)
        emit(error_payload("state", error, action=action, **extra))
        return EXIT_ERROR


# -------------------------------------------------------------- parser

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="omarchy-iptv", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version=VERSION)
    sub = parser.add_subparsers(dest="command", required=True)

    playlist = sub.add_parser("playlist", help="fetch and parse the M3U playlist into channels.json")
    playlist.add_argument("--url", required=True, help="http(s) URL or absolute path (file:// accepted)")
    playlist.add_argument("--cache-dir", default=None, help="default: $XDG_CACHE_HOME/omarchy-iptv")
    playlist.add_argument("--state-dir", default=None, help="move saved channel references in this state directory onto the current id scheme; omitted, no state file is read or written at all")
    playlist.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT, help="network timeout in seconds")
    playlist.set_defaults(func=cmd_playlist)

    epg = sub.add_parser("epg", help="fetch XMLTV (plain or gzip) and write epg-now.json")
    epg.add_argument("--url", required=False, default="", help="http(s) URL or absolute path; optional with --now-only")
    epg.add_argument("--cache-dir", default=None, help="default: $XDG_CACHE_HOME/omarchy-iptv")
    epg.add_argument("--timeout", type=float, default=DEFAULT_TIMEOUT, help="network timeout in seconds")
    epg.add_argument("--ttl", type=float, default=EPG_DEFAULT_TTL, help="seconds before the cached programme window is re-downloaded (default %d)" % EPG_DEFAULT_TTL)
    epg.add_argument("--force", action="store_true", help="re-download even when the cached window is fresh")
    epg.add_argument("--now-only", action="store_true", help="recompute now/next from the cached programme window without fetching")
    epg.add_argument("--now", type=int, default=0, help="clock override in epoch seconds (tests and QA); default: the current time")
    epg.set_defaults(func=cmd_epg)

    play = sub.add_parser("play", help="switch the running mpv to a channel over IPC")
    target = play.add_mutually_exclusive_group(required=True)
    target.add_argument("--id", default="", help="channel id from channels.json")
    target.add_argument("--url", default="", help="play a raw stream URL (IPC play verb); name = host, no headers")
    play.add_argument("--cache-dir", default=None, help="default: $XDG_CACHE_HOME/omarchy-iptv")
    play.add_argument("--socket", default=None, help="default: $XDG_RUNTIME_DIR/omarchy-iptv/mpv.sock")
    play.add_argument("--ipc-timeout", type=float, default=DEFAULT_IPC_TIMEOUT, help="seconds to wait for mpv (default %.0f)" % DEFAULT_IPC_TIMEOUT)
    play.add_argument("--scope", default="", help="zap-ring scope to stash inside mpv (the list the channel was launched from)")
    play.add_argument("--since", type=int, default=0, help="epoch seconds the channel started playing; with --scope it refreshes the stash")
    play.set_defaults(func=cmd_play)

    stop = sub.add_parser("stop", help="ask the running mpv to quit over IPC")
    stop.add_argument("--socket", default=None, help="default: $XDG_RUNTIME_DIR/omarchy-iptv/mpv.sock")
    stop.add_argument("--ipc-timeout", type=float, default=DEFAULT_IPC_TIMEOUT, help="seconds to wait for mpv (default %.0f)" % DEFAULT_IPC_TIMEOUT)
    stop.set_defaults(func=cmd_stop)

    status = sub.add_parser("status", help="query the running mpv over IPC")
    status.add_argument("--socket", default=None, help="default: $XDG_RUNTIME_DIR/omarchy-iptv/mpv.sock")
    status.add_argument("--ipc-timeout", type=float, default=DEFAULT_IPC_TIMEOUT, help="seconds to wait for mpv (default %.0f)" % DEFAULT_IPC_TIMEOUT)
    status.set_defaults(func=cmd_status)

    # The detached player (ARCHITECTURE-PLAYER.md (dev branch) 4.3). User mpv tokens
    # travel as repeated --mpv-arg so argparse can never swallow an
    # option-looking token and no token is ever joined or split.
    player = sub.add_parser("player", help="start, stop, restart, probe or orphan-check the detached player")
    player_actions = player.add_subparsers(dest="action", required=True)
    player_socket = argparse.ArgumentParser(add_help=False)
    player_socket.add_argument("--socket", default=None, help="default: $XDG_RUNTIME_DIR/omarchy-iptv/mpv.sock")
    player_socket.add_argument("--ipc-timeout", type=float, default=DEFAULT_IPC_TIMEOUT, help="seconds to wait for mpv (default %.0f)" % DEFAULT_IPC_TIMEOUT)
    player_session = argparse.ArgumentParser(add_help=False)
    player_session.add_argument("--cache-dir", default=None, help="default: $XDG_CACHE_HOME/omarchy-iptv")
    player_session.add_argument("--id", required=True, help="channel id from channels.json; the URL is read from the 0600 cache, never passed in")
    player_session.add_argument("--seq", type=int, default=0, help="the service's intent sequence number; an older intent is superseded")
    player_session.add_argument("--scope", default="", help="zap-ring scope stashed inside mpv (UI intent no mpv property could report)")
    player_session.add_argument("--since", type=int, default=0, help="epoch seconds the channel started playing")
    player_session.add_argument("--owner-pid", type=int, default=0, help="claim the player for this shell pid (see orphan-check)")
    player_session.add_argument("--mpv-arg", action="append", default=[], help="one user mpv token; repeat for more (never joined)")
    player_session.add_argument("--lock-timeout", type=float, default=DEFAULT_LOCK_TIMEOUT, help="seconds to wait for the player lock (default %.1f)" % DEFAULT_LOCK_TIMEOUT)
    player_session.add_argument("--spawn-timeout", type=float, default=DEFAULT_SPAWN_TIMEOUT, help="seconds to wait for mpv to bind its socket (default %.1f)" % DEFAULT_SPAWN_TIMEOUT)
    player_session.add_argument("--first-load-timeout", type=float, default=DEFAULT_FIRST_LOAD_TIMEOUT, help="seconds to watch the first load (default %.1f)" % DEFAULT_FIRST_LOAD_TIMEOUT)
    start = player_actions.add_parser("start", parents=[player_socket, player_session], help="adopt or spawn the player and play a channel (idempotent)")
    start.add_argument("--from", dest="from_rung", default="", choices=["", "quit", "term", "kill"], help=argparse.SUPPRESS)
    restart = player_actions.add_parser("restart", parents=[player_socket, player_session], help="stop ladder and spawn under one lock (the health verdict)")
    restart.add_argument("--from", dest="from_rung", default="term", choices=["", "quit", "term", "kill"], help="first rung of the ladder (default term: IPC is not answering)")
    stop_player = player_actions.add_parser("stop", parents=[player_socket], help="run the whole quit / SIGTERM / SIGKILL ladder in this process")
    stop_player.add_argument("--seq", type=int, default=0, help="the service's intent sequence number")
    stop_player.add_argument("--from", dest="from_rung", default="", choices=["", "quit", "term", "kill"], help="first rung (default quit over IPC)")
    stop_player.add_argument("--lock-timeout", type=float, default=DEFAULT_LOCK_TIMEOUT, help="seconds to wait for the player lock (default %.1f)" % DEFAULT_LOCK_TIMEOUT)
    probe = player_actions.add_parser("probe", parents=[player_socket], help="report the player without touching it (the reattach read)")
    probe.add_argument("--owner-pid", type=int, default=0, help="claim the player for this shell pid")
    pause = player_actions.add_parser("pause", parents=[player_socket],
                                      help="pause, resume or toggle the live stream (not rewind: the streams are not seekable)")
    pause.add_argument("--state", choices=("on", "off", "toggle"), default="toggle")
    pause.set_defaults(func=cmd_player)

    orphan = player_actions.add_parser("orphan-check", parents=[player_socket], help="stop the player only if its claiming shell is still alive")
    orphan.add_argument("--owner-pid", type=int, required=True, help="the shell pid whose service was destroyed")
    orphan.add_argument("--grace", type=float, default=DEFAULT_ORPHAN_GRACE, help="seconds to let a successor shell claim the player (default %.1f)" % DEFAULT_ORPHAN_GRACE)
    player.set_defaults(func=cmd_player)

    logos = sub.add_parser("logos", help="report which hosts enabling logos would contact (makes no request)")
    logos.add_argument("--cache-dir", default=None)
    logos.add_argument("--survey", action="store_true", default=True,
                       help="default: read the cache and contact nothing")
    logos.add_argument("--fetch", action="store_true",
                       help="download the logos (contacts the hosts --survey lists)")
    logos.add_argument("--timeout", type=float, default=10.0)
    logos.set_defaults(func=cmd_logos)

    failed = sub.add_parser("failed", help="the dead-channel marks of one source's cache")
    failed.add_argument("action", choices=("mark", "clear", "list"))
    failed.add_argument("--id", default=None, help="channel id; omitted with `clear`, clears all")
    failed.add_argument("--cache-dir", default=None)
    failed.add_argument("--now", type=int, default=None, help="epoch override, for tests")
    failed.set_defaults(func=cmd_failed)

    state = sub.add_parser("state", help="inspect or edit state.json")
    state.add_argument("--state-dir", default=None, help="default: $XDG_STATE_HOME/omarchy-iptv")
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--state-dir", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    actions = state.add_subparsers(dest="action", required=True)
    actions.add_parser("show", parents=[common], help="print the current state")
    actions.add_parser("init", parents=[common], help="create state.json with mode 0600 when missing (the service runs this before its first write)")
    favorite = actions.add_parser("favorite", parents=[common], help="add or remove a favorite")
    favorite.add_argument("op", choices=["add", "remove"])
    favorite.add_argument("id", help="channel id from channels.json")
    actions.add_parser("clear-recents", parents=[common], help="empty the Recent list")
    source = actions.add_parser("source", parents=[common], help="list or edit the source history (state.json v2); output shows hosts, never URLs")
    ops = source.add_subparsers(dest="op", required=True)
    ops.add_parser("list", parents=[common], help="print the history")
    add = ops.add_parser("add", parents=[common], help="append a source (validated and normalized like the guide does)")
    add.add_argument("--url", required=True, help="playlist http(s) URL, file:// URL or absolute path")
    add.add_argument("--epg-url", default=None, help="optional XMLTV URL or path")
    add.add_argument("--label", default=None, help="custom label (default: derived from the host or file name)")
    add.add_argument("--origin", default="cli", choices=list(SOURCE_ORIGINS), help="record origin (default cli)")
    add.add_argument("--now", type=int, default=0, help="clock override in epoch seconds (tests)")
    update = ops.add_parser("update", parents=[common], help="change the label, playlist URL or EPG URL of a source")
    update.add_argument("key", help="source key (8 hex digits)")
    update.add_argument("--url", default=None, help="new playlist URL (re-keys the record; move or remove its cache)")
    update.add_argument("--epg-url", default=None, help="new EPG URL; an empty string clears it")
    update.add_argument("--label", default=None, help="new label; an empty string restores the derived one")
    update.add_argument("--now", type=int, default=0, help="clock override in epoch seconds (tests)")
    remove = ops.add_parser("remove", parents=[common], help="drop a source from the history (its cache dir: `cache remove`)")
    remove.add_argument("key", help="source key")
    state.set_defaults(func=cmd_state)

    cache = sub.add_parser("cache", help="per-source cache directories under <cache-dir>/sources/<key>/")
    cache.add_argument("--cache-dir", default=None, help="default: $XDG_CACHE_HOME/omarchy-iptv")
    cache_common = argparse.ArgumentParser(add_help=False)
    cache_common.add_argument("--cache-dir", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    cache_actions = cache.add_subparsers(dest="action", required=True)
    migrate = cache_actions.add_parser("migrate", parents=[cache_common], help="move the 0.1 single-cache files into sources/<key>/ (deleted without --key); idempotent")
    migrate.add_argument("--key", default="", help="key of the active source that owns the legacy files")
    remove_dir = cache_actions.add_parser("remove", parents=[cache_common], help="delete the known cache files of one source and its directory")
    remove_dir.add_argument("--key", required=True, help="source key")
    epg_clear = cache_actions.add_parser("epg-clear", parents=[cache_common], help="delete one source's EPG files, keeping the source's playlist cache and directory")
    epg_clear.add_argument("--key", required=True, help="source key")
    prune = cache_actions.add_parser("prune", parents=[cache_common], help="delete the directories of keys not listed; age the EPG files of inactive ones")
    prune.add_argument("--keep", nargs="*", default=[], help="keys to keep (every key in the history)")
    prune.add_argument("--active", default="", help="the active key: its EPG files are never aged")
    prune.add_argument("--epg-max-age", type=float, default=DEFAULT_EPG_MAX_AGE, help="seconds after which inactive EPG files are deleted (default %d)" % DEFAULT_EPG_MAX_AGE)
    cache.set_defaults(func=cmd_cache)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args))
    except KeyboardInterrupt:
        return 130
    except Exception as error:
        # A bug. The traceback is the bug report, but it must not carry a URL
        # (section 9), so it is redacted and paired with a structured error.
        import traceback
        sys.stderr.write(redact_urls(traceback.format_exc()))
        message = "%s: %s" % (type(error).__name__, error)
        emit({"ok": False, "kind": args.command, "error": {"code": "internal", "message": redact_urls(message)}})
        return EXIT_ERROR


if __name__ == "__main__":
    sys.exit(main())
