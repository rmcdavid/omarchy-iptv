#!/usr/bin/env python3
"""omarchy-iptv -- data helper for the io.github.rmcdavid.iptv Omarchy shell plugin.

Standard library only (python3 is a hard dependency of Omarchy through uwsm).
Every subcommand prints exactly one JSON object on stdout; human-readable
detail goes to stderr. Never prints a playlist/EPG/stream URL (it may embed
credentials): every message passes through `redact_urls`, errors carry the
host name only.

Exit codes:
  0  ok
  1  runtime error (JSON error object on stdout, one line on stderr)
  2  usage error (argparse)
  3  reserved (not implemented; no subcommand uses it any more)

Subcommands (contract of record: ARCHITECTURE.md (dev branch) section 5):
  playlist [--url U] [--cache-dir D] [--state-dir S] [--timeout S]   (URL: --url, or $OMARCHY_IPTV_URL)
      fetch + parse M3U -> channels.json, playlist-status.json
  epg [--url U] [--cache-dir D] [--timeout S] [--ttl S] [--force] [--now-only] [--now T]
                                                          (URL: --url, or $OMARCHY_IPTV_URL)
      XMLTV -> epg-window.txt (private cache), epg-now.json, epg-status.json
  play (--id ID | --url U) [--cache-dir D] [--socket P] [--ipc-timeout S]
      switch the running mpv to a channel over its JSON IPC socket
  stop [--socket P] [--ipc-timeout S]
      ask the running mpv to quit
  status [--socket P] [--ipc-timeout S]
      query the running mpv (media title, host of the path, pause, idle, version)
  state [--state-dir D] show | init | favorite add ID | favorite remove ID | clear-recents
      inspect or edit state.json atomically (init: create it 0600 when missing)
  state [--state-dir D] source list | add --url U [--epg-url E] [--label L] | update KEY ... | remove KEY
      the source history (state.json version 2); output carries hosts, never URLs
  cache [--cache-dir D] migrate [--key K] | remove --key K | prune [--keep K ...] [--active K]
      per-source cache directories under <cache-dir>/sources/<key>/ (M2-01, D5/D6)
  config shield
      deny group and other on $HOME/.config/omarchy/shell.json, the host's
      settings file, which holds a provider URL only while an older entry
      waits for the one-time move into state.json, or after one is set with
      `omarchy bar set` until the plugin's next write removes it (D-SINK-18,
      D-SINK-19). Takes no path:
      it computes the one path it may touch. Prints modes and a verdict.
"""
from __future__ import annotations

import sys


def shield_environment() -> bool:
    """Make this process non-dumpable, as its FIRST act (D-SINK-9).

    Two sinks close at once, both measured on this machine on 2026-10-01:

      /proc/<pid>/environ is mode 0400, but the kernel's open check is a
      ptrace-read check, which ANY process running as the same uid passes
      while the target is dumpable -- so "readable only by your account"
      meant every program the user runs. Non-dumpable, the same reader gets
      EACCES; only root reads it.

      A crash of a dumpable process hands its whole environment to
      systemd-coredump, which stores COREDUMP_ENVIRON in the journal --
      durably, readable by the journal groups. The kernel does not dump a
      non-dumpable process at all.

    Called at module level, for every verb, before this file imports
    anything but `sys`: the window left is the interpreter starting and
    compiling this file, plus the one import above. The final review of
    D-SINK-9 measured it at about 125 ms idle with the shield below the
    stdlib imports and 98-113 ms (median 105) with it here, and a split stub
    that compiled the body only after shielding could reach about 25 ms --
    so this is the cheap position, not the floor, and no sentence should
    call it unshortenable. It is measured by the argv scenario on the dev
    branch rather than assumed away, and it grows under load. Harmless to
    the verbs that carry no URL, and the player verb's mpv is exec'd, which
    resets the flag.
    Best effort: where prctl is missing the old boundary applies and nothing
    is worse than before; the failure is reported without any URL. ctypes is
    stdlib (rule 3).
    """
    try:
        import ctypes
        libc = ctypes.CDLL(None, use_errno=True)
        ok = libc.prctl(4, 0, 0, 0, 0) == 0     # PR_SET_DUMPABLE, 0
    except (ImportError, OSError, AttributeError):   # no _ctypes, no libc, no prctl
        ok = False
    if not ok:
        sys.stderr.write("omarchy-iptv: could not make this process non-dumpable; "
                         "its environment stays readable to this uid\n")
    return ok


SHIELDED = shield_environment()


# D-REL-7: the rest of the helper is in the files below, under bin/helper/,
# because the marketplace's security scan refuses a file over 512 KiB and
# this one had grown to 447 KB. They are compiled into THIS module's
# namespace, in this order, exactly as if they were still one file: a name
# defined in any part is visible in every part, and a test that replaces a
# function on the module replaces it for every caller. They are compiled
# AFTER the shield above, which is the point of the order: what a same-uid
# process can read is now the interpreter starting and compiling this short
# file. The list is fixed and the files are read from this file's own
# directory, never from argv or the environment, and compile() writes no
# bytecode, so nothing is written into the plugin directory. Generated, and
# checked by the gate, by the split script on the dev branch.
HELPER_PARTS = (
    "01-core.py",
    "02-sources.py",
    "03-io-playlist.py",
    "04-epg.py",
    "05-ipc-logos.py",
    "06-failed.py",
    "07-player.py",
    "08-player-verbs.py",
    "09-cache.py",
    "10-state.py",
    "11-cli.py",
)


def _load_parts(namespace: dict) -> None:
    import os
    here = os.path.join(os.path.dirname(os.path.abspath(__file__)), "helper")
    for name in HELPER_PARTS:
        path = os.path.join(here, name)
        try:
            with open(path, "rb") as handle:
                source = handle.read()
        except OSError as error:
            sys.stderr.write("omarchy-iptv: cannot read bin/helper/%s (%s); reinstall the plugin\n"
                             % (name, error.strerror or type(error).__name__))
            raise SystemExit(1)
        exec(compile(source, path, "exec", dont_inherit=True), namespace)


_load_parts(globals())


if __name__ == "__main__":
    sys.exit(main())
